#!/bin/sh
# Remove Live-only installer launchers from an installed XWLightOS target.
# This is deliberately idempotent: Calamares invokes it after account creation,
# and the installed-only systemd unit invokes it again before the first GNOME
# session in case a user Desktop or XDG directory is populated later.
set -eu

remove_installer_entry() {
    entry="$1"
    [ -f "$entry" ] || return 0

    case "$(basename "$entry")" in
        *install*xwlightos*.desktop|*xwlightos*install*.desktop|install-system.desktop|calamares.desktop|debian-installer*.desktop)
            rm -f "$entry"
            return 0
            ;;
    esac

    if grep -qiE '^(Name|Name\[[^]]+\]|Comment)=.*(Install XWLightOS|Install System|安装 XWLightOS|安装系统)' "$entry" 2>/dev/null; then
        rm -f "$entry"
    fi
}

clean_desktop_dir() {
    desktop_dir="$1"
    [ -d "$desktop_dir" ] || return 0
    for entry in "$desktop_dir"/*.desktop; do
        remove_installer_entry "$entry"
    done
}

# Explicit package paths cover entries with generic display names.  The scans
# below additionally cover translated, vendor-renamed and user-level copies.
rm -f /usr/share/applications/xwlightos-installer.desktop \
      /usr/share/applications/debian-installer.desktop \
      /usr/share/applications/debian-installer-launcher.desktop \
      /usr/share/applications/install-system.desktop \
      /usr/share/applications/calamares.desktop \
      /usr/local/share/applications/xwlightos-installer.desktop \
      /usr/local/share/applications/debian-installer.desktop \
      /usr/local/share/applications/debian-installer-launcher.desktop \
      /usr/local/share/applications/install-system.desktop \
      /usr/local/share/applications/calamares.desktop \
      /etc/xdg/autostart/calamares-desktop-icon.desktop \
      /etc/xdg/autostart/xwlightos-desktop-trust.desktop \
      '/etc/skel/Desktop/Install XWLightOS.desktop' \
      '/etc/skel/Desktop/Install System.desktop' \
      '/etc/skel/Desktop/安装 XWLightOS.desktop' \
      '/etc/skel/Desktop/安装系统.desktop'

for app_dir in /usr/share/applications /usr/local/share/applications /etc/skel/.local/share/applications; do
    [ -d "$app_dir" ] || continue
    for entry in "$app_dir"/*.desktop; do
        remove_installer_entry "$entry"
    done
done

# `Desktop` is used by Calamares' skeleton.  Check common localized
# desktop folder names as well so a user-created Chinese desktop cannot retain a
# Live installer shortcut.
for home_dir in /home/* /root /etc/skel; do
    [ -d "$home_dir" ] || continue
    clean_desktop_dir "$home_dir/Desktop"
    clean_desktop_dir "$home_dir/桌面"

    app_dir="$home_dir/.local/share/applications"
    [ -d "$app_dir" ] || continue
    for entry in "$app_dir"/*.desktop; do
        remove_installer_entry "$entry"
    done
done

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    update-desktop-database /usr/local/share/applications >/dev/null 2>&1 || true
fi

# 用户 2026-10-23 邮件第 10 项：安装器在正常安装系统后必须删除，不在已安装
# 系统里残留。本脚本只在安装成功的系统上运行：服务单元由
# xwlightos-target-postinstall.sh 在目标 chroot 里 enable（live 镜像里默认不
# 启用），且在 gdm 启动前执行。purge 不需要联网；任何失败都不得阻塞登录。
if command -v dpkg-query >/dev/null 2>&1 && \
   dpkg-query -W -f='${Status}' calamares 2>/dev/null | grep -q 'install ok installed'; then
    DEBIAN_FRONTEND=noninteractive apt-get purge -y calamares calamares-settings-debian >/dev/null 2>&1 || true
    # 清掉 calamares 拉进来、且已无人依赖的包（如 libcalamares*）。
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y >/dev/null 2>&1 || true
fi
# 安装器提权配置只为 live 下运行 Calamares 服务，随包一起清掉。
rm -f /etc/sudoers.d/xwlightos-installer \
      /etc/polkit-1/localauthority/50-local.d/xwlightos-calamares.pkla \
      /etc/polkit-1/rules.d/49-xwlightos-calamares.rules

# 只跑一次：装完即删，之后不再执行。
if command -v systemctl >/dev/null 2>&1; then
    systemctl disable xwlightos-installed-cleanup.service >/dev/null 2>&1 || true
fi
