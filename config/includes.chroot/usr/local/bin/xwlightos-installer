#!/bin/sh
# XWLightOS installer launcher: run Calamares as root from the Live session.
set -eu

if ! command -v calamares >/dev/null 2>&1; then
    echo "Calamares is not installed in this XWLightOS Live session." >&2
    exit 1
fi

# In the disposable live session the live user escalates without a password
# (see /etc/sudoers.d/xwlightos-live), so this wrapper never asks the live
# user for a password that does not exist.
export LANG=zh_CN.UTF-8
export LANGUAGE=zh_CN:zh
export LC_ALL=zh_CN.UTF-8
# Keep the X11 fallback usable: DISPLAY is still set for XWayland children
# and for the fallback path when no Wayland socket is reachable.
export DISPLAY="${DISPLAY:-:0}"
# The XWLightOS live session stores its X cookie at a fixed, predictable path to
# avoid xauth lock contention. Prefer that Live cookie and only fall back to
# a conventional Xauthority file for compatibility.
if [ -z "${XAUTHORITY:-}" ]; then
    if [ -f "/home/user/.Xauthority-xwlightos" ]; then
        export XAUTHORITY=/home/user/.Xauthority-xwlightos
    elif [ -f "/home/user/.Xauthority" ]; then
        export XAUTHORITY=/home/user/.Xauthority
    fi
fi

# Round 15 (user 2026-11-14: the on-screen keyboard still does not pop up
# in the installer). Qt 6.8 already prefers Wayland when WAYLAND_DISPLAY is
# set (qguiapplication.cpp createPlatformIntegration: wayland is prepended
# to the preferred order), so the old "DISPLAY forces xcb" theory was wrong;
# but nothing here ever MADE the platform deterministic, and an XWayland
# Calamares never gets text-input, so the OSK can never appear. Make it
# deterministic: only claim Wayland when the compositor socket is actually
# reachable from this session; otherwise leave the platform unset so Qt
# falls back to xcb and the installer still opens instead of failing hard.
#
# Round 16 (preview-79 regression: the installer would not start at all,
# exit 134, "Could not find the Qt platform plugin 'wayland'"). Forcing
# QT_QPA_PLATFORM=wayland is only safe when the Qt Wayland platform plugin
# is actually installed (it lives in the qt6-wayland package;
# libqt6waylandclient6 is only the client library, not the plugin, and
# preview-79 did not ship the plugin at all). So Wayland is claimed only
# when BOTH the socket is reachable AND the plugin file exists; otherwise
# the platform stays unset and Qt falls back to xcb (XWayland) -- the
# installer must never fail to open because of platform selection.
# XWLIGHTOS_QT_PLUGIN_DIR is a test seam for the local pre-check (unset in
# production); it only changes which directory is probed for the plugin.
QT_WAYLAND_PLUGIN_DIR="${XWLIGHTOS_QT_PLUGIN_DIR:-/usr/lib/x86_64-linux-gnu/qt6/plugins/platforms}"
QT_WAYLAND_PLUGIN="$QT_WAYLAND_PLUGIN_DIR/libqwayland-egl.so"
QT_QPA_PLATFORM=""
if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] && \
   [ -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ] && \
   [ -f "$QT_WAYLAND_PLUGIN" ]; then
    QT_QPA_PLATFORM=wayland
fi

# Diagnostic: record which backend Calamares really runs on, so the next
# test can settle the OSK question with evidence instead of theories.
# Qt plugin logging names the loaded platform plugin. The plugin probe
# result is logged too: it is what decides wayland vs fallback.
LOG_DIR="${HOME:-/home/user}/.local/share/xwlightos"
mkdir -p "$LOG_DIR" 2>/dev/null || LOG_DIR="/tmp"
LOG_FILE="$LOG_DIR/calamares-launch.log"
{
    echo "=== $(date '+%Y-%m-%d %H:%M:%S %Z') xwlightos-installer ==="
    echo "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-<unset>} XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-<unset>} DISPLAY=${DISPLAY:-<unset>}"
    if [ -f "$QT_WAYLAND_PLUGIN" ]; then
        echo "wayland_plugin=present ($QT_WAYLAND_PLUGIN)"
    else
        echo "wayland_plugin=missing ($QT_WAYLAND_PLUGIN)"
    fi
    echo "QT_QPA_PLATFORM=${QT_QPA_PLATFORM:-<unset, Qt auto-select>}"
} >> "$LOG_FILE" 2>/dev/null || true
# 日志写不进也绝不能拖垮安装器：探通失败就丢到 /dev/null（与改动前一致），
# 2>>/dev/null 永不失败，exec 一定执行。
touch "$LOG_FILE" 2>/dev/null || LOG_FILE=/dev/null

# Pass the session variables through sudo as explicit `env` assignments:
# they are applied at exec time, after any PAM/sudoers processing, so no
# PAM module or sudoers env scrub can silently drop the Wayland socket
# address. sudo -E alone preserves them today (pam_systemd is
# Session-Interactive-Only and never runs for sudo), but the explicit
# passthrough does not depend on that staying true.
exec /usr/bin/sudo -n env \
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
    XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-}" \
    QT_QPA_PLATFORM="$QT_QPA_PLATFORM" \
    QT_LOGGING_RULES="qt.qpa.plugin=true" \
    DISPLAY="$DISPLAY" \
    XAUTHORITY="${XAUTHORITY:-}" \
    LANG="$LANG" LANGUAGE="$LANGUAGE" LC_ALL="$LC_ALL" \
    /usr/bin/calamares "$@" 2>>"$LOG_FILE"
