#!/bin/sh
# XWLightOS EasiNote5 launcher wrapper.
#
# 用户 2026-10-20「我有个新思路」：批注工具栏置顶守护放到 sh 里，
# 随白板主程序启动而启动、主程序退出时守护一并退出——
# 白板没运行时守护不再空转，省性能。
# （原实现是会话级 autostart 常驻，每秒轮询；见 git 历史。）
#
# 厂商 sh 以前台方式运行 EasiNote5（已从希沃白板 5.2.2.4.13701 deb 解包核验，
# sh 末尾直接以前台方式执行 $appPath/files/EasiNote5），因此本包装器阻塞等待
# 厂商 sh：守护的生命周期 == 白板主程序的生命周期。
set -u

VENDOR_SH=/opt/apps/com.seewo.easinote5/files/com.seewo.easinote5.sh
GUARD=/usr/local/bin/xwlightos-seewo-toolbar-guard

log() { echo "xwlightos-easinote5-launcher: $*"; }

[ -x "$VENDOR_SH" ] || { log "vendor sh missing: $VENDOR_SH"; exit 1; }

GUARD_PID=""
if [ -x "$GUARD" ]; then
    "$GUARD" >/dev/null 2>&1 &
    GUARD_PID=$!
    log "toolbar guard started (pid $GUARD_PID)"
else
    log "WARNING: toolbar guard missing, continuing without it: $GUARD"
fi

# 厂商 sh 启动时会往 ~/Desktop 拷贝一份 .desktop（首次启动），那份拷贝
# 不在登录时信任脚本的覆盖时间窗内；延迟几秒在后台补一次信任，
# 本会话内桌面上的白板图标即变为可信任（用户 2026-10-23 邮件指令）。
if [ -x /usr/local/bin/xwlightos-trust-desktop-launchers ]; then
    ( sleep 5; exec /usr/local/bin/xwlightos-trust-desktop-launchers ) >/dev/null 2>&1 &
fi

cleanup() {
    if [ -n "$GUARD_PID" ]; then
        kill "$GUARD_PID" 2>/dev/null || true
        wait "$GUARD_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

# 第 15 轮（用户 2026-11-14：希沃白板打不开了）：静态检查全部通过
# （包已装、库齐全、XWayland 在、无 AppArmor），真根因只能看运行时报错。
# 把厂商 sh 的 stderr 落盘（追加写、带时间戳），用户下次点开白板后直接贴
# 这个日志即可判定；.desktop 启动时 stderr 本来丢进 journal，用户不好拿。
# stdout 仍走原通道（厂商 sh 的正常输出不进日志，避免刷屏）。
LOG_DIR="${HOME:-/home/user}/.local/share/xwlightos"
mkdir -p "$LOG_DIR" 2>/dev/null || LOG_DIR="/tmp"
LOG_FILE="$LOG_DIR/easinote5-launch.log"
{
    echo "=== $(date '+%Y-%m-%d %H:%M:%S %Z') xwlightos-easinote5-launcher ==="
    echo "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-<unset>} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-<unset>} DISPLAY=${DISPLAY:-<unset>}"
} >> "$LOG_FILE" 2>/dev/null || true
# 日志写不进也绝不能拖垮白板：探通失败就丢到 /dev/null（与改动前一致），
# 2>>/dev/null 永不失败，厂商 sh 一定执行。
touch "$LOG_FILE" 2>/dev/null || LOG_FILE=/dev/null

# 阻塞运行厂商 sh（%F 参数透传）；白板退出后 trap 自动清理守护。
"$VENDOR_SH" "$@" 2>>"$LOG_FILE"
