#!/bin/sh
# XWLightOS: keep the Seewo whiteboard from reaching its vendor update service.
#
# EasiNote5 performs an independent HTTP update check against
#   https://ota-gateway.seewo.com/api/v1/update
# If the vendor ships a new build, an in-place upgrade would replace the
# pinned, tested image. Redirecting the host to 127.0.0.1 makes the check
# fail fast without delaying startup.
#
# Only ota-gateway.seewo.com is blocked. Other Seewo hosts (login, course
# content) must keep working.
#
# This runs at boot (not at build time) because the live-build process
# regenerates /etc/hosts during image assembly, wiping any build-time edit.
set -u

HOSTS=/etc/hosts
TARGET=ota-gateway.seewo.com

# Already blocked (by an earlier boot, or by the administrator).
if grep -qE "^[^#]*[[:space:]]$TARGET([[:space:]]|$)" "$HOSTS" 2>/dev/null; then
    exit 0
fi

if [ ! -e "$HOSTS" ]; then
    printf '127.0.0.1\tlocalhost\n::1\t\tip6-localhost ip6-loopback\n' >"$HOSTS" || {
        echo "xwlightos-seewo-ota-block: cannot create $HOSTS" >&2
        exit 1
    }
fi

printf '127.0.0.1\t%s\n' "$TARGET" >>"$HOSTS" || {
    echo "xwlightos-seewo-ota-block: cannot extend $HOSTS" >&2
    exit 1
}

grep -qE "^[^#]*[[:space:]]$TARGET([[:space:]]|$)" "$HOSTS" || {
    echo "xwlightos-seewo-ota-block: $TARGET is still resolvable" >&2
    exit 1
}

echo "xwlightos-seewo-ota-block: $TARGET -> 127.0.0.1"
exit 0
