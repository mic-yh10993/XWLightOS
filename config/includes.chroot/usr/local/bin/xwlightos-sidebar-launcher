#!/bin/sh
# XWLightOS Seewo sidebar (com.seewo.easisidebar) stabilising launcher.
#
# Diagnosis (user report 2026-10-24: the Seewo sidebar keeps crashing):
# the vendor sidebar is an X11-oriented floating bar. On a Wayland
# session it loses the X11 window APIs it was built for and dies; it
# also depends on the Udi hotspot service and the whiteboard's
# swenserver being up. This wrapper:
#   * honours the user's off switch (~/.config/xwlightos/sidebar-off,
#     written by the XWLightOS Settings tool),
#   * forces X11 backends (GDK_BACKEND/QT_QPA_PLATFORM=xcb, XWayland),
#   * logs stdout/stderr to ~/.local/share/xwlightos/easisidebar.log,
#   * restarts the bar at most 3 times with backoff, then stays down
#     (no crash loop burning CPU all day).
#
# User report 2026-10-24 ("very big problem" #8): the sidebar crashes
# on XWLightOS but works on stock Debian 13, and it must NOT autostart
# by default. Two real differences found from the vendor .deb itself:
#   * the vendor user service runs the bar with
#     WorkingDirectory=/opt/apps/com.seewo.easisidebar/files/bin/,
#     while the old launcher ran it from the user's home directory;
#     a .NET/Avalonia app resolving assets relative to its working
#     directory is a classic crash source. This launcher now cds into
#     the binary's directory before exec, exactly like the vendor unit.
#   * the vendor postinst enables the user service only when a live
#     user session exists at install time; at image build time there
#     is none, so the service was never enabled for anyone. The
#     launcher is therefore the only start path on XWLightOS, and it
#     must mirror the vendor service environment (working directory,
#     backend wait) instead of a bare Exec.
# Default-off is implemented by the sidebar-off flag (shipped in
# /etc/skel, so every new user starts with the sidebar off; the
# Settings tool removes the flag when the user turns it on). Manual
# starts (app-grid icon) use --manual, which bypasses the flag check
# so a user who clicks the icon always gets the bar.
set -u

# 2026-10-24 侧边栏闪退修法：autostart 环境里 HOME 几乎不会缺失，但
# set -u 下 HOME 一旦未定义本脚本会立刻死掉且无日志。兜底到 /tmp，
# 保证启动器永远不因环境变量问题静默死亡。
if [ -z "${HOME:-}" ]; then HOME=/tmp; fi

MANUAL=0
if [ "${1:-}" = "--manual" ]; then MANUAL=1; fi

FLAG_OFF="$HOME/.config/xwlightos/sidebar-off"
if [ "$MANUAL" -eq 0 ] && [ -f "$FLAG_OFF" ]; then
    # 旧写法静默退出：自启没起栏时日志里没有任何痕迹，“没起栏”
    # 和“起栏即崩”无法区分。先记一笔再退出，下次用户报闪退时
    # 凭这一行就能排除“其实是开关关着”这种假闪退。
    mkdir -p "$HOME/.local/share/xwlightos" 2>/dev/null || true
    echo "xwlightos-sidebar: off-flag present, not starting (Settings switch off)" >>"$HOME/.local/share/xwlightos/easisidebar.log" 2>&1 || true
    exit 0
fi

LOG_DIR="$HOME/.local/share/xwlightos"
mkdir -p "$LOG_DIR" 2>/dev/null || LOG_DIR=/tmp
LOG="$LOG_DIR/easisidebar.log"

# 2026-10-24 22:40 用户假设：侧边栏闪退是不是字体问题（此前 Debian
# 打不开侧边栏是因为缺少字体）。验证结论见提交信息：系统级 CJK 字体
# （fonts-noto-cjk）镜像里本来就有，fontconfig 缺字体只会 fallback
# 成方框字、不会让 .NET 应用闪退；真正与字体相关的路径是厂商资源
# 按工作目录相对解析（已由 cd 到二进制目录修法覆盖）。但厂商是否
# 捆绑了专用字体、光凭现有材料无法证伪，因此这里把字体诊断写进日志：
# 下次闪退时日志里直接能看到 CJK 字体数量与解析结果，不用再猜。
if command -v fc-list >/dev/null 2>&1; then
    echo "xwlightos-sidebar: fontconfig CJK fonts: $(fc-list :lang=zh 2>/dev/null | wc -l)" >>"$LOG" 2>&1 || true
fi
if command -v fc-match >/dev/null 2>&1; then
    echo "xwlightos-sidebar: fc-match Noto Sans CJK SC: $(fc-match 'Noto Sans CJK SC' 2>/dev/null || echo 'no match')" >>"$LOG" 2>&1 || true
fi

# Session diagnostics: the bar is X11-oriented; record which session
# type it actually runs under so a Wayland/X11 mismatch is visible in
# the log instead of guessed (the installed account is forced to X11
# by postinstall, but only the log proves which session a given
# machine really started). DBus is logged as set/unset only, never
# its value.
echo "xwlightos-sidebar: session: type=${XDG_SESSION_TYPE:-unset} display=${DISPLAY:-unset} wayland=${WAYLAND_DISPLAY:-unset} dbus=${DBUS_SESSION_BUS_ADDRESS:+set}" >>"$LOG" 2>&1 || true

# Discover the vendor entry point: a dedicated binary if present,
# otherwise the Exec line of the vendor .desktop. The vendor user
# service runs files/bin/EasiSideBar (the postinst symlink
# files/bin -> files/<version>), so that path is tried FIRST: the old
# list missed it and fell through to the versioned .desktop Exec,
# which runs the bar from the wrong working directory.
CANDIDATES="/opt/apps/com.seewo.easisidebar/files/bin/EasiSideBar \
/opt/apps/com.seewo.easisidebar/files/EasiSidebar \
/opt/apps/com.seewo.easisidebar/files/com.seewo.easisidebar \
/opt/apps/com.seewo.easisidebar/files/EasiSideBar"
CMD=""
for c in $CANDIDATES; do
    [ -x "$c" ] && { CMD="$c"; break; }
done
if [ -z "$CMD" ]; then
    for dt in /usr/share/applications/com.seewo.easisidebar.desktop \
              /etc/xdg/autostart/*sidebar*.desktop \
              /opt/apps/com.seewo.easisidebar/entries/applications/com.seewo.easisidebar.desktop; do
        [ -f "$dt" ] || continue
        # 2026-10-24 侧边栏闪退修法：/etc/xdg/autostart/*sidebar*.desktop
        # 这个 glob 会命中启动器自己的 autostart 文件
        # xwlightos-easisidebar.desktop；若此时厂商二进制与厂商 .desktop
        # 均缺失，旧写法会把启动器自己的 Exec 读成 CMD 而自我执行，
        # 表现为侧边栏“闪退”（实为递归启动）。跳过自身，CMD 等于自身
        # 时也视为未找到。
        case "$dt" in
            */xwlightos-easisidebar.desktop) continue ;;
        esac
        _exec="$(sed -n 's/^Exec=//p' "$dt" | head -n 1 | sed 's/ *%[A-Za-z]//g')"
        case "$_exec" in
            */xwlightos-sidebar-launcher|*/xwlightos-sidebar-launcher\ *) continue ;;
        esac
        CMD="$_exec"
        [ -n "$CMD" ] && break
    done
fi
case "$CMD" in
    */xwlightos-sidebar-launcher|*/xwlightos-sidebar-launcher\ *) CMD="" ;;
esac
# Last-resort discovery: if the versioned binary moved (e.g. the
# files/bin symlink is gone), the fixed candidate list and the
# .desktop fallbacks both miss it and the launcher would silently
# no-op. Scan the vendor tree for an executable of that name first.
if [ -z "$CMD" ] && [ -d /opt/apps/com.seewo.easisidebar/files ]; then
    CMD="$(find /opt/apps/com.seewo.easisidebar/files -maxdepth 3 ! -type d \( -name 'EasiSideBar*' -o -name 'EasiSidebar*' \) -executable 2>/dev/null | head -n 1 || true)"
    [ -n "$CMD" ] && echo "xwlightos-sidebar: fallback discovery found: $CMD" >>"$LOG" 2>&1 || true
fi
[ -n "$CMD" ] || { echo "xwlightos-sidebar: vendor sidebar entry not found" >>"$LOG" 2>&1; exit 0; }

# .NET/native diagnostics: the vendor bar's runtime form
# (self-contained vs system dotnet) is not recorded anywhere in this
# repo, so a missing native library or runtime would previously
# surface only as a bare crash. Record them here; a 'not found' line
# in this log is the difference between a diagnosable crash and
# another guess.
_bin0="${CMD%% *}"
if command -v ldd >/dev/null 2>&1; then
    _missing="$(ldd "$_bin0" 2>/dev/null | grep 'not found' || true)"
    [ -n "$_missing" ] && echo "xwlightos-sidebar: ldd missing libs for $_bin0: $_missing" >>"$LOG" 2>&1 || true
fi
if command -v dotnet >/dev/null 2>&1; then
    echo "xwlightos-sidebar: dotnet runtimes: $(dotnet --list-runtimes 2>/dev/null | tr '\n' ';' || echo unknown)" >>"$LOG" 2>&1 || true
fi
unset _bin0 _missing

export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb
export ELECTRON_OZONE_PLATFORM_HINT=x11

# 2026-10-24 侧边栏闪退修法：侧边栏依赖希沃管家后端服务
# (com.seewo.terminalmanager.service)。登录后立即起栏时后端可能还没
# 就绪，是经典的“起栏即崩”。先等后端 active（最多 15 秒），超时后仍
# 起栏——绝不因后端故障无限阻塞登录；同时把后端状态写进日志，方便
# 用户回传时定位。
if command -v systemctl >/dev/null 2>&1; then
    _wait=0
    while [ "$_wait" -lt 15 ]; do
        [ "$(systemctl is-active com.seewo.terminalmanager.service 2>/dev/null)" = "active" ] && break
        sleep 2
        _wait=$((_wait + 2))
    done
    echo "xwlightos-sidebar: backend states: terminalmanager=$(systemctl is-active com.seewo.terminalmanager.service 2>/dev/null || echo unknown)" >>"$LOG" 2>&1
    # The bar's header comment also names the Udi hotspot service as a
    # dependency, but the wait above only covers terminalmanager (Udi
    # is default-off, so waiting for it would stall login). At least
    # record the Udi unit files' states here so a missing Udi unit is
    # visible in the same log instead of becoming a second guess.
    echo "xwlightos-sidebar: udi units: $(systemctl list-unit-files 2>/dev/null | grep -i 'udi' | tr '\n' ';' || true)" >>"$LOG" 2>&1
fi

attempt=0
while [ "$attempt" -lt 3 ]; do
    attempt=$((attempt + 1))
    echo "xwlightos-sidebar: start attempt $attempt: $CMD" >>"$LOG" 2>&1
    # Word splitting of $CMD is intentional (Exec may carry arguments).
    # shellcheck disable=SC2086
    _start=$(date +%s)
    # Run from the binary's own directory, exactly like the vendor user
    # service (WorkingDirectory=.../files/bin/): the bar resolves
    # assets relative to its working directory, and running it from
    # $HOME is a crash source (user report 2026-10-24 #8).
    _bin="${CMD%% *}"
    _bindir="$(dirname "$_bin")"
    (cd "$_bindir" 2>/dev/null && $CMD >>"$LOG" 2>&1)
    rc=$?
    _elapsed=$(( $(date +%s) - _start ))
    echo "xwlightos-sidebar: exited rc=$rc after ${_elapsed}s" >>"$LOG" 2>&1
    # 2026-10-24 侧边栏闪退修法：会 daemonize 的厂商二进制在 fork 后
    # 父进程迅速返回，旧写法把“快速退出”一律算成一次崩溃，连烧 3 次。
    # 若快速退出后侧边栏进程仍在，说明它已成功 daemonize，视为运行中。
    # 匹配必须锚定在命令行开头或路径分隔符后，避免误命中命令行里仅
    # 提到侧边栏名字的无关进程（如测试外壳、编辑器）。判定时先等 1 秒，
    # 因为 daemon 进程启动（如解释器/ Electron 预热）可能比父进程退出慢，
    # 立刻查会漏判、误烧一次尝试。
    # 尾部字符类还必须接受 '.'：.NET 形态的 daemon 进程命令行是
    # `dotnet .../EasiSideBar.dll`，名字后面跟的是 '.' 而不是空格或
    # 行尾；旧的 `( |$)` 类会漏判它，连烧 3 次尝试、最后记一笔假的
    # “gave up”，而实际上栏已经在跑了。
    if [ "$rc" -eq 0 ] && [ "$_elapsed" -lt 3 ] && command -v pgrep >/dev/null 2>&1; then
        sleep 1
        if pgrep -f '(^|/)(EasiSidebar|easisidebar|EasiSideBar)(\.|[ /]|$)' >/dev/null 2>&1; then
            echo "xwlightos-sidebar: bar daemonized (still running after quick exit), treating as success" >>"$LOG" 2>&1
            exit 0
        fi
    fi
    # 手动模式（--manual）是用户主动点图标启动，不受关闭标志影响；
    # 自启模式下标志出现说明用户在设置里刚关掉它，立即停下不再重试。
    if [ "$MANUAL" -eq 0 ]; then
        [ -f "$FLAG_OFF" ] && exit 0
    fi
    sleep 2
done
echo "xwlightos-sidebar: gave up after 3 attempts (see log)" >>"$LOG" 2>&1
exit 0
