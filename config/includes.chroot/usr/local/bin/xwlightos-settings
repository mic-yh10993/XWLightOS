#!/usr/bin/python3
# XWLightOS 设置 — small settings tool for the Seewo components.
#
# User instruction 2026-10-24: provide a settings program that can
# toggle at boot the Seewo manager (希沃管家) backend service
# (system service com.seewo.terminalmanager.service).
#
# User instruction 2026-10-25 09:01: the Udi component and the Seewo
# sidebar are TEMPORARILY REMOVED from the build, so their toggles
# are gone from this tool too; restoring them is a revert of the
# removal commits. The manager backend is a different component and
# is NOT removed.
#
# The manager toggle is a system service: state is read with
# `systemctl is-enabled` and changed with `pkexec systemctl
# enable/disable --now`, so the toggle is real and persistent.
import glob
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk  # noqa: E402

def find_unit(patterns, fallback):
    for pat in patterns:
        for base in ("/usr/lib/systemd/system", "/lib/systemd/system",
                     "/etc/systemd/system"):
            hits = sorted(glob.glob(os.path.join(base, pat)))
            if hits:
                return os.path.basename(hits[0])
    return fallback


TM_UNIT = find_unit(["com.seewo.terminalmanager.service"],
                    "com.seewo.terminalmanager.service")


def service_enabled(unit):
    try:
        out = subprocess.run(
            ["systemctl", "is-enabled", unit],
            capture_output=True, text=True, timeout=10)
        return out.stdout.strip() == "enabled"
    except Exception:
        return False


def service_present(unit):
    for base in ("/usr/lib/systemd/system", "/lib/systemd/system",
                 "/etc/systemd/system"):
        if os.path.exists(os.path.join(base, unit)):
            return True
    return False


def set_service(unit, on, parent):
    action = "enable" if on else "disable"
    cmd = ["pkexec", "systemctl", action, "--now", unit]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        # 用户 2026-10-24 邮件《很大问题》第 3 项：请求 root 权限失败
        # 不要自动重试。一次拨动只请求一次授权：失败就明确提示一次，
        # 绝不再次弹出授权框（回弹拨动开关时必须被 _busy 守卫挡住，
        # 不能靠 handler_block 一道防线，见 on_service）。
        if res.returncode == 126:
            msg = "已取消授权，未作任何更改。"
        else:
            msg = "设置失败：%s" % (res.stderr.strip() or unit)
        dlg = Gtk.MessageDialog(
            transient_for=parent, modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text=msg)
        dlg.run()
        dlg.destroy()
        return False
    return True


class Row(Gtk.Box):
    def __init__(self, title, subtitle, initial, sensitive=True):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL,
                         spacing=12)
        self.set_margin_top(10)
        self.set_margin_bottom(10)
        self.set_margin_start(14)
        self.set_margin_end(14)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl = Gtk.Label(label=title, xalign=0)
        lbl.set_markup("<b>%s</b>" % title)
        sub = Gtk.Label(label=subtitle, xalign=0)
        sub.get_style_context().add_class("dim-label")
        texts.pack_start(lbl, False, False, 0)
        texts.pack_start(sub, False, False, 0)
        self.pack_start(texts, True, True, 0)
        self.switch = Gtk.Switch()
        self.switch.set_active(initial)
        self.switch.set_sensitive(sensitive)
        self.switch.set_valign(Gtk.Align.CENTER)
        self.pack_start(self.switch, False, False, 0)


class Window(Gtk.Window):
    def __init__(self):
        super().__init__(title="XWLightOS 设置")
        # 拨动开关时正在请求授权/执行 systemctl 的重入守卫：失败回弹
        # 开关时若再次触发 on_service，就会第二次弹出授权框——用户
        # 2026-10-24 第 3 项明确要求失败不自动重试，因此回弹必须被
        # 这道标志挡住，不能只依赖 handler_block_by_func。
        self._busy = False
        self.set_default_size(520, 320)
        self.set_border_width(8)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        head = Gtk.Label(xalign=0)
        head.set_markup("希沃管家后端开机启动设置（修改后重启生效，"
                        "服务开关同时启停当前运行）")
        head.set_margin_start(14)
        box.pack_start(head, False, False, 6)

        tm_ok = service_present(TM_UNIT)
        self.row_tm = Row(
            "希沃管家后端服务", "systemd 服务：%s" % TM_UNIT,
            service_enabled(TM_UNIT) if tm_ok else False,
            sensitive=tm_ok)
        self.row_tm.switch.connect(
            "notify::active", self.on_service, TM_UNIT, self.row_tm)
        box.pack_start(self.row_tm, False, False, 0)

        note = Gtk.Label(xalign=0)
        note.set_markup("未安装的组件开关会变灰。")
        note.set_margin_start(14)
        box.pack_start(note, False, False, 8)
        self.add(box)

    def on_service(self, switch, _param, unit, row):
        # 回弹/重入守卫：一次拨动只走一次授权流程。回弹本身也在守卫
        # 内完成，即使 handler_block 失效也不会再次触发授权。
        if self._busy:
            return
        want = switch.get_active()
        self._busy = True
        try:
            ok = set_service(unit, want, self)
            if not ok:
                switch.handler_block_by_func(self.on_service)
                try:
                    switch.set_active(not want)
                finally:
                    switch.handler_unblock_by_func(self.on_service)
        finally:
            self._busy = False


def main():
    win = Window()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
