#!/usr/bin/python3
# XWLightOS 设置 — small settings tool for the Seewo components.
#
# User instruction 2026-10-24: provide a settings program that can
# toggle at boot the Seewo manager (希沃管家) backend service
# (system service com.seewo.terminalmanager.service).
#
# User instruction 2026-10-25 09:01: the Udi component and the Seewo
# sidebar are TEMPORARILY REMOVED from the build, so their toggles
# are gone from this tool too; restoring them is a revert of the
# removal commits. The manager backend is a different component and
# is NOT removed.
#
# The manager toggle is a system service: state is read with
# `systemctl is-enabled` and changed with `pkexec systemctl
# enable/disable --now`, so the toggle is real and persistent.
#
# User instruction 2026-11-10 22:14 (mail "补充" item 2): the touch
# fallback must auto-detect whether it is needed, auto-enable, pop a
# notification, and be toggleable here. The unit is
# xwlightos-touch-bypass.service (Build 72), flipping it really starts
# or stops the CVTE hidraw->uinput bypass.
#
# User instruction 2026-11-14 (round 16): turning the touch toggle OFF
# must pop a "keep this setting?" confirmation with a 10-second countdown
# (same policy as Windows display-resolution changes: turning the bypass
# off may kill the touchscreen, so a timeout must auto-restore it). The
# touch toggle therefore has its own handler (on_touch) instead of the
# shared on_service: OFF goes through the pkexec helper
# xwlightos-touch-bypass-ctl (which forks a root-side 10-second waiter
# so restore needs no second authorization), then the confirmation
# dialog; ON goes through the same helper (which also rewrites the
# first-boot stamp) plus the notification.
import glob
import os
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib  # noqa: E402

def find_unit(patterns, fallback):
    for pat in patterns:
        for base in ("/usr/lib/systemd/system", "/lib/systemd/system",
                     "/etc/systemd/system"):
            hits = sorted(glob.glob(os.path.join(base, pat)))
            if hits:
                return os.path.basename(hits[0])
    return fallback


TM_UNIT = find_unit(["com.seewo.terminalmanager.service"],
                    "com.seewo.terminalmanager.service")

TOUCH_UNIT = find_unit(["xwlightos-touch-bypass.service"],
                       "xwlightos-touch-bypass.service")

# 第 16 轮：触屏兜底开关的 pkexec 助手（on/off 子命令）与关闭确认的
# 决策文件。助手以 root 跑：off 时 fork 10 秒等待者（超时自动恢复，
# 无需第二次授权）；on 时先把首次启动 stamp 改写成 bypass。
TOUCH_CTL = "/usr/local/libexec/xwlightos-touch-bypass-ctl"
TOUCH_DECISION_DIR = "/run/xwlightos-touch-bypass-decision"
TOUCH_KEEP_FILE = os.path.join(TOUCH_DECISION_DIR, "keep")
TOUCH_RESTORE_FILE = os.path.join(TOUCH_DECISION_DIR, "restore")


def _confirm_timeout():
    # 确认窗倒计时出货值 10 秒；环境变量只供本地先验缩短，生产不设。
    try:
        v = int(os.environ.get("XWLIGHTOS_TOUCH_BYPASS_CONFIRM_TIMEOUT",
                               "10"))
        return v if v > 0 else 10
    except ValueError:
        return 10


TOUCH_CONFIRM_TIMEOUT_SEC = _confirm_timeout()

# 用户 2026-11-11 邮件《补充》第 3 项（第 13 轮）：无需授权访问硬盘
# 驱动器开关。状态 = polkit 规则文件是否存在；拨动 = 经 pkexec 调
# 助手脚本装上/移走规则（照希沃管家开关的 pkexec 模式）。安装时勾了
# 免密码登录时，一次性服务 xwlightos-noauth-drives-autosetup.service
# 会在首次开机自动装上规则，开关打开；之后手动拨动不再被顶回。
NOAUTH_RULE = "/etc/polkit-1/rules.d/49-xwlightos-noauth-drives.rules"
NOAUTH_HELPER = "/usr/local/libexec/xwlightos-toggle-noauth-drives"

# 用户 2026-10-28 邮件第 4 项：桌面清理开关拨的是用户级 path 单元
#（xwlightos-desktop-cleaner.path），不是系统服务。用户级单元不需要
# pkexec：开关 = mask/unmask + enable/disable（--user），mask 能盖住
# /etc/systemd/user 下的系统级启用链接，关掉即真正停掉监视。
CLEANER_PATH_UNIT = "xwlightos-desktop-cleaner.path"


def user_unit_present(unit):
    for base in ("/etc/systemd/user", "/usr/lib/systemd/user",
                 "/lib/systemd/user"):
        if os.path.exists(os.path.join(base, unit)):
            return True
    return False


def user_service_enabled(unit):
    try:
        out = subprocess.run(
            ["systemctl", "--user", "is-enabled", unit],
            capture_output=True, text=True, timeout=10)
        return out.stdout.strip() == "enabled"
    except Exception:
        return False


def set_user_service(unit, on, parent):
    if on:
        cmds = [["systemctl", "--user", "unmask", unit],
                ["systemctl", "--user", "enable", "--now", unit]]
    else:
        # mask --now 一步完成停监视 + 盖住系统级启用链接。
        cmds = [["systemctl", "--user", "mask", "--now", unit]]
    for cmd in cmds:
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode != 0:
            msg = "设置失败：%s" % (res.stderr.strip() or unit)
            dlg = Gtk.MessageDialog(
                transient_for=parent, modal=True,
                message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.OK,
                text=msg)
            dlg.run()
            dlg.destroy()
            return False
    return True


def service_enabled(unit):
    try:
        out = subprocess.run(
            ["systemctl", "is-enabled", unit],
            capture_output=True, text=True, timeout=10)
        return out.stdout.strip() == "enabled"
    except Exception:
        return False


def service_present(unit):
    for base in ("/usr/lib/systemd/system", "/lib/systemd/system",
                 "/etc/systemd/system"):
        if os.path.exists(os.path.join(base, unit)):
            return True
    return False


def set_service(unit, on, parent):
    action = "enable" if on else "disable"
    cmd = ["pkexec", "systemctl", action, "--now", unit]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        # 用户 2026-10-24 邮件《很大问题》第 3 项：请求 root 权限失败
        # 不要自动重试。一次拨动只请求一次授权：失败就明确提示一次，
        # 绝不再次弹出授权框（回弹拨动开关时必须被 _busy 守卫挡住，
        # 不能靠 handler_block 一道防线，见 on_service）。
        if res.returncode == 126:
            msg = "已取消授权，未作任何更改。"
        else:
            msg = "设置失败：%s" % (res.stderr.strip() or unit)
        dlg = Gtk.MessageDialog(
            transient_for=parent, modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text=msg)
        dlg.run()
        dlg.destroy()
        return False
    return True


def noauth_drives_enabled():
    return os.path.exists(NOAUTH_RULE)


def notify_touch_enabled():
    # 第 15 轮（用户 2026-11-14：开机后开启兜底未提醒，期望开启就提醒）：
    # 触屏兜底开关手动拨到开且服务启动成功后，在会话内直接弹通知。
    # 设置程序本身跑在用户会话里，自带会话总线，直接调 notify-send 即可，
    # 无需 runuser、无需等总线。Popen 即发即走，永不阻塞界面；
    # notify-send 缺失或发送失败都静默吞掉，绝不影响开关本身。
    try:
        subprocess.Popen(
            ["notify-send", "-a", "XWLightOS 设置", "触屏兜底已开启",
             "触屏兜底服务已启动，希沃触屏可正常触摸。关掉后触屏失效。"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def set_touch_bypass(on, parent):
    # 第 16 轮：触屏兜底开关经 pkexec 调助手（on/off），与 set_service
    # 同款：一次拨动只请求一次授权，失败明确提示一次、绝不再次弹出
    # 授权框（回弹拨动开关时必须被 _busy 守卫挡住）。
    cmd = ["pkexec", TOUCH_CTL, "on" if on else "off"]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        if res.returncode == 126:
            msg = "已取消授权，未作任何更改。"
        else:
            msg = "设置失败：%s" % (res.stderr.strip() or TOUCH_CTL)
        dlg = Gtk.MessageDialog(
            transient_for=parent, modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text=msg)
        dlg.run()
        dlg.destroy()
        return False
    return True


def write_touch_decision(kind):
    # 第 16 轮：把确认窗的结果写给 root 等待者（keep = 保留关闭，
    # restore = 立即恢复开启）。决策目录由助手建（1777），用户可写。
    # 写失败静默吞掉：等待者 10 秒到时按无决策自动恢复，仍是安全方向。
    try:
        path = TOUCH_KEEP_FILE if kind == "keep" else TOUCH_RESTORE_FILE
        with open(path, "w") as f:
            f.write(kind + "\n")
    except Exception:
        pass


def wait_touch_enabled(timeout_sec=5):
    # 第 16 轮：轮询 systemctl is-enabled，最长 timeout_sec 秒；读到
    # enabled 返回 True。等待者的恢复与确认窗的倒计时有约 1 秒的
    # 启动 skew，轮询盖住它；is-enabled 只查启用链接，恢复命令一起
    # 来就读到 True，通常 1 秒内返回。
    deadline = time.time() + timeout_sec
    while time.time() < deadline:
        if service_enabled(TOUCH_UNIT):
            return True
        time.sleep(0.5)
    return service_enabled(TOUCH_UNIT)


def confirm_touch_off(parent):
    # 第 16 轮：触屏兜底关闭确认窗（Windows 改分辨率同款策略）。
    # 返回 "keep"（保留关闭）、"restore"（恢复开启）或 "timeout"
    # （倒计时到 0 或关掉窗口，按恢复处理）。对话框模态于设置窗口，
    # 倒计时用 GLib timeout 每秒更新标签；点按钮或到时都关闭。
    dlg = Gtk.Dialog(title="触屏兜底服务已关闭", transient_for=parent,
                     modal=True)
    dlg.set_default_size(440, 190)
    content = dlg.get_content_area()
    msg = Gtk.Label(xalign=0)
    msg.set_markup(
        "触屏兜底服务已关闭，是否保留设置？\n"
        "触屏可能已失效；点不到恢复按钮时请等待倒计时结束自动恢复。")
    msg.set_margin_start(14)
    msg.set_margin_end(14)
    msg.set_margin_top(12)
    content.pack_start(msg, False, False, 0)
    countdown = Gtk.Label(xalign=0)
    countdown.set_margin_start(14)
    countdown.set_margin_end(14)
    content.pack_start(countdown, False, False, 6)
    dlg.add_button("保留关闭", Gtk.ResponseType.YES)
    dlg.add_button("恢复开启", Gtk.ResponseType.NO)
    dlg.set_default_response(Gtk.ResponseType.NO)
    remaining = [TOUCH_CONFIRM_TIMEOUT_SEC]
    countdown.set_text("%d 秒后自动恢复开启" % remaining[0])
    # tick 返回 False 时 GLib 已自动摘掉该 source；再调 source_remove
    # 会报 "Source ID ... was not found" 告警（本地 GTK 测试实测）。
    # 用 timer_done 记它是否已自摘，run() 返回后只在仍在时才摘。
    timer_done = [False]

    def tick():
        remaining[0] -= 1
        if remaining[0] <= 0:
            timer_done[0] = True
            dlg.response(Gtk.ResponseType.CANCEL)
            return False
        countdown.set_text("%d 秒后自动恢复开启" % remaining[0])
        return True

    timer = GLib.timeout_add_seconds(1, tick)
    dlg.show_all()
    resp = dlg.run()
    if not timer_done[0]:
        GLib.source_remove(timer)
    dlg.destroy()
    if resp == Gtk.ResponseType.YES:
        return "keep"
    if resp == Gtk.ResponseType.NO:
        return "restore"
    return "timeout"


def set_noauth_drives(on, parent):
    # 与 set_service 同款：一次拨动只请求一次授权，失败明确提示一次、
    # 绝不再次弹出授权框（回弹拨动开关时必须被 _busy 守卫挡住）。
    cmd = ["pkexec", NOAUTH_HELPER, "on" if on else "off"]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        if res.returncode == 126:
            msg = "已取消授权，未作任何更改。"
        else:
            msg = "设置失败：%s" % (res.stderr.strip() or NOAUTH_HELPER)
        dlg = Gtk.MessageDialog(
            transient_for=parent, modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text=msg)
        dlg.run()
        dlg.destroy()
        return False
    return True


class Row(Gtk.Box):
    def __init__(self, title, subtitle, initial, sensitive=True):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL,
                         spacing=12)
        self.set_margin_top(10)
        self.set_margin_bottom(10)
        self.set_margin_start(14)
        self.set_margin_end(14)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl = Gtk.Label(label=title, xalign=0)
        lbl.set_markup("<b>%s</b>" % title)
        sub = Gtk.Label(label=subtitle, xalign=0)
        sub.get_style_context().add_class("dim-label")
        texts.pack_start(lbl, False, False, 0)
        texts.pack_start(sub, False, False, 0)
        self.pack_start(texts, True, True, 0)
        self.switch = Gtk.Switch()
        self.switch.set_active(initial)
        self.switch.set_sensitive(sensitive)
        self.switch.set_valign(Gtk.Align.CENTER)
        self.pack_start(self.switch, False, False, 0)


class Window(Gtk.Window):
    def __init__(self):
        super().__init__(title="XWLightOS 设置")
        # 拨动开关时正在请求授权/执行 systemctl 的重入守卫：失败回弹
        # 开关时若再次触发 on_service，就会第二次弹出授权框——用户
        # 2026-10-24 第 3 项明确要求失败不自动重试，因此回弹必须被
        # 这道标志挡住，不能只依赖 handler_block_by_func。
        self._busy = False
        self.set_default_size(520, 430)
        self.set_border_width(8)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        head = Gtk.Label(xalign=0)
        head.set_markup("希沃管家后端、触屏兜底、硬盘免授权与桌面清理设置（开关同时启停当前运行，"
                        "重启后保持）")
        head.set_margin_start(14)
        box.pack_start(head, False, False, 6)

        tm_ok = service_present(TM_UNIT)
        self.row_tm = Row(
            "希沃管家后端服务", "systemd 服务：%s" % TM_UNIT,
            service_enabled(TM_UNIT) if tm_ok else False,
            sensitive=tm_ok)
        self.row_tm.switch.connect(
            "notify::active", self.on_service, TM_UNIT, self.row_tm)
        box.pack_start(self.row_tm, False, False, 0)

        # 用户 2026-11-10 22:14 邮件《补充》第 2 项：触屏兜底的开关。
        # 第 16 轮走专用流程 on_touch（不再走通用 on_service）：关掉后
        # 希沃触屏失效（兜底停了，内核驱动本身不出触摸事件），所以关
        # 闭要弹确认窗、10 秒无操作自动恢复开启（Windows 改分辨率同款
        # 策略）；打开后服务启动，立即生效。
        touch_ok = service_present(TOUCH_UNIT)
        self.row_touch = Row(
            "触屏兜底服务",
            "systemd 服务：%s（关掉后触屏失效，10 秒无操作自动恢复）"
            % TOUCH_UNIT,
            service_enabled(TOUCH_UNIT) if touch_ok else False,
            sensitive=touch_ok)
        self.row_touch.switch.connect(
            "notify::active", self.on_touch, self.row_touch)
        box.pack_start(self.row_touch, False, False, 0)

        # 用户 2026-11-11 邮件《补充》第 3 项（第 13 轮）：无需授权访问
        # 硬盘驱动器开关。打开后，文件里访问硬盘分区不需要输入密码；
        # 安装时勾了免密码登录会自动打开。状态是 polkit 规则文件是否
        # 存在，拨动即经 pkexec 装上/移走规则（照希沃管家开关模式）。
        noauth_ok = os.path.exists(NOAUTH_HELPER)
        self.row_noauth = Row(
            "无需授权访问硬盘驱动器",
            "开启后，文件中的硬盘分区不需要输入密码（安装时勾选免密码登录会自动开启）",
            noauth_drives_enabled() if noauth_ok else False,
            sensitive=noauth_ok)
        self.row_noauth.switch.connect(
            "notify::active", self.on_noauth_drives, self.row_noauth)
        box.pack_start(self.row_noauth, False, False, 0)

        # 用户 2026-10-28 邮件第 4 项：自动清理希沃厂商桌面图标的开关。
        # 打开时桌面目录一变化就清理厂商写进来的 .desktop 启动器
        #（事件驱动，平时不轮询）；关掉后厂商图标会留在桌面，
        #需手动删除；你的文件和文件夹不受影响。
        cleaner_ok = user_unit_present(CLEANER_PATH_UNIT)
        self.row_cleaner = Row(
            "自动清理希沃厂商桌面图标",
            "用户级单元：%s（关掉后厂商图标不再自动清理）" % CLEANER_PATH_UNIT,
            user_service_enabled(CLEANER_PATH_UNIT) if cleaner_ok else False,
            sensitive=cleaner_ok)
        self.row_cleaner.switch.connect(
            "notify::active", self.on_user_service,
            CLEANER_PATH_UNIT, self.row_cleaner)
        box.pack_start(self.row_cleaner, False, False, 0)

        note = Gtk.Label(xalign=0)
        note.set_markup("未安装的组件开关会变灰。")
        note.set_margin_start(14)
        box.pack_start(note, False, False, 8)
        self.add(box)

    def _flip_switch(self, switch, handler, active):
        # 不触发 handler 地拨开关（失败回弹、恢复同步用；_busy 守卫
        # 是第二道防线，即使 handler_block 失效也不会再次触发授权）。
        switch.handler_block_by_func(handler)
        try:
            switch.set_active(active)
        finally:
            switch.handler_unblock_by_func(handler)

    def on_service(self, switch, _param, unit, row):
        # 回弹/重入守卫：一次拨动只走一次授权流程。回弹本身也在守卫
        # 内完成，即使 handler_block 失效也不会再次触发授权。
        # 第 16 轮起只供希沃管家行用；触屏行走专用 on_touch。
        if self._busy:
            return
        want = switch.get_active()
        self._busy = True
        try:
            ok = set_service(unit, want, self)
            if not ok:
                self._flip_switch(switch, self.on_service, not want)
        finally:
            self._busy = False

    def on_touch(self, switch, _param, row):
        # 第 16 轮：触屏兜底开关专用流程。开：助手 on + 气泡；
        # 关：助手 off（disable --now + fork 10 秒等待者）+ 确认窗。
        # 确认窗结果：保留 → 写 keep 文件、开关保持关；恢复 → 写
        # restore 文件、轮询确认服务已启用后把开关翻回开；超时无
        # 点击 → 不写文件、等待者 10 秒到时自动恢复，同样轮询确认
        # 后翻回开。回弹/重入守卫与 on_service 同款。
        if self._busy:
            return
        want = switch.get_active()
        self._busy = True
        try:
            ok = set_touch_bypass(want, self)
            if not ok:
                self._flip_switch(switch, self.on_touch, not want)
                return
            if want:
                # 手动开启成功才弹通知（第 15 轮）。
                notify_touch_enabled()
                return
            # 关闭成功：助手里的等待者已在 10 秒倒计时，弹确认窗。
            outcome = confirm_touch_off(self)
            if outcome == "keep":
                write_touch_decision("keep")
                return
            if outcome == "restore":
                write_touch_decision("restore")
            # restore 或 timeout：等待者恢复（立即或 10 秒到时），
            # 轮询确认服务已启用后把开关翻回开。
            if wait_touch_enabled():
                self._flip_switch(switch, self.on_touch, True)
            else:
                msg = "触屏兜底未能自动恢复，请重新打开开关或检查服务状态。"
                dlg = Gtk.MessageDialog(
                    transient_for=self, modal=True,
                    message_type=Gtk.MessageType.WARNING,
                    buttons=Gtk.ButtonsType.OK,
                    text=msg)
                dlg.run()
                dlg.destroy()
        finally:
            self._busy = False

    def on_user_service(self, switch, _param, unit, row):
        # 与 on_service 同款回弹/重入守卫，走用户级单元流程（无 pkexec）。
        if self._busy:
            return
        want = switch.get_active()
        self._busy = True
        try:
            ok = set_user_service(unit, want, self)
            if not ok:
                switch.handler_block_by_func(self.on_user_service)
                try:
                    switch.set_active(not want)
                finally:
                    switch.handler_unblock_by_func(self.on_user_service)
        finally:
            self._busy = False

    def on_noauth_drives(self, switch, _param, row):
        # 与 on_service 同款回弹/重入守卫，走 pkexec 助手脚本流程。
        if self._busy:
            return
        want = switch.get_active()
        self._busy = True
        try:
            ok = set_noauth_drives(want, self)
            if not ok:
                switch.handler_block_by_func(self.on_noauth_drives)
                try:
                    switch.set_active(not want)
                finally:
                    switch.handler_unblock_by_func(self.on_noauth_drives)
        finally:
            self._busy = False


def main():
    win = Window()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
