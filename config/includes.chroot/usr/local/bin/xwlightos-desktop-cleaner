#!/usr/bin/python3
# XWLightOS desktop cleaner (user service).
#
# User instruction 2026-10-24: nothing except the user's own file
# operations may add content to the Desktop. Vendor apps (the Seewo
# whiteboard's .sh copies a .desktop onto ~/Desktop on every launch,
# installers seed skeleton shortcuts, ...) must not leave launchers
# behind. This daemon watches the Desktop directories and removes
# vendor launchers within seconds. Regular files and folders the user
# puts there are never touched.
#
# User mail 2026-10-28 item 4: the 2-second polling loop is replaced
# by event-driven triggering (xwlightos-desktop-cleaner.path watches
# the Desktop directories and starts this script with --once on every
# change, so there is no wakeup and no resident process between
# events). The loop is kept only for manual runs without --once.
#
# User mail 2026-10-28 (second reply): cleanup must ONLY affect Seewo.
# Precise match, verified from the vendor debs themselves (1555 hook
# audit, 2026-10-20): every Seewo desktop file uses the com.seewo.
# reverse-DNS prefix -- whiteboard com.seewo.easinote5, manager
# com.seewo.terminalmanager, video booth com.seewo.easicamera, class
# master com.seewo.easicare. So a file is a vendor file only if its
# name starts with com.seewo. (case-insensitive) and ends with
# .desktop. A plain "seewo" substring would also match a launcher the
# user made themselves, so it is deliberately NOT used: fail closed,
# never delete a file that is not provably vendor-dropped.
#
# Exception: the live-only "Install XWLightOS" launcher (it is the
# install entry point on the LiveCD; the installed-system cleanup
# removes it there, and this daemon only runs in live/installed user
# sessions where that file may legitimately exist pre-install).
import os
import sys
import time

KEEP = {"Install XWLightOS.desktop"}
POLL_SECONDS = 2


def is_vendor_desktop(name):
    # Seewo vendor files only: com.seewo.<app>.desktop (see header).
    lower = name.lower()
    return lower.startswith("com.seewo.") and lower.endswith(".desktop")


def desktop_dirs():
    home = os.path.expanduser("~")
    dirs = []
    xdg = os.environ.get("XDG_DESKTOP_DIR")
    if xdg:
        dirs.append(xdg)
    cfg = os.path.join(home, ".config", "user-dirs.dirs")
    if os.path.isfile(cfg):
        try:
            with open(cfg, encoding="utf-8", errors="ignore") as fh:
                for line in fh:
                    line = line.strip()
                    if line.startswith("XDG_DESKTOP_DIR="):
                        val = line.split("=", 1)[1].strip().strip('"')
                        dirs.append(val.replace("$HOME", home))
        except OSError:
            pass
    dirs += [os.path.join(home, "Desktop"), os.path.join(home, "桌面")]
    seen, out = set(), []
    for d in dirs:
        if d and d not in seen:
            seen.add(d)
            out.append(d)
    return out


def sweep():
    for d in desktop_dirs():
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for name in names:
            if not is_vendor_desktop(name) or name in KEEP:
                continue
            path = os.path.join(d, name)
            try:
                if os.path.isfile(path):
                    os.unlink(path)
            except OSError:
                pass


def main():
    if "--once" in sys.argv[1:]:
        sweep()
        return 0
    while True:
        sweep()
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    sys.exit(main())
