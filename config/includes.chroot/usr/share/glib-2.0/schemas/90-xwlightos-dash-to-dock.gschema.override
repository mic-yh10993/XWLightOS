# XWLightOS: force dash-to-dock defaults at the schema level.
#
# Debian's gnome-shell-extension-dashtodock 75-1 ships schema defaults
# intellihide=true and autohide=true (verified from the real .deb).
# The dconf system default (local.d/00-xwlightos-gnome) already says
# otherwise, but a fresh install still showed intelligent hiding ON,
# so the dconf layer alone is not a hard enough guarantee. This
# override rewrites the schema default itself (compiled by
# glib-compile-schemas in the 1700 hook): even if the dconf database
# is bypassed for any reason, the out-of-the-box behaviour is dock
# never hidden. User mail 2026-10-24 22:40 latest requirement ("force
# never hide, same as before") supersedes the 2026-10-24 19:43
# requirement ("resident normally, hidden only for fullscreen apps"):
# all three hiding switches are off, fullscreen apps do not hide it.
[org.gnome.shell.extensions.dash-to-dock]
intellihide=false
autohide=false
autohide-in-fullscreen=false
# 用户 2026-10-25 Build 37 真机反馈：全新 live 会话里三个开关全关、dock
# 还是会隐藏。根因是第四个键 dock-fixed（dock 是否固定常驻）从来没写过：
# 内存后端实测其 schema 默认值就是 false（GSETTINGS_BACKEND=memory get），
# 而 Dash to Dock 的偏好开关会连动它（智能隐藏关→dock-fixed=true，
# 开→false），只写三个开关永远够不着它。三个开关全关 + dock-fixed=false
# = dock 没固定，桌面上不显示。四个键必须一起写死，缺一不可。
dock-fixed=true
