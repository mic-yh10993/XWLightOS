# XWLightOS GNOME default applications (system-wide).
# Applied to every user via /etc/xdg; per-user overrides still win through
# ~/.config/mimeapps.list.  GNOME "默认应用程序" settings read these.
[Default Applications]
text/plain=org.gnome.TextEditor.desktop
text/markdown=org.gnome.TextEditor.desktop
text/x-log=org.gnome.TextEditor.desktop
application/json=org.gnome.TextEditor.desktop
application/x-shellscript=org.gnome.TextEditor.desktop
application/x-python=org.gnome.TextEditor.desktop
image/jpeg=org.gnome.eog.desktop
image/png=org.gnome.eog.desktop
image/gif=org.gnome.eog.desktop
image/bmp=org.gnome.eog.desktop
image/webp=org.gnome.eog.desktop
image/svg+xml=org.gnome.eog.desktop
image/tiff=org.gnome.eog.desktop
video/mp4=io.github.celluloid_player.Celluloid.desktop
video/x-matroska=io.github.celluloid_player.Celluloid.desktop
video/webm=io.github.celluloid_player.Celluloid.desktop
video/x-msvideo=io.github.celluloid_player.Celluloid.desktop
video/quicktime=io.github.celluloid_player.Celluloid.desktop
audio/mpeg=io.github.celluloid_player.Celluloid.desktop
audio/ogg=io.github.celluloid_player.Celluloid.desktop
audio/x-wav=io.github.celluloid_player.Celluloid.desktop
audio/flac=io.github.celluloid_player.Celluloid.desktop
application/pdf=firefox-esr.desktop
text/html=firefox-esr.desktop
application/xhtml+xml=firefox-esr.desktop
application/zip=org.gnome.FileRoller.desktop
application/x-zip=org.gnome.FileRoller.desktop
application/x-tar=org.gnome.FileRoller.desktop
application/x-compressed-tar=org.gnome.FileRoller.desktop
application/x-gzip=org.gnome.FileRoller.desktop
application/x-bzip2=org.gnome.FileRoller.desktop
application/x-xz=org.gnome.FileRoller.desktop
application/x-7z-compressed=org.gnome.FileRoller.desktop
application/x-rar=org.gnome.FileRoller.desktop
application/vnd.rar=org.gnome.FileRoller.desktop
application/x-iso9660-image=org.gnome.FileRoller.desktop
inode/directory=org.gnome.Nautilus.desktop
