# XWLightOS system-wide GTK2 theme: WhiteSur-Light.
# User report 2026-10-24: legacy apps must also use WhiteSur-Light,
# and all apps must not render black text on a black background.
# GTK2 reads this system file as a fallback for every user; the same
# values are mirrored per-user in /etc/skel/.gtkrc-2.0.
gtk-theme-name="WhiteSur-Light"
gtk-icon-theme-name="WhiteSur-light"
gtk-cursor-theme-name="WhiteSur-cursors"
gtk-font-name="Noto Sans CJK SC 11"
