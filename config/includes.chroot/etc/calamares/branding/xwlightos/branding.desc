---
componentName: xwlightos
welcomeStyleCalamares: false
welcomeExpandingLogo: false
windowExpanding: normal
windowSize: 1024px,650px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
    productName: XWLightOS
    shortProductName: XWLightOS
    version: "1.0"
    shortVersion: "1.0"
    versionedName: XWLightOS 1.0
    shortVersionedName: XWLightOS 1.0
    bootloaderEntryName: XWLightOS
    productUrl: https://github.com/SYSTEM-Intel-MIC/xwlightos
    supportUrl: https://github.com/SYSTEM-Intel-MIC/xwlightos/issues
    knownIssuesUrl: https://github.com/SYSTEM-Intel-MIC/xwlightos/issues
