/* XWLightOS Calamares light, translucent installer theme (round 15).
 * User 2026-11-14: the dark sidebar with black text was unreadable.
 * Light + slightly translucent, aligned with the WhiteSur-Light desktop
 * theme. QSS accepts rgba(); the branding.desc style keys do not. */
QWidget, QMainWindow, QDialog, QStackedWidget, QWizard, QWizardPage,
QScrollArea, QAbstractScrollArea, QFrame#centralWidget {
    background-color: rgba(245, 247, 250, 235);
    color: #202124;
    font-family: "Noto Sans CJK SC", "Noto Sans", sans-serif;
}
QFrame#sidebarApp, QWidget#sidebarApp {
    background-color: rgba(255, 255, 255, 230);
    border-right: 1px solid #c2d6ee;
}
QWidget#navigationApp {
    background-color: rgba(245, 247, 250, 235);
    border-top: 1px solid #c2d6ee;
}
QWidget#mainApp, QWidget#pages {
    background-color: rgba(245, 247, 250, 235);
}
QPushButton, QToolButton {
    background-color: #0b57d0;
    color: #ffffff;
    border: 1px solid #0b57d0;
    border-radius: 6px;
    padding: 7px 16px;
    min-width: 84px;
}
QPushButton:hover, QToolButton:hover { background-color: #2b7de9; }
QPushButton:pressed, QToolButton:pressed { background-color: #0842a0; }
QPushButton:disabled, QToolButton:disabled {
    background-color: #d3dae3;
    color: #7b8794;
    border-color: #c2ccd8;
}
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #ffffff;
    color: #202124;
    selection-background-color: #0b57d0;
    selection-color: #ffffff;
    border: 1px solid #8ab4f8;
    border-radius: 4px;
    padding: 4px;
}
QComboBox QAbstractItemView, QListView, QListWidget, QTreeView, QTableView,
QListView::item, QTreeView::item, QTableView::item {
    background-color: #ffffff;
    color: #202124;
    alternate-background-color: #f0f4f9;
    selection-background-color: #d3e3f2;
    selection-color: #174ea6;
    border: 1px solid #c2d6ee;
}
QHeaderView::section {
    background-color: #e8f0fe;
    color: #202124;
    border: 1px solid #c2d6ee;
    padding: 5px;
}
QCheckBox, QRadioButton {
    color: #202124;
    spacing: 6px;
    background: transparent;
}
QGroupBox, QTabWidget::pane, QFrame {
    background-color: rgba(245, 247, 250, 235);
    color: #202124;
    border-color: #c2d6ee;
}
QGroupBox::title { color: #0b57d0; }
QTabBar::tab {
    background-color: #e8f0fe;
    color: #3c4043;
    border: 1px solid #c2d6ee;
    padding: 7px 14px;
}
QTabBar::tab:selected { background-color: #d3e3f2; color: #174ea6; }
QProgressBar {
    background-color: #e8f0fe;
    color: #202124;
    border: 1px solid #c2d6ee;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk { background-color: #1b9be8; border-radius: 3px; }
QLabel { background: transparent; color: #202124; }
QLabel#productName, QLabel#versionLabel { color: #202124; }
QScrollBar:vertical, QScrollBar:horizontal { background: #f0f4f9; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #9db8d6;
    border-radius: 4px;
}
QToolTip, QMessageBox {
    background-color: #ffffff;
    color: #202124;
    border: 1px solid #8ab4f8;
}
