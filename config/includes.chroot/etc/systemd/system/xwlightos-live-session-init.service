[Unit]
Description=Initialize the XWLightOS Live graphical session user
Before=gdm.service
After=local-fs.target systemd-tmpfiles-setup.service
Wants=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/xwlightos-live-session-init
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
