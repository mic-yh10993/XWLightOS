polkit.addRule(function(action, subject) {
    // The Live session is disposable. Permit its dedicated user only for the
    // fixed-function DclawOS dispatcher; never grant a blanket pkexec bypass.
    if (subject.user == "user" &&
        action.id == "im.system-intel-mic.dclawos.privileged-action") {
        return polkit.Result.YES;
    }

    // The graphical session runs under GDM/GNOME with a conventional logind
    // seat. Permit only the Calamares-created sudo user to run this one
    // fixed-function
    // dispatcher.  The dispatcher has no arbitrary-command branch: it accepts
    // exactly suspend, poweroff, reboot, restore-only BSOD, or no-reboot update.
    // All other actions and users retain the policy defaults (auth_admin).
    if (subject.isInGroup("sudo") &&
        action.id == "im.system-intel-mic.dclawos.privileged-action") {
        return polkit.Result.YES;
    }
});
