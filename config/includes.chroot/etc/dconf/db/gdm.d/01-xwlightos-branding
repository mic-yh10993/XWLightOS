# XWLightOS login-screen (GDM greeter) branding. Compiled by `dconf update`
# (see the 1700 hook). Replaces the distribution logo on the greeter with the
# XWLightOS mark. The greeter background comes from the WhiteSur GDM theme
# (1560 hook, tweaks.sh -g equivalent): BigSur-like wallpaper baked into the
# gnome-shell gresource, not a neutral dark default.
[org/gnome/login-screen]
logo='/usr/share/xwlightos/branding/xwlightos-mark.svg'

# The greeter runs outside the user session, so the desktop
# cursor-theme default does not reach it: set it here explicitly, otherwise
# the login screen keeps the Adwaita pointer ("光标主题没完全用上" 的一项).
[org/gnome/desktop/interface]
cursor-theme='WhiteSur-cursors'
