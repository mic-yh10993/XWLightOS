# XWLightOS GNOME defaults: macOS-like WhiteSur theme, dock and favorites.
# Applied via `dconf update` in the 1700 hook.

[org/gnome/desktop/interface]
# 用户 2026-10-17 邮件指令：图标 WhiteSur-light、Shell WhiteSur-Light。
# 用户 2026-10-18 邮件指令：系统默认主题色为白色。color-scheme 决定
# libadwaita/GTK4 应用的浅色/深色外观，'prefer-light' 即默认白色。
# 用户 2026-10-24 邮件第 9 项：过时应用程序也用 WhiteSur-Light（此前给
# 老应用的 WhiteSur-Dark 已撤销）；第 11 项：所有应用黑字黑底看不见——
# 深色主题与 prefer-light 混用是黑底黑字的来源之一，全部统一为浅色。
color-scheme='prefer-light'
gtk-theme='WhiteSur-Light'
icon-theme='WhiteSur-light'
cursor-theme='WhiteSur-cursors'
font-name='Noto Sans CJK SC 11'
document-font-name='Noto Sans CJK SC 11'
monospace-font-name='Noto Sans Mono CJK SC 11'

[org/gnome/desktop/wm/preferences]
theme='WhiteSur-Light'
# 用户 2026-10-17 邮件指令：窗口按钮放右上角。
button-layout=':minimize,maximize,close'

[org/gnome/shell]
# chroot 构建无显示、无重启：扩展启用走系统级 dconf 默认（dconf update 编译
# 进 db），首次登录即生效，无需运行时 gnome-extensions enable。
# 用户 2026-10-24 邮件《很大问题》第 6 项：状态栏监控要 Debian 自带的那种
# 顶栏扩展（gnome-shell-extension-system-monitor，即 paradoxxxzero 顶栏扩展），
# 不是独立的系统监控程序。2026-10-23 曾移除它的旧决定已被用户新要求推翻，
# 此处重新启用；固定栏里系统监控程序的钉住同步取消（见 favorite-apps）。
# 注意：Debian 的 gnome-shell-extension-appindicator 装出来的 UUID 是
# ubuntu-appindicators@ubuntu.com，不是上游的 appindicatorsupport@rgcjonas.gmail.com，
# 写错会导致 1650 钩子校验失败、构建红灯（2026-10-24 实测）。
# 用户 2026-10-24 邮件第 4 项问“为什么多了 Ubuntu 的扩展”：这是 Debian
# 打包时起的名字——它就是上游 AppIndicator 扩展同一份代码的 Debian 版，
# 不是装了 Ubuntu 系统，也不是多余软件；它负责 QQ/微信/钉钉等应用的
# 顶栏托盘图标，关掉它这些应用的托盘图标就没了。扩展应用里显示的
# “Ubuntu AppIndicators”就是它，可在扩展应用里开关，但不建议删。
# 用户 2026-10-24 邮件第 6 项：要 Debian 13 Netinst 自带的那种状态栏
# 监控（顶栏显示 CPU/内存/网络等），不要独立的系统监控程序——重新启用
# Debian 官方打包的 paradoxxxzero 顶栏 system-monitor 扩展（bookworm 版
# 40-5，Shell 43 兼容），并把固定栏里那个系统监视器程序去掉钉住。
# 用户 2026-10-24 22:53 邮件：Shift 不能切换中英文是配置问题、
# 不是扩展问题，不装扩展也行——此前加的 kimpanel 输入法面板扩展已撤回
# （包清单与此处启用列表同步删除），输入法只靠 fcitx5 本体 + 环境变量。
enabled-extensions=['apps-menu@gnome-shell-extensions.gcampax.github.com', 'dash-to-dock@micxgx.gmail.com', 'ding@rastersoft.com', 'native-window-placement@gnome-shell-extensions.gcampax.github.com', 'places-menu@gnome-shell-extensions.gcampax.github.com', 'drive-menu@gnome-shell-extensions.gcampax.github.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'ubuntu-appindicators@ubuntu.com', 'system-monitor@paradoxxx.zero.gmail.com']
# 用户 2026-10-20 邮件指令：固定栏固定 7 个应用——希沃白板、希沃视频展台、
# 班级优化大师、ONLYOFFICE、钉钉、微信、QQ（按此顺序）。
# 用户 2026-10-20 邮件指令：dock 栏把"文件"和 Firefox 加回去，放最前面。
# .desktop 文件名均从厂商 deb 实包解包核验（非猜测）：
#  com.seewo.easinote5.desktop / com.seewo.easicamera.desktop /
#  com.seewo.easicare.desktop / onlyoffice-desktopeditors.desktop /
#  com.alibabainc.dingtalk.desktop / wechat.desktop / qq.desktop /
#  org.gnome.Nautilus.desktop（文件）/ firefox-esr.desktop。
# 注意：XWLightOS 已移除 AI 组件，旧的 AI 聊天/manager 固定项同步移除。
# 用户 2026-10-24 邮件第 6 项：固定栏里那个系统监视器程序用户说没用，
# 取消钉住（程序本身仍装着，顶栏扩展的菜单里也能打开它）。
favorite-apps=['org.gnome.Nautilus.desktop', 'firefox-esr.desktop', 'com.seewo.easinote5.desktop', 'com.seewo.easicamera.desktop', 'com.seewo.easicare.desktop', 'onlyoffice-desktopeditors.desktop', 'com.alibabainc.dingtalk.desktop', 'wechat.desktop', 'qq.desktop']

[org/gnome/shell/extensions/user-theme]
# 用户 2026-10-17 邮件指令：Shell 主题用 WhiteSur-Light。
name='WhiteSur-Light'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/xwlightos-aurora-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/xwlightos-aurora-wallpaper.png'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/xwlightos-aurora-wallpaper.png'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dash-max-icon-size=48
show-trash=false
show-mounts=false
running-indicator-style='DOTS'
# 用户 2026-10-23 邮件指令：希沃白板工具栏出现时不隐藏 dock，只有白板主窗口
# 全屏时才隐藏 dock。
# 根因：dash-to-dock 默认 autohide=true（dock 常年隐藏、悬停才出）且
# intellihide=true（FOCUS_APPLICATION_WINDOWS：被聚焦窗口占住 dock 区域就躲），
# 工具栏置顶/白板主窗口最大化都会把 dock 藏起来。
# 修法（只动判定逻辑，不碰工具栏守护）：dock 常驻显示，intellihide 也关掉，
# 只保留 autohide-in-fullscreen=true——GNOME 的全屏状态跟踪对 Qt 窗口同样有效，
# 白板主窗口真正全屏时 dock 自动隐藏，退出全屏即恢复；工具栏只是普通置顶小
# 窗口，不再触发任何隐藏。
# 2026-10-24 用户邮件第 5 项后澄清（19:37）：只在设置页关智能隐藏就正常，
# 其它开关不要动——故本节保持 Build 28 原样，不做额外改动。
# 用户 2026-10-24 邮件《很大问题》第 1 项：dash to dock 一装上智能隐藏
# 就是开着的，要求“强制写死关闭”。构建侧 dconf 早已写 intellihide=false
# 但真机仍开着，根因是 Debian 版 dash-to-dock 75-1 的 schema 默认值本身
# 就是 intellihide=true、autohide=true（实包 schema 核验）：只要系统 dconf
# 库有任何一环没生效，默认值就赢。只写 dconf 默认不够硬，因此另加一层
# gschema 覆盖（/usr/share/glib-2.0/schemas/90-xwlightos-dash-to-dock.gschema.override，
# 1700 钩子编译）：把 schema 默认本身改成与本节一致，dconf 库即使被绕过，
# 默认也是关闭的。两层都写死，缺一不可。
# 用户 2026-10-24 22:40 最新要求：dock 直接强制永不隐藏。
# 该要求取代 19:43 的“平时常驻、全屏应用才隐藏”：autohide-in-fullscreen
# 也关掉，三个开关全关；gschema 覆盖层同步改。
autohide=false
intellihide=false
autohide-in-fullscreen=false

# XWLightOS 已移除 AI 组件：旧的 Super+Shift+A 唤起 AI 聊天快捷键同步移除
#（其命令对应的二进制已不存在，留着是死快捷键）。
[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=@as []

# 用户 2026-10-24 指令：默认插入 U 盘自动挂载，并自动用文件管理器打开。
[org/gnome/desktop/media-handling]
automount=true
automount-open=true

# 用户 2026-10-24 指令：桌面保持干净——ding 不显示主目录/回收站等系统图标，
# 桌面只呈现用户自己放的文件/文件夹（应用快捷方式由桌面清理服务拦截）。
[org/gnome/shell/extensions/ding]
show-home=false
show-trash=false
show-volumes=false
