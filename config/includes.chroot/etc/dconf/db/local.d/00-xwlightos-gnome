# XWLightOS GNOME defaults: macOS-like WhiteSur theme, dock and favorites.
# Applied via `dconf update` in the 1700 hook.

[org/gnome/desktop/interface]
# 用户 2026-10-17 邮件指令：图标 WhiteSur-light、Shell WhiteSur-Light。
# 用户 2026-10-18 邮件指令：系统默认主题色为白色。color-scheme 决定
# libadwaita/GTK4 应用的浅色/深色外观，'prefer-light' 即默认白色。
# 用户 2026-10-24 邮件第 9 项：过时应用程序也用 WhiteSur-Light（此前给
# 老应用的 WhiteSur-Dark 已撤销）；第 11 项：所有应用黑字黑底看不见——
# 深色主题与 prefer-light 混用是黑底黑字的来源之一，全部统一为浅色。
color-scheme='prefer-light'
gtk-theme='WhiteSur-Light'
icon-theme='WhiteSur-light'
cursor-theme='WhiteSur-cursors'
font-name='Noto Sans CJK SC 11'
document-font-name='Noto Sans CJK SC 11'
monospace-font-name='Noto Sans Mono CJK SC 11'
# 用户 2026-10-25 13:53 新要求：默认关掉热区功能（此前 schema 默认 true，
# 即鼠标顶到左上角就进活动视图）。与 gschema 覆盖层同步写死。
enable-hot-corners=false

[org/gnome/desktop/wm/preferences]
theme='WhiteSur-Light'
# 用户 2026-10-17 邮件指令：窗口按钮放右上角。
button-layout=':minimize,maximize,close'

[org/gnome/shell]
# chroot 构建无显示、无重启：扩展启用走系统级 dconf 默认（dconf update 编译
# 进 db），首次登录即生效，无需运行时 gnome-extensions enable。
# 用户 2026-10-24 邮件《很大问题》第 6 项：状态栏监控要 Debian 自带的那种
# 顶栏扩展（gnome-shell-extension-system-monitor，即 paradoxxxzero 顶栏扩展），
# 不是独立的系统监控程序。2026-10-23 曾移除它的旧决定已被用户新要求推翻，
# 此处重新启用；固定栏里系统监控程序的钉住同步取消（见 favorite-apps）。
# 注意：Debian 的 gnome-shell-extension-appindicator 装出来的 UUID 是
# ubuntu-appindicators@ubuntu.com，不是上游的 appindicatorsupport@rgcjonas.gmail.com，
# 写错会导致 1650 钩子校验失败、构建红灯（2026-10-24 实测）。
# 用户 2026-10-24 邮件第 4 项问“为什么多了 Ubuntu 的扩展”：这是 Debian
# 打包时起的名字——它就是上游 AppIndicator 扩展同一份代码的 Debian 版，
# 不是装了 Ubuntu 系统，也不是多余软件；它负责 QQ/微信/钉钉等应用的
# 顶栏托盘图标，关掉它这些应用的托盘图标就没了。扩展应用里显示的
# “Ubuntu AppIndicators”就是它，可在扩展应用里开关，但不建议删。
# 用户 2026-10-24 邮件第 6 项：要 Debian 13 Netinst 自带的那种状态栏
# 监控（顶栏显示 CPU/内存/网络等），不要独立的系统监控程序——重新启用
# Debian 官方打包的 paradoxxxzero 顶栏 system-monitor 扩展（bookworm 版
# 40-5，Shell 43 兼容），并把固定栏里那个系统监视器程序去掉钉住。
# 用户 2026-10-24 23:31 邮件：输入法面板扩展也要（此前 22:53 撤回，
# 现按最新要求重新加回启用；Shift 切换配置本身的修法保留）。
enabled-extensions=['apps-menu@gnome-shell-extensions.gcampax.github.com', 'dash-to-dock@micxgx.gmail.com', 'ding@rastersoft.com', 'native-window-placement@gnome-shell-extensions.gcampax.github.com', 'places-menu@gnome-shell-extensions.gcampax.github.com', 'drive-menu@gnome-shell-extensions.gcampax.github.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'ubuntu-appindicators@ubuntu.com', 'system-monitor@paradoxxx.zero.gmail.com', 'kimpanel@kde.org']
# 用户 2026-10-20 邮件指令：固定栏固定 7 个应用——希沃白板、希沃视频展台、
# 班级优化大师、ONLYOFFICE、钉钉、微信、QQ（按此顺序）。
# 用户 2026-10-20 邮件指令：dock 栏把"文件"和 Firefox 加回去，放最前面。
# .desktop 文件名均从厂商 deb 实包解包核验（非猜测）：
#  com.seewo.easinote5.desktop / com.seewo.easicamera.desktop /
#  com.seewo.easicare.desktop / onlyoffice-desktopeditors.desktop /
#  com.alibabainc.dingtalk.desktop / wechat.desktop / qq.desktop /
#  org.gnome.Nautilus.desktop（文件）/ firefox-esr.desktop。
# 注意：XWLightOS 已移除 AI 组件，旧的 AI 聊天/manager 固定项同步移除。
# 用户 2026-10-24 邮件第 6 项：固定栏里那个系统监视器程序用户说没用，
# 取消钉住（程序本身仍装着，顶栏扩展的菜单里也能打开它）。
favorite-apps=['org.gnome.Nautilus.desktop', 'firefox-esr.desktop', 'com.seewo.easinote5.desktop', 'com.seewo.easicamera.desktop', 'com.seewo.easicare.desktop', 'onlyoffice-desktopeditors.desktop', 'com.alibabainc.dingtalk.desktop', 'wechat.desktop', 'qq.desktop']

[org/gnome/shell/extensions/user-theme]
# 用户 2026-10-17 邮件指令：Shell 主题用 WhiteSur-Light。
name='WhiteSur-Light'

# 用户 2026-10-28 邮件第 5 项：顶栏系统监视器扩展默认显示数字，不要图形。
# 上游 schema（org.gnome.shell.extensions.system-monitor）的 *-style 三档：
# digit（数字）/ graph（图形）/ both（两者），上游默认全是 graph。
# 此处把默认显示的 CPU/内存/网络连同 swap/磁盘一并钉为 digit；
# 只改全新登录/未改过该项的用户默认值，用户自己在扩展设置里改过的
# 值仍优先于系统默认（不会把用户手动选回的图形再强行改掉）。
[org/gnome/shell/extensions/system-monitor]
cpu-style='digit'
memory-style='digit'
swap-style='digit'
net-style='digit'
disk-style='digit'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/xwlightos-aurora-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/xwlightos-aurora-wallpaper.png'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/xwlightos-aurora-wallpaper.png'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dash-max-icon-size=48
show-trash=false
show-mounts=false
running-indicator-style='DOTS'
# 用户 2026-10-23 邮件指令：希沃白板工具栏出现时不隐藏 dock，只有白板主窗口
# 全屏时才隐藏 dock。
# 根因：dash-to-dock 默认 autohide=true（dock 常年隐藏、悬停才出）且
# intellihide=true（FOCUS_APPLICATION_WINDOWS：被聚焦窗口占住 dock 区域就躲），
# 工具栏置顶/白板主窗口最大化都会把 dock 藏起来。
# 修法（只动判定逻辑，不碰工具栏守护）：dock 常驻显示，intellihide 也关掉，
# 只保留 autohide-in-fullscreen=true——GNOME 的全屏状态跟踪对 Qt 窗口同样有效，
# 白板主窗口真正全屏时 dock 自动隐藏，退出全屏即恢复；工具栏只是普通置顶小
# 窗口，不再触发任何隐藏。
# 2026-10-24 用户邮件第 5 项后澄清（19:37）：只在设置页关智能隐藏就正常，
# 其它开关不要动——故本节保持 Build 28 原样，不做额外改动。
# 用户 2026-10-24 邮件《很大问题》第 1 项：dash to dock 一装上智能隐藏
# 就是开着的，要求“强制写死关闭”。构建侧 dconf 早已写 intellihide=false
# 但真机仍开着，根因是 Debian 版 dash-to-dock 75-1 的 schema 默认值本身
# 就是 intellihide=true、autohide=true（实包 schema 核验）：只要系统 dconf
# 库有任何一环没生效，默认值就赢。只写 dconf 默认不够硬，因此另加一层
# gschema 覆盖（/usr/share/glib-2.0/schemas/90-xwlightos-dash-to-dock.gschema.override，
# 1700 钩子编译）：把 schema 默认本身改成与本节一致，dconf 库即使被绕过，
# 默认也是关闭的。两层都写死，缺一不可。
# 用户 2026-10-24 22:40 最新要求：dock 直接强制永不隐藏。
# 该要求取代 19:43 的“平时常驻、全屏应用才隐藏”：autohide-in-fullscreen
# 也关掉，三个开关全关；gschema 覆盖层同步改。
autohide=false
intellihide=false
autohide-in-fullscreen=false
# 用户 2026-10-25 Build 37 真机反馈：三个开关全关仍隐藏，缺的是 dock-fixed
#（schema 默认 false，偏好开关连动它）。与 gschema 覆盖层同步写死。
dock-fixed=true

# XWLightOS 已移除 AI 组件：旧的 Super+Shift+A 唤起 AI 聊天快捷键同步移除
#（其命令对应的二进制已不存在，留着是死快捷键）。
[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=@as []

# 用户 2026-10-24 指令：默认插入 U 盘自动挂载，并自动用文件管理器打开。
[org/gnome/desktop/media-handling]
automount=true
automount-open=true

# 用户 2026-10-24 指令：桌面保持干净——ding 不显示主目录/回收站等系统图标，
# 桌面只呈现用户自己放的文件/文件夹（应用快捷方式由桌面清理服务拦截）。
[org/gnome/shell/extensions/ding]
show-home=false
show-trash=false
show-volumes=false

# 屏幕键盘：GNOME 自带屏幕键盘，默认开启（2026-10-31 第三轮定版）。
# 历史三段：2026-10-25 曾把此键写 true（此前仓库没写过、GNOME 上游
# 默认 false）；Build 58 改用 Onboard 时曾改 false 防两个键盘同弹；
# 本轮用户裁决弃用 Onboard（“更多bug”），回到自带键盘，恢复 true。
# 自带键盘此前输不了中文的根因已在用户已安装系统上活体钉死：它只
# 经 IBus 通道组字，而镜像当时根本没装 IBus。本轮 IBus 双栈已成套
# 进构建（包清单 ibus/ibus-libpinyin、etc/dconf/db/ibus.d 引擎
# 预置、本文件输入源播种），此键只负责让键盘在文本框聚焦时弹出，
# 组字靠 IBus 那条链。机制与 dock/主题同：系统级 dconf 默认（1700
# 钩子 dconf update 编译），用户自己改过的值仍优先于系统默认。
# 注意：本节只管桌面会话，不动 gdm.d 登录页——登录页键盘不在本次要求内。
[org/gnome/desktop/a11y/applications]
screen-keyboard-enabled=true

# 输入反馈音默认打开（用户 2026-10-31：调音量时的提示音等基本没声）。
# org.gnome.desktop.sound 的上游默认（gsettings-desktop-schemas 43.0
# 的 schema 原文）：event-sounds=true（用户事件音，总开关本来就是开的）、
# input-feedback-sounds=false（"Whether to play sounds on input
# events"——输入事件反馈音，出厂关）。音量调节反馈音属输入反馈类，
# 总开关开着也轮不到它响。用户明确要这个提示音，故出厂钉为 true；
# 与之独立的另一半病灶是 WirePlumber 新设备默认音量 0.40（实际增益
# 约 6%），修法在 wireplumber 的 drop-in 配置里，两处缺一不可。
[org/gnome/desktop/sound]
input-feedback-sounds=true

# Celluloid 默认播放器（用户 2026-10-31：VLC 换 Celluloid）：经它
# 自己的 GSettings 设置键 mpv-options 给 mpv 传 hwdec=auto-safe——
# mpv 官方的“安全硬解”模式（白名单编解码/后端，找不到 VA-API 驱动
# 自动回落软解）。这是应用自带的支持机制，不是改它的内部文件；
# 镜像里的 VA-API 驱动（intel-media-va-driver/i965-va-driver）让
# Intel 核显上硬解真正可用，服务低配硬件的播放流畅度。
[io/github/celluloid_player/Celluloid]
mpv-options='hwdec=auto-safe'

# 用户 2026-10-25 邮件第 1 项后半（屏幕键盘输不了中文）与第 6 项的
# GTK 应用侧前提：GNOME 会话里 GTK 应用的输入法模块不只看环境变量，
# gnome-settings-daemon 的 xsettings 插件还会向 GTK 发布 Gtk/IMModule。
# 一旦该通道被别的框架值占住，GTK 应用（屏幕键盘最常落点的文本框
# 绝大多数是 GTK 应用）就绕开 fcitx，表现为物理键盘能输中文、屏幕
# 键盘/部分 GTK 应用不能。此处把该通道也钉死为 fcitx，与
# /etc/environment 的三变量同一值、互为备份；不是本次两项的已证实
# 唯一根因（图标切换能用说明多数应用已走 fcitx），而是补齐 GTK 一侧
# 的送达链路，防该通道在个别机器上成为漏网项。
[org/gnome/settings-daemon/plugins/xsettings]
overrides={'Gtk/IMModule':<'fcitx'>}

# GNOME 输入源播种（2026-10-31 第三轮改版；本段历史结论部分作废）。
# 历史：2026-10-25 用户反馈输入法 Shift 不能切换，是多了个英语
# （美国）输入法抢了 fcitx5 的位置。仓库核查确认当时构建从未写过
# org.gnome.desktop.input-sources，首次登录的输入源就是 GNOME 上游
# schema 默认的 xkb us；当时的修法是把列表清空（@a(ss) []，此处
# dconf 默认 + gschema override 两层），让 GNOME 侧不剩任何源、
# 输入只走 fcitx5 的 IM 模块通道。那次还有一条不变量至今成立：
# 千万别删 fcitx5 内部的 keyboard-us，那是 Shift 切换的英文一侧；
# 且 GNOME 输入源只支持 xkb 与 ibus 两类（gsettings describe
# 原文），fcitx5 本来就写不进这个列表、不依赖它。
# 本轮为屏幕键盘引进 IBus 双栈后，空表不再成立：屏幕键盘要切到
# 拼音，前提是 ('ibus','libpinyin') 在这个列表里登记着（用户
# 2026-10-31 活体实验实证：源不在列表里，屏幕键盘无拼音可切；
# 源登记了但守护没起，输出还会掉进死通道）。故播种恰好两项，
# current=0：登录后的当前源仍是第一项 xkb cn（与实验前用户机器
# 上的实际状态 [('xkb','cn')] 一致），实体键盘与应用继续经
# fcitx5 的 IM 模块通道（/etc/environment 三变量 + 本文件
# xsettings 钉死 + 自启动 + skel 配置）工作；当年要清掉的
# xkb us 不在播种内，不会回潮。用户切到第二项时，Shell 的输入
# 通道交给已预置 libpinyin 的 IBus 守护，专供屏幕键盘组字。
# 诚实边界：切到拼音源后，实体键盘经 fcitx5 的 Shift 切中英
# 是否受扰，是运行时行为、构建证不了，列为设备验证项；若设备
# 证实受扰，再另行定夺（回退空表或只留单项），不在本轮预设。
# 第二层在 90-xwlightos-input-sources.gschema.override，写同一
# 播种（防 dconf 库被绕过时 schema 默认漂移回上游 xkb us）。
[org/gnome/desktop/input-sources]
current=0
sources=[('xkb', 'cn'), ('ibus', 'libpinyin')]
