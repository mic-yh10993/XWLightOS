#!/bin/bash
set -eu

# Fail the image build early if the installed target cannot perform a real
# Calamares installation. unpackfs executes unsquashfs inside the target.
command -v unsquashfs >/dev/null 2>&1 || {
    echo "DclawOS: squashfs-tools/unsquashfs is required in the target" >&2
    exit 1
}
command -v rsync >/dev/null 2>&1 || {
    echo "DclawOS: rsync is required by Calamares unpackfs" >&2
    exit 1
}
find /usr/lib -path '*/calamares/modules/partition/libcalamares_viewmodule_partition.so' -print -quit | grep -q . || {
    echo "DclawOS: Calamares partition module is missing" >&2
    exit 1
}
find /usr/lib -path '*/calamares/modules/mount/module.desc' -print -quit | grep -q . || {
    echo "DclawOS: Calamares mount module is missing" >&2
    exit 1
}

# calamares-settings-debian supplies the tested Debian module sequence. Keep
# that sequence but replace its selected branding component with DclawOS.
SETTINGS=/etc/calamares/settings.conf
if [ ! -f "$SETTINGS" ]; then
    echo "DclawOS: Calamares settings are missing" >&2
    exit 1
fi
if grep -qE '^[[:space:]]*branding:' "$SETTINGS"; then
    sed -i -E 's|^([[:space:]]*branding:)[[:space:]]*.*$|\1 dclawos|' "$SETTINGS"
else
    echo "DclawOS: Calamares settings have no branding selector" >&2
    exit 1
fi

# Calamares requires an explicit slideshow key. The DclawOS source tree ships
# its own show.qml; never copy Debian's placeholder slideshow over it.
BRANDING=/etc/calamares/branding/dclawos
# Keep the GRUB theme self-contained both in the Live image and in the target
# root copied by unpackfs.
install -Dm644 /usr/share/dclawos/branding/dclawos-aurora-wallpaper.png \
    /boot/grub/themes/dclawos/dclawos-aurora-wallpaper.png
install -Dm644 /boot/grub/themes/dclawos/theme.txt \
    /usr/share/dclawos/branding/theme.txt
chmod 0755 /usr/local/libexec/dclawos-target-postinstall.sh

# DclawOS installs fully offline: unpackfs copies the live filesystem to the
# target, so no apt operations are needed or permitted during installation.
# The `packages` module is the only apt-capable Calamares module (verified
# against calamares 3.2.61 sources: every other module, including
# `bootloader`, only runs local tools); removing it from the sequence plus
# the empty operations.conf below guarantees the installer never touches
# the network. GRUB reaches the target through unpackfs (grub-pc-bin /
# grub-efi-amd64-bin are in the package list) and the `bootloader` module
# installs it to disk with in-target grub-install/grub-mkconfig, no apt.
if grep -qE '^[[:space:]]*-[[:space:]]*packages[[:space:]]*$' "$SETTINGS"; then
    sed -i -E '/^[[:space:]]*-[[:space:]]*packages[[:space:]]*$/d' "$SETTINGS"
    echo "DclawOS: removed packages module from Calamares sequence (offline install)"
fi
# Safety net: even if the module is re-added, its config installs nothing.
mkdir -p /etc/calamares/modules
cat > /etc/calamares/modules/packages.conf <<'EOF'
---
backend: apt
operations: []
EOF

# Register a target-chroot shellprocess after Calamares creates the selected
# user. This must not follow `packages`, because the Live temporary `user`
# account is present then while the account selected in Calamares is created
# by the later `users` module.
SETTINGS=/etc/calamares/settings.conf
if ! grep -q '^-[[:space:]]*id:[[:space:]]*dclawos-postinstall' "$SETTINGS" 2>/dev/null; then
    cat >> "$SETTINGS" <<'EOF'

instances:
- id: dclawos-postinstall
  module: shellprocess
  config: dclawos-postinstall.conf
EOF
fi
if ! grep -q '^[[:space:]]*-[[:space:]]*shellprocess@dclawos-postinstall[[:space:]]*$' "$SETTINGS"; then
    awk '
        /^[[:space:]]*-[[:space:]]*exec:[[:space:]]*$/ { in_exec=1 }
        !done && in_exec && /^[[:space:]]*-[[:space:]]*users[[:space:]]*$/ {
            indent=$0; sub(/[^[:space:]].*/, "", indent)
            print $0
            print indent "- shellprocess@dclawos-postinstall"
            done=1
            next
        }
        { print }
    ' "$SETTINGS" > "$SETTINGS.dclawos" && mv "$SETTINGS.dclawos" "$SETTINGS"
fi

if [ ! -f "$BRANDING/show.qml" ]; then
    echo "DclawOS: custom Calamares show.qml is missing" >&2
    exit 1
fi
if ! grep -q '^slideshow:' "$BRANDING/branding.desc"; then
    printf '\nslideshow: "show.qml"\nslideshowAPI: 2\n' >> "$BRANDING/branding.desc"
fi

# GNOME desktop wallpaper: use the DclawOS aurora artwork as the default.
# (WhiteSur is a widget/icon theme and ships no wallpaper of its own.)
[ -s /usr/share/dclawos/branding/dclawos-aurora-wallpaper.png ] || {
    echo "DclawOS: aurora wallpaper is missing" >&2
    exit 1
}
install -Dm644 /usr/share/dclawos/branding/dclawos-aurora-wallpaper.png \
    /usr/share/backgrounds/dclawos-aurora-wallpaper.png

# Make the Live session and Calamares use Simplified Chinese by default.
if [ -f /etc/locale.gen ]; then
    sed -i -E 's/^#[[:space:]]*(zh_CN.UTF-8[[:space:]]+UTF-8)/\1/' /etc/locale.gen
    locale-gen zh_CN.UTF-8
fi
cat > /etc/default/locale <<'EOF'
LANG=zh_CN.UTF-8
LANGUAGE=zh_CN:zh
LC_MESSAGES=zh_CN.UTF-8
EOF

# Remove Debian's generic installer launcher from the application menu. The
# DclawOS-branded Calamares entry remains the only graphical installer entry.
for dir in /usr/share/applications /etc/xdg/autostart /etc/skel/Desktop; do
    [ -d "$dir" ] || continue
    # This hook runs under dash, whose `read` lacks -d.  The direct glob is
    # POSIX-safe and still covers all package-provided desktop filenames.
    for entry in "$dir"/*.desktop; do
        [ -f "$entry" ] || continue
        if grep -qiE '(^Name(\[[^]]+\])?=.*(Install Debian|Debian Installer|Install System|安装系统))|debian-installer-launcher|debian-installer.desktop|install-system.desktop' "$entry" 2>/dev/null; then
            rm -f "$entry"
        fi
    done
done
chmod 0755 '/etc/skel/Desktop/Install DclawOS.desktop' 2>/dev/null || true
chmod 0755 /usr/share/applications/dclawos-installer.desktop 2>/dev/null || true

# Keep human-readable system identity coherent outside the desktop itself.
printf 'DclawOS 1.0 \\n \\l\n' > /etc/issue
printf 'DclawOS 1.0\n' > /etc/issue.net

# GRUB themes are read from /etc/default/grub by grub-mkconfig.  Only append
# the DclawOS theme assignment after both theme assets have been staged.  This
# prevents a missing file from becoming a boot-time GRUB theme warning.
# Offline-install guarantee (user 2026-10-18: installer must not download
# GRUB): the Calamares `bootloader` module runs grub-install/grub-mkconfig
# INSIDE the target and never calls apt (source-verified). It can only work
# offline if the GRUB platform modules are really in the image (they ride to
# the target via unpackfs). Fail the build if a package-list change ever
# drops them, instead of shipping an installer whose bootloader step breaks.
for grub_platform_dir in /usr/lib/grub/i386-pc /usr/lib/grub/x86_64-efi; do
    [ -f "$grub_platform_dir/modinfo.sh" ] || {
        echo "DclawOS: GRUB platform modules missing: $grub_platform_dir (offline bootloader install would fail)" >&2
        exit 1
    }
done
if [ -f /etc/default/grub ] && \
   [ -s /boot/grub/themes/dclawos/theme.txt ] && \
   [ -s /boot/grub/themes/dclawos/dclawos-aurora-wallpaper.png ]; then
    cat >> /etc/default/grub <<'EOF'

# DclawOS 1.0 bootloader identity and presentation.
GRUB_DISTRIBUTOR="DclawOS"
GRUB_THEME="/boot/grub/themes/dclawos/theme.txt"
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=6
GRUB_DEFAULT=0
GRUB_DISABLE_OS_PROBER=false
EOF
elif [ -f /etc/default/grub ]; then
    # Never leave a stale DclawOS theme reference if staging failed.
    sed -i '\|^GRUB_THEME="/boot/grub/themes/dclawos/theme.txt"$|d' /etc/default/grub
fi

