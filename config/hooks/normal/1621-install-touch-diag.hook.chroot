#!/bin/sh
# 触屏诊断脚本构建期门禁（Build 40 触屏诊断起）。
#
# 第 17 轮（用户 2026-11-15：触屏诊断全屏窗口删了，暂时没用了，
# 可以存日志）：开机自动弹最大化终端的入口已删除——
# /etc/xdg/autostart/xwlightos-touch-diag.desktop 与终端启动器
# /usr/local/sbin/xwlightos-touch-diag-launch.sh（gnome-terminal
# --maximize）均已从仓库移除，登录后不再自动弹诊断窗口。
# 诊断脚本本体 /usr/local/sbin/xwlightos-touch-diag.sh 保留：
# 它能把证据存进 /tmp/xwlightos-touch-evidence/，需要时手动跑即可。
#
# 本钩子只做构建期门禁，文件本体在 includes.chroot 里版本管理。
set -eu

[ -x /usr/local/sbin/xwlightos-touch-diag.sh ] || {
    echo 'XWLightOS: xwlightos-touch-diag.sh missing or not executable' >&2
    exit 1
}
bash -n /usr/local/sbin/xwlightos-touch-diag.sh || {
    echo 'XWLightOS: xwlightos-touch-diag.sh syntax check failed' >&2
    exit 1
}
# 反向门禁：自启动入口与最大化终端启动器必须不存在（用户 2026-11-15
# 已令删除），任一残留都让构建失败，避免登录后又自动弹诊断窗口。
[ ! -e /etc/xdg/autostart/xwlightos-touch-diag.desktop ] || {
    echo 'XWLightOS: xwlightos-touch-diag.desktop still present (user 2026-11-15: auto-popup diagnosis window removed)' >&2
    exit 1
}
[ ! -e /usr/local/sbin/xwlightos-touch-diag-launch.sh ] || {
    echo 'XWLightOS: xwlightos-touch-diag-launch.sh still present (user 2026-11-15: auto-popup diagnosis window removed)' >&2
    exit 1
}

echo 'XWLightOS: touchscreen diagnosis (1621) staged'
