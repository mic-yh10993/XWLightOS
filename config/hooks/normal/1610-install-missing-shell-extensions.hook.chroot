#!/bin/sh
# 用户 2026-10-19 邮件「回复: XWLightOS 进一步检测修改」指令：
# 1. GNOME 顶栏加系统监控扩展（右上角显示 CPU/内存占用）。
# 2. 补上之前要求但从未真正进构建的扩展。
#
# 核验结论（2026-10-19，全部一手实证；用户要求今日再确认一次）：
# - 亲手下载 gnome-shell-extensions_43.1-1_all.deb（Debian bookworm 官方，
#   2026-10-19 从 ftp.debian.org 取），dpkg-deb 列出全部 11 个扩展：
#   apps-menu、auto-move-windows、drive-menu、launch-new-instance、
#   native-window-placement、places-menu、screenshot-window-sizer、
#   user-theme、window-list、windowsNavigator、workspace-indicator。
#   确认无 system-monitor、无 light-style——官方包确实没有，前次结论成立。
# - system-monitor 上游（gcampax/gnome-shell-extensions 仓库）早已不再维护
#   该扩展，官方包从此无货；只能用 paradoxxxzero 第三方维护版
#   （master 已验证支持 shell-version 43，UUID system-monitor@paradoxxx.zero.gmail.com，
#   pin 2025-03-11 commit 2552673aa56532045bb9eedd3eb29cd88faa7d6f）。
# - dconf 的 enabled-extensions 里 light-style 早就列着，但文件从未安装，
#   GNOME 会静默跳过（= 配了个寂寞）。
# - system-monitor：gcampax 原版太老不支持 GNOME 43；用 paradoxxxzero 维护版
#   （master 已验证支持 shell-version 43，UUID system-monitor@paradoxxx.zero.gmail.com）。
# - light-style：2026-10-19 彻底移除（#61/#62 构建失败根因）。GNOME 官方
#   gnome-shell-extensions 仓库 43.1 标签里根本没有 light-style（2023 年才
#   加入，最早在 45.0 标签，实测确认）；且 light-style 的 extension.js 依赖
#   Main.sessionMode.colorScheme API，该 API 是 GNOME 45 才加入的，43/44 里
#   不存在——即使拿到 45.0 的版本，在 GNOME 43 上也从原理上跑不起来，enable
#   即报错。它的功能（强制浅色主题）已由 dconf color-scheme='prefer-light'
#   实现（00-xwlightos-gnome），扩展本身冗余，不装了。
set -eu

export DEBIAN_FRONTEND=noninteractive

# system-monitor 需要 libgtop 的 GObject introspection 数据才能读 CPU/内存。
apt-get update
apt-get install -y --no-install-recommends gir1.2-gtop-2.0

WORKDIR="$(mktemp -d /tmp/xwlightos-extensions-XXXXXX)"
trap 'rm -rf "$WORKDIR"' EXIT
cd "$WORKDIR"

# ---- 1. system-monitor (paradoxxxzero) ----
# pin: 2025-03-11 master，实测 metadata.json shell-version 含 43。
SM_COMMIT="2552673aa56532045bb9eedd3eb29cd88faa7d6f"
SM_UUID="system-monitor@paradoxxx.zero.gmail.com"
echo "XWLightOS: installing system-monitor $SM_COMMIT"
curl -fsSL "https://github.com/paradoxxxzero/gnome-shell-system-monitor-applet/archive/${SM_COMMIT}.tar.gz" \
    -o system-monitor.tar.gz
tar xzf system-monitor.tar.gz
SM_SRC="gnome-shell-system-monitor-applet-${SM_COMMIT}/${SM_UUID}"
[ -d "$SM_SRC" ] || {
    echo "XWLightOS: system-monitor source dir missing after extract" >&2
    exit 1
}
mkdir -p "/usr/share/gnome-shell/extensions/${SM_UUID}"
cp -r "${SM_SRC}/"* "/usr/share/gnome-shell/extensions/${SM_UUID}/"
# 编译 gsettings schema（扩展自带 schemas/ 目录时必需）。
if [ -d "/usr/share/gnome-shell/extensions/${SM_UUID}/schemas" ]; then
    glib-compile-schemas "/usr/share/gnome-shell/extensions/${SM_UUID}/schemas/"
fi

# ---- 构建期门禁 ----
# system-monitor 的 metadata 必须声明支持 GNOME 43，否则装了也白装。
grep -q '"43"' "/usr/share/gnome-shell/extensions/${SM_UUID}/metadata.json" || {
    echo "XWLightOS: system-monitor metadata does not list GNOME 43" >&2
    exit 1
}

echo "XWLightOS: system-monitor installed"
