#!/bin/sh
# Seewo component wiring: vendor services inventory + manager enable.
#
# User reports 2026-10-24:
#  * the Seewo manager (terminalmanager) backend service "seems not
#    started" - the edu hook only enabled it when the unit was found at
#    one exact path (/usr/lib/systemd/system) and stayed silent
#    otherwise; on merged-usr the file can equally live under
#    /lib/systemd/system. Here we enumerate every vendor unit, record
#    the inventory in /etc/xwlightos/seewo-vendor-units.txt and enable
#    every non-updater unit from whichever path exists, warning loudly
#    in the build log when the manager service is absent entirely.
#  * user instruction 2026-10-25 09:01: the Seewo sidebar and the Udi
#    components are TEMPORARILY REMOVED from the build (sidebar never
#    opens, no log on the real machine). The 1550 edu hook skips those
#    vendor packages, so nothing sidebar/Udi is wired here any more;
#    restoring them is a revert of the removal commits. The manager
#    backend is a different component and is NOT removed.
set -eu

INV=/etc/xwlightos/seewo-vendor-units.txt
install -d -m 0755 /etc/xwlightos
: > "$INV"
# 用户 2026-10-24 邮件《很大问题》第 2 项：希沃管家后端开机自启失效。
# 厂商 unit 有一行 EnvironmentFile=/etc/environment（无 '-' 前缀），
# systemd 对缺失的 EnvironmentFile 是硬失败（服务根本起不来），而镜像
# 此前根本没有 /etc/environment 这个文件。这里没有它就直接让构建失败，
# 不能再把一个注定起不来的后端送到用户机器上。
[ -f /etc/environment ] || {
    echo "XWLightOS: /etc/environment missing, com.seewo.terminalmanager.service can never start (EnvironmentFile without dash prefix)" >&2
    exit 1
}
for base in /usr/lib/systemd/system /lib/systemd/system; do
    [ -d "$base" ] || continue
    for unit in "$base"/*seewo* "$base"/*cvte* "$base"/*maxhub* \
                "$base"/*udi* "$base"/*Udi* "$base"/*easi*; do
        [ -f "$unit" ] || continue
        name="$(basename "$unit")"
        grep -qx "$name" "$INV" || echo "$name" >> "$INV"
    done
done
echo "XWLightOS: Seewo vendor units found:"
cat "$INV" || true

mkdir -p /etc/systemd/system/multi-user.target.wants
while IFS= read -r name; do
    [ -n "$name" ] || continue
    case "$name" in
        *.service) ;;
        *) continue ;;
    esac
    case "$name" in
        *update*|*upgrade*|*ota*) echo "XWLightOS: not enabling updater unit $name"; continue ;;
    esac
    src=""
    for base in /usr/lib/systemd/system /lib/systemd/system; do
        [ -f "$base/$name" ] && { src="$base/$name"; break; }
    done
    [ -n "$src" ] || continue
    ln -sfn "$src" "/etc/systemd/system/multi-user.target.wants/$name"
    echo "XWLightOS: enabled vendor service $name"
done < "$INV"

if grep -qx 'com.seewo.terminalmanager.service' "$INV"; then
    echo "XWLightOS: Seewo manager backend unit present and enabled"
    # 启用必须落到 multi-user.target.wants 才算数：前面循环里 unit
    # 若因路径问题被跳过，这里要大声失败，不能静默放行一个“看起来
    # 启用了、实际开机不起”的后端（用户 2026-10-24 第 2 项）。
    [ -L /etc/systemd/system/multi-user.target.wants/com.seewo.terminalmanager.service ] || {
        echo "XWLightOS: terminalmanager unit found but not linked into multi-user.target.wants" >&2
        exit 1
    }
else
    echo "XWLightOS: WARNING: com.seewo.terminalmanager.service NOT found in image (manager backend cannot start)" >&2
fi
# 用户 2026-10-25 09:01 指令：希沃侧边栏与 Udi 组件暂时删除。
# 1550 钩子已跳过这两个厂商包的安装；这里不再接线、也不再为
# 不存在的侧边栏建自启入口。恢复时 revert 删除提交即可。
chmod 755 /usr/local/bin/xwlightos-settings \
    /usr/local/bin/xwlightos-desktop-cleaner 2>/dev/null || true

# Desktop cleaner user service: enable for every user session.
if [ -d /etc/systemd/user ]; then
    mkdir -p /etc/systemd/user/default.target.wants
    ln -sfn ../xwlightos-desktop-cleaner.service \
        /etc/systemd/user/default.target.wants/xwlightos-desktop-cleaner.service
    echo "XWLightOS: desktop cleaner user service enabled"
fi

# Settings tool entry must be executable/valid.
[ -x /usr/local/bin/xwlightos-settings ] || {
    echo "XWLightOS: xwlightos-settings missing/not executable" >&2
    exit 1
}
echo "XWLightOS: Seewo component wiring complete"
