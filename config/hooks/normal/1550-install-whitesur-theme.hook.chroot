#!/bin/sh
# Install the pinned WhiteSur macOS-like theme (GTK + icons + cursors) into
# the live chroot. All versions are pinned; the hook fails the image build if
# any of them cannot be installed or verified.
#
# NOTE: WhiteSur's install.sh cannot run in a chroot: its lib-core.sh calls
# `logname`, which fails without a login session and aborts the script via
# `set -Eeo pipefail`. The GTK theme is therefore installed from the
# project's own pre-built release tarballs (same content install.sh would
# generate), extracted directly to /usr/share/themes.
set -eu

GTK_VER="2026-09-10"
ICON_VER="2026-09-10"
CURSOR_REV="e190baf618ed95ee217d2fd45589bd309b37672b"

WORKDIR="$(mktemp -d /tmp/xwlightos-whitesur-XXXXXX)"
trap 'rm -rf "$WORKDIR"' EXIT
cd "$WORKDIR"

# xz is needed to unpack the pre-built .tar.xz theme archives.
apt-get update
apt-get install -y --no-install-recommends xz-utils

echo "XWLightOS: installing WhiteSur GTK theme $GTK_VER (pre-built release)"
curl -fsSL "https://github.com/vinceliuice/WhiteSur-gtk-theme/archive/refs/tags/${GTK_VER}.tar.gz" -o whitesur-gtk.tar.gz
tar xzf whitesur-gtk.tar.gz
# Extract the standard Dark/Light variants from the pre-built release.
for variant in Dark Light; do
    tar -xJf "WhiteSur-gtk-theme-${GTK_VER}/release/WhiteSur-${variant}.tar.xz" \
        -C /usr/share/themes
done
[ -d /usr/share/themes/WhiteSur-Dark/gnome-shell ] || {
    echo "XWLightOS: WhiteSur-Dark gnome-shell theme missing after install" >&2
    exit 1
}
# dconf 的 gtk-theme='WhiteSur-Light' 供 GTK3 应用使用：gtk-3.0 目录必须真实存在，
# 否则这些应用回退 Adwaita = "主题没用上"。用户 2026-10-24 邮件第 9 项：
# 过时应用程序也用 WhiteSur-Light，因此 Light 的 gtk-3.0 同样要断言。
[ -d /usr/share/themes/WhiteSur-Light/gtk-3.0 ] || {
    echo "XWLightOS: WhiteSur-Light gtk-3.0 theme missing after install" >&2
    exit 1
}
# 用户 2026-10-25 邮件第 1 项（所有程序还是黑色文字+背景）：Build 33 的
# GTK2/Qt5 修法（/etc/gtk-2.0/gtkrc + skel .gtkrc-2.0 + QT_QPA_PLATFORMTHEME=gtk2）
# 全都指向 WhiteSur-Light，但此前从未断言过 WhiteSur-Light 真有 gtk-2.0
# 样式——预编译发布包只带 gtk-3.0/gtk-4.0/gnome-shell 等目录、没有 gtk-2.0，
# 所以 GTK2 应用与 Qt5 gtk2 平台主题实际落在无控回落调色板上，而不是浅色。
# 兜底文件随镜像树自带（includes.chroot/usr/share/themes/WhiteSur-Light/
# gtk-2.0/gtkrc，纯颜色、无外部引擎依赖）：发布包若自带 gtk-2.0，解包会
# 覆盖它；若没有，它就是 GTK2/Qt5 通道的浅色保证。此处断言解包后该文件
# 必须存在，缺了就构建失败、不得静默发一个 GTK2 通道是断的镜像。
[ -f /usr/share/themes/WhiteSur-Light/gtk-2.0/gtkrc ] || {
    echo "XWLightOS: WhiteSur-Light gtk-2.0 gtkrc missing after install (GTK2 apps and Qt5 gtk2 platform theme would fall back to an uncontrolled palette)" >&2
    exit 1
}
# Build 56 教训：用户会话的 Shell 主题是 WhiteSur-Light（user-theme），
# 它的 gnome-shell.css 必须真实存在，否则会话回退到 gresource 默认样式表。
[ -f /usr/share/themes/WhiteSur-Light/gnome-shell/gnome-shell.css ] || {
    echo "XWLightOS: WhiteSur-Light gnome-shell.css missing after install (user-theme would have no stylesheet)" >&2
    exit 1
}
[ -d /usr/share/themes/WhiteSur-Light/gtk-4.0 ] || {
    echo "XWLightOS: WhiteSur-Light gtk-4.0 theme missing after install" >&2
    exit 1
}
# libadwaita/GTK4 应用（GNOME 48 的"文件"/Nautilus 等）不读 dconf 的 gtk-theme，
# 只加载 ~/.config/gtk-4.0/gtk.css。这是上游 install.sh -l/--libadwaita 的
# chroot 等效做法：把 WhiteSur-Light（配合用户"默认白色"指令）的 gtk-4.0
# 主题装进 /etc/skel，live 用户（1700 钩子从 skel 复制家目录）与安装后的
# 新用户都能继承。没有这一步，GTK4 应用会渲染成原生 Adwaita浅色，
# 用户观感就是"主题没用上"（用户 2026-10-18 真机反馈）。
# Build 72 根因修正（用户 2026-11-10 真机：文件还是白按钮）：
# 此前直接 cp 预编译包的 gtk-4.0/ 目录，但该目录的 gtk.css 只有一行
# @import url("resource:///org/gnome/theme/gtk.css");，真正的样式表
# （约 9000 行）在同目录的 gtk.gresource 里；该 @import 只有在主题按
# 名字加载时才能解析（GTK3 靠 dconf 按名字加载，gresource 随之注册，
# 所以终端有红黄绿），拷到 ~/.config/gtk-4.0/ 当用户覆盖层加载时 GTK
# 不会为该目录注册 gresource，@import 解析失败，样式等于零，文件
# 仍是 Adwaita。文件本身是到了 live 用户家目录的，错的是内容。
# 修正：从 gresource 里抽出真正的 gtk.css / gtk-dark.css 与 assets/、
# windows-assets/（抽出的 CSS 经核实 0 处 resource:// 引用，全部 url()
# 均为相对路径，自包含成立），再写进 /etc/skel/.config/gtk-4.0/。
# 这等价于上游 config_gtk4 的 SCSS 编译产物，只是不引 sassc。
command -v gresource >/dev/null 2>&1 || {
    echo 'XWLightOS: gresource missing (cannot extract the WhiteSur gtk-4.0 stylesheet from gtk.gresource)' >&2
    exit 1
}
_WS_GTK4=/usr/share/themes/WhiteSur-Light/gtk-4.0
_WS_SKEL=/etc/skel/.config/gtk-4.0
install -d "$_WS_SKEL"
gresource extract "$_WS_GTK4/gtk.gresource" /org/gnome/theme/gtk.css > "$_WS_SKEL/gtk.css" || {
    echo 'XWLightOS: failed to extract WhiteSur gtk-4.0 gtk.css from gtk.gresource' >&2
    exit 1
}
gresource extract "$_WS_GTK4/gtk.gresource" /org/gnome/theme/gtk-dark.css > "$_WS_SKEL/gtk-dark.css" || {
    echo 'XWLightOS: failed to extract WhiteSur gtk-4.0 gtk-dark.css from gtk.gresource' >&2
    exit 1
}
# 注意：不用管道接 while（管道会让循环跑在子 shell，里面的 exit 1
# 杀不死钩子）；先把清单落盘，再重定向读入，失败即整钩子红灯。
gresource list "$_WS_GTK4/gtk.gresource" > "$WORKDIR/gtk4-resources.txt" || {
    echo 'XWLightOS: cannot list WhiteSur gtk-4.0 gresource contents' >&2
    exit 1
}
grep '^/org/gnome/theme/\(assets\|windows-assets\)/' "$WORKDIR/gtk4-resources.txt" > "$WORKDIR/gtk4-assets.txt" || {
    echo 'XWLightOS: no assets/windows-assets in WhiteSur gtk-4.0 gresource' >&2
    exit 1
}
while IFS= read -r _res; do
    _rel=${_res#/org/gnome/theme/}
    install -d "$_WS_SKEL/$(dirname "$_rel")"
    gresource extract "$_WS_GTK4/gtk.gresource" "$_res" > "$_WS_SKEL/$_rel" || {
        echo "XWLightOS: failed to extract WhiteSur gtk-4.0 asset $_rel from gtk.gresource" >&2
        exit 1
    }
done < "$WORKDIR/gtk4-assets.txt"
# 门禁：skel 里的必须是真实样式表（不是那行 @import 存根），且按钮图片资产齐全。
grep -q '@import url("resource:///org/gnome/theme/gtk.css");' "$_WS_SKEL/gtk.css" && {
    echo 'XWLightOS: skel gtk-4.0 gtk.css is still the @import stub (libadwaita apps would stay Adwaita)' >&2
    exit 1
}
grep -q 'headerbar windowcontrols button.close' "$_WS_SKEL/gtk.css" || {
    echo 'XWLightOS: skel gtk-4.0 gtk.css lost the windowcontrols rules (traffic-light buttons would not render)' >&2
    exit 1
}
[ -s "$_WS_SKEL/gtk-dark.css" ] || {
    echo 'XWLightOS: skel gtk-4.0 gtk-dark.css missing after extraction' >&2
    exit 1
}
[ -s "$_WS_SKEL/windows-assets/titlebutton-close.png" ] || {
    echo 'XWLightOS: skel gtk-4.0 windows-assets missing after extraction (traffic-light buttons would have no images)' >&2
    exit 1
}
[ -s "$_WS_SKEL/assets/combobox-arrow.png" ] || {
    echo 'XWLightOS: skel gtk-4.0 assets missing after extraction' >&2
    exit 1
}
unset _WS_GTK4 _WS_SKEL _res _rel

echo "XWLightOS: installing WhiteSur icon theme $ICON_VER"
curl -fsSL "https://github.com/vinceliuice/WhiteSur-icon-theme/archive/refs/tags/${ICON_VER}.tar.gz" -o whitesur-icons.tar.gz
tar xzf whitesur-icons.tar.gz
cd "WhiteSur-icon-theme-${ICON_VER}"
./install.sh --dest /usr/share/icons 1>/tmp/xwlightos-whitesur-icons.log 2>&1 || {
    tail -30 /tmp/xwlightos-whitesur-icons.log >&2
    echo "XWLightOS: WhiteSur icon theme install failed" >&2
    exit 1
}
cd "$WORKDIR"
[ -d /usr/share/icons/WhiteSur ] || {
    echo "XWLightOS: WhiteSur icon directory missing after install" >&2
    exit 1
}

echo "XWLightOS: installing WhiteSur cursors $CURSOR_REV"
curl -fsSL "https://github.com/vinceliuice/WhiteSur-cursors/archive/${CURSOR_REV}.tar.gz" -o whitesur-cursors.tar.gz
tar xzf whitesur-cursors.tar.gz
cd "WhiteSur-cursors-${CURSOR_REV}"
./install.sh 1>/tmp/xwlightos-whitesur-cursors.log 2>&1 || {
    tail -30 /tmp/xwlightos-whitesur-cursors.log >&2
    echo "XWLightOS: WhiteSur cursors install failed" >&2
    exit 1
}
cd "$WORKDIR"
[ -d /usr/share/icons/WhiteSur-cursors ] || {
    echo "XWLightOS: WhiteSur-cursors directory missing after install" >&2
    exit 1
}

# X11 系统默认光标（之前漏了 = "光标主题没完全用上" 的一项）：
# dconf 的 cursor-theme 只覆盖 GNOME 会话内的 GTK 应用；X11 根窗口、
# GDM 登录页、会话启动瞬间的指针走 Xcursor 的
# /usr/share/icons/default/index.theme，默认是 Adwaita 黑指针。
# 这里写真实文件（不用 update-alternatives 软链接）：软链接指向
# WhiteSur-cursors 自带的 index.theme，其内容是主题元数据、不含字面
# 'WhiteSur-cursors'，构建校验 grep 会扑空；真实文件的
# Inherits=WhiteSur-cursors 既满足校验口径，Xcursor 也照样加载。
CURSOR_DEFAULT_FILE=/usr/share/icons/default/index.theme
if [ -d /usr/share/icons/WhiteSur-cursors ]; then
    mkdir -p /usr/share/icons/default
    # 清掉 update-alternatives 可能留下的软链接，避免残留干扰
    rm -f "$CURSOR_DEFAULT_FILE"
    printf '[Icon Theme]\nInherits=WhiteSur-cursors\n' > "$CURSOR_DEFAULT_FILE"
fi
grep -q 'WhiteSur-cursors' "$CURSOR_DEFAULT_FILE" || {
    echo "XWLightOS: X11 default cursor is not WhiteSur-cursors (root window / GDM would stay Adwaita)" >&2
    exit 1
}

# Refresh icon caches so GNOME picks the theme up immediately.
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/WhiteSur >/dev/null 2>&1 || true
fi


# --- 程序栏黑底黑字修复（用户 2026-10-24 真机反馈第 9 项）---
# WhiteSur 的 gnome-shell.css 在 GNOME 43 上 app-grid/文件夹弹窗的背景与
# 图目标签颜色对比不足（深色背景叠深色标签 = 看不见；第 14 轮：48 下
# 继续保留该覆盖，视觉效果待真机验证）。在主题 CSS 末尾
# 追加 XWLightOS 对比度覆盖（标记 XWLightOS-APPGRID-CONTRAST），后加载者
# 优先，保证程序栏与文件夹弹窗内文字与背景强对比。
for _variant in Light Dark; do
    _css="/usr/share/themes/WhiteSur-${_variant}/gnome-shell/gnome-shell.css"
    [ -f "$_css" ] || continue
    if [ "$_variant" = "Light" ]; then
        cat >> "$_css" <<'EOF'

/* XWLightOS-APPGRID-CONTRAST (user report 2026-10-24: app grid black-on-black;
   extended 2026-10-25: Build 37 live photo still shows the MAIN grid dark-on-dark) */
.app-folder-dialog { background-color: #f4f4f8; color: #23232d; }
.app-folder-dialog .overview-icon StLabel { color: #23232d; text-shadow: none; }
/* The main grid backdrop stays dark (dimmed wallpaper/theme overlay), so its
   labels must be light — the old rule forced ALL grid labels dark, which is
   only right inside the light folder dialog. .app-well-app scopes to the main
   grid and cannot leak into folder dialogs (different ancestor). */
.app-well-app .overview-icon StLabel,
.search-section-content .overview-icon StLabel { color: #f2f2f7; text-shadow: 0 1px 3px rgba(0,0,0,0.6); }
EOF
    else
        cat >> "$_css" <<'EOF'

/* XWLightOS-APPGRID-CONTRAST (user report 2026-10-24: app grid black-on-black) */
.app-folder-dialog { background-color: #17171f; color: #f2f2f7; }
.app-folder-dialog .overview-icon StLabel,
.app-well-app .overview-icon StLabel,
.icon-grid .overview-icon StLabel,
.search-section-content .overview-icon StLabel { color: #f2f2f7; text-shadow: none; }
EOF
    fi
    grep -q 'XWLightOS-APPGRID-CONTRAST' "$_css" || {
        echo "XWLightOS: app-grid contrast override missing in $_css" >&2
        exit 1
    }
done
unset _variant _css

echo "XWLightOS: WhiteSur theme installation complete"
