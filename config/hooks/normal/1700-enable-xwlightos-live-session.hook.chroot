#!/bin/sh
set -eu

# The Live session user is created HERE, at build time, so it is guaranteed
# to exist before GDM starts. (Build 50 proved boot-time-only creation
# unreliable: its QEMU frames showed the GDM username prompt, i.e. no user
# existed when the greeter loaded, even though the oneshot service was
# enabled and ordered Before=gdm.service. The boot-time script stays as an
# idempotent repair net, not the primary creation path.)
if ! id user >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash --user-group user
fi
# Empty password, never locked: GDM autologins as this user via pam_permit
# (see /etc/gdm3/daemon.conf), and the live text console needs no password
# either (standard live-CD behavior). Do NOT `passwd --lock` here: a locked
# account risks the account stack refusing the autologin session.
passwd -d user
# The live session is disposable: the live user escalates to root without a
# password (see /etc/sudoers.d/xwlightos-live), so it belongs to the sudo
# group like on any conventional live CD. The installed system never
# inherits this: Calamares deletes the live account and its sudoers file.
for group in audio video plugdev netdev render input sudo; do
    if getent group "$group" >/dev/null 2>&1; then
        usermod --append --groups "$group" user
    fi
done
if [ -d /etc/skel ]; then
    cp -a /etc/skel/. /home/user/ 2>/dev/null || true
fi
chown -R user:user /home/user
# sudo ignores sudoers.d files that are not mode 0440, and git cannot store
# that mode, so fix it here at build time and syntax-check the rule: a
# broken sudoers file would silently disable live privilege escalation.
if [ -f /etc/sudoers.d/xwlightos-live ]; then
    chmod 0440 /etc/sudoers.d/xwlightos-live
    visudo -c -f /etc/sudoers.d/xwlightos-live || {
        echo 'XWLightOS: live sudoers syntax check failed' >&2
        exit 1
    }
fi
# Tell GDM/AccountsService exactly which session to start for the autologin
# (X11 is forced for VM/guest compatibility, matching custom.conf).
install -d -m 0755 /var/lib/AccountsService/users
# 账户图标（2026-10-25 08:29 用户反馈第 8 项）：此前 AccountsService 用户
# 文件里根本没有 Icon 项，用户无头像时 GNOME/ GDM 只能显示通用头像或
# 回落的系统标识。把品牌头像写进 AccountsService 的图标槽位，设置
# “用户”页、登录页、系统菜单里的账户图标统一为 XWLightOS 品牌标识
# （头像文件是仓库已有纯 Logo SVG 的渲染图，见
# /usr/share/xwlightos/branding/xwlightos-avatar.png，不是新画的图）。
install -d -m 0755 /var/lib/AccountsService/icons
[ -s /usr/share/xwlightos/branding/xwlightos-avatar.png ] || {
    echo 'XWLightOS: brand avatar PNG is missing (account icon would fall back)' >&2
    exit 1
}
install -Dm644 /usr/share/xwlightos/branding/xwlightos-avatar.png \
    /var/lib/AccountsService/icons/user
cat > /var/lib/AccountsService/users/user <<'EOF'
[User]
Language=
XSession=gnome-xorg
SystemAccount=false
Icon=/var/lib/AccountsService/icons/user
EOF
install -d -m 0755 /etc/xwlightos
printf '%s\n' user > /etc/xwlightos/session-user

# GDM owns the only graphical session path. The services are enabled
# explicitly because live-build does not always preserve preset state.
if command -v systemctl >/dev/null 2>&1; then
    systemctl enable xwlightos-live-session-init.service >/dev/null 2>&1 || true
    systemctl enable gdm.service >/dev/null 2>&1 || true
    # XWLightOS ships no AI components: no firstboot AI setup, no AI gateways.
    # Only the live session and GDM are enabled here.
fi

# Apply the XWLightOS GNOME defaults (WhiteSur theme, dock, extensions).
if command -v dconf >/dev/null 2>&1; then
    dconf update || {
        echo 'XWLightOS: dconf update failed' >&2
        exit 1
    }
fi

# Compile the GSettings schema overrides (dash-to-dock defaults are forced
# at the schema level, see 90-xwlightos-dash-to-dock.gschema.override:
# Debian's dashtodock 75-1 schema defaults to intellihide=true, and the
# dconf layer alone proved not hard enough on real hardware). Without
# this step the override file is inert text and fresh installs would
# still open with intelligent hiding on.
if command -v glib-compile-schemas >/dev/null 2>&1; then
    glib-compile-schemas /usr/share/glib-2.0/schemas || {
        echo 'XWLightOS: glib-compile-schemas failed' >&2
        exit 1
    }
else
    echo 'XWLightOS: glib-compile-schemas missing, schema overrides would not apply' >&2
    exit 1
fi
[ -f /usr/share/glib-2.0/schemas/gschemas.compiled ] || {
    echo 'XWLightOS: compiled GSettings schemas missing after glib-compile-schemas' >&2
    exit 1
}
grep -q '^intellihide=false$' /usr/share/glib-2.0/schemas/90-xwlightos-dash-to-dock.gschema.override || {
    echo 'XWLightOS: dash-to-dock schema override does not force intellihide off' >&2
    exit 1
}
# 输入源覆盖（用户 2026-10-25 11:41 反馈：移除多余的英语（美国）源）：
# 与 dock 覆盖同款构建期文本检查，文件丢了或被改回 xkb us 时构建即红灯。
grep -q '^sources=\[\]$' /usr/share/glib-2.0/schemas/90-xwlightos-input-sources.gschema.override || {
    echo 'XWLightOS: input-sources schema override does not clear the redundant English (US) source' >&2
    exit 1
}

# Brand-icon delivery for the Settings About panel (user 2026-10-25:
# About icon still shows the vendor logo). Build 36 already carries the
# main layer (LOGO=xwlightos-logo in both os-release files, plus the
# brand SVG in hicolor/scalable/apps under both the LOGO name and the
# generic distributor-logo name), but two delivery links were never
# closed, so that layer alone does not guarantee the panel finds it:
#  (1) the session's active icon theme is WhiteSur-light, not hicolor.
#      Nothing in the tree ever checked WhiteSur-light's Inherits chain,
#      so relying on "hicolor is the fallback" is an assumption, not a
#      verified link. Copy the brand SVG into the active themes'
#      scalable/apps directory when that directory exists, so a lookup
#      in the active theme itself succeeds without any fallback. The
#      distributor-logo copy overwrites a theme placeholder on purpose:
#      distributor-logo is meant to be the distro's own logo, and a
#      theme placeholder found first would otherwise win over hicolor.
#  (2) icon-theme.cache: hicolor ships a cache file from its package,
#      and the 1550 hook only ever refreshed WhiteSur's cache, never
#      hicolor's. Icons added to hicolor via includes.chroot after the
#      package's cache was built are invisible to a cache-driven lookup
#      until the cache is regenerated, so refresh hicolor (and the
#      active themes) here, after every icon file is in place. This
#      hook runs before the squashfs is built, so the refreshed cache
#      is what ships in the live image; the target-side mirror lives in
#      xwlightos-target-postinstall.sh, which re-runs the same refresh
#      after Calamares unpackfs.
for _theme in WhiteSur-light WhiteSur; do
    _appdir="/usr/share/icons/$_theme/scalable/apps"
    if [ -d "$_appdir" ]; then
        for _icon in xwlightos-logo distributor-logo; do
            if [ -s "/usr/share/icons/hicolor/scalable/apps/$_icon.svg" ]; then
                cp -a "/usr/share/icons/hicolor/scalable/apps/$_icon.svg" "$_appdir/$_icon.svg"
            fi
        done
    fi
done
unset _theme _appdir _icon
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    for _dir in /usr/share/icons/hicolor /usr/share/icons/WhiteSur-light /usr/share/icons/WhiteSur; do
        if [ -d "$_dir" ]; then
            gtk-update-icon-cache -f "$_dir" >/dev/null 2>&1 || {
                echo "XWLightOS: gtk-update-icon-cache failed for $_dir (About brand icon would be invisible to cache-driven lookup)" >&2
                exit 1
            }
        fi
    done
    unset _dir
    [ -f /usr/share/icons/hicolor/icon-theme.cache ] || {
        echo 'XWLightOS: hicolor icon-theme.cache missing after refresh' >&2
        exit 1
    }
fi
if command -v gtk4-update-icon-cache >/dev/null 2>&1; then
    for _dir in /usr/share/icons/hicolor /usr/share/icons/WhiteSur-light /usr/share/icons/WhiteSur; do
        if [ -d "$_dir" ]; then
            gtk4-update-icon-cache -f "$_dir" >/dev/null 2>&1 || true
        fi
    done
    unset _dir
fi

# live-build can install the generic live-config systemd backend independently
# of the explicit package list. Its oneshot service runs Before=basic.target,
# yet XWLightOS initializes its Live user and graphical session through the
# native services above. Mask it in the finished Live root so it cannot block
# the graphical target during DHCP, locale or generic profile processing.
install -d -m 0755 /etc/systemd/system
ln -sfn /dev/null /etc/systemd/system/live-config.service
if [ -e /etc/init.d/lightdm ] || [ -e /usr/sbin/lightdm ]; then
    echo 'XWLightOS: LightDM is not permitted; use gdm.service' >&2
    exit 1
fi
# GDM must actually be installed; without it there is no graphical login.
if [ ! -e /usr/sbin/gdm3 ]; then
    echo 'XWLightOS: gdm3 is missing; the GNOME session cannot start' >&2
    exit 1
fi
