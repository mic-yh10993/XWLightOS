#!/bin/sh
# Install XWLightOS education software from vendor .deb packages.
#
# Vendor packages are proprietary and sourced directly from the WinduxEdu
# repository (SYSTEM-Intel-MIC/WinduxEdu, edu-software/ directory) at the
# exact pinned versions recorded in DEB-INVENTORY.tsv. No Wine is used;
# all packages are native Linux .debs installed directly.
#
# The .debs are fetched from the WinduxEdu GitHub repo during build
# (split volumes, reassembled and SHA256-verified). If the fetch fails,
# this hook warns and continues so the base system can still build.
set -eu

WINDXUEDU_REPO="https://github.com/SYSTEM-Intel-MIC/WinduxEdu"
EDU_DIR=/opt/xwlightos/edu-packages
INVENTORY_URL="$WINDXUEDU_REPO/raw/main/edu-software/DEB-INVENTORY.tsv"

export DEBIAN_FRONTEND=noninteractive

# Hold kernel metapackages so the chroot and binary stages agree on
# exactly one kernel.
apt-mark hold linux-image-amd64 linux-headers-amd64

# DingTalk (native Linux build) bundles a PulseAudio client that links
# against libpulse-mainloop-glib explicitly; libpulse0 alone does not
# pull that split library in, so DingTalk died at load time with
# "libpulse-mainloop-glib.so.0: cannot open shared object file".
apt-get update
apt-get install -y --no-install-recommends libpulse-mainloop-glib0

mkdir -p "$EDU_DIR"

# Fetch DEB-INVENTORY.tsv to get the pinned file list and SHA256.
echo "XWLightOS: fetching education software inventory from WinduxEdu"
if ! curl -fsSL -o "$EDU_DIR/DEB-INVENTORY.tsv" "$INVENTORY_URL"; then
    echo "XWLightOS: WARNING: cannot fetch DEB-INVENTORY.tsv, skipping edu-software (base build continues)" >&2
    exit 0
fi

# Download and reassemble each .deb from split volumes.
# Format of DEB-INVENTORY.tsv: classification<TAB>file<TAB>Package<TAB>Version<TAB>Architecture<TAB>Size<TAB>SHA256
fetch_ok=1
grep -v '^#' "$EDU_DIR/DEB-INVENTORY.tsv" | while IFS="$(printf '\t')" read -r classification file package version arch size sha256; do
    [ -n "$file" ] || continue
    # 用户 2026-10-25 09:01 指令：暂时删除希沃侧边栏与 Udi 组件
    # （侧边栏打不开、真机上无日志）。这两个厂商包本次既不下载
    # 也不安装；恢复时删掉下面这段跳过即可（git 历史里留着完整接线）。
    # 管家后端不在此列：它与 udi 是两个不同组件，仍需正常安装自启。
    case "$package" in
        com.seewo.easisidebar|*easisidebar*|udi-hotspot-service)
            echo "XWLightOS: skipping removed component $package (user 2026-10-25 instruction)" >&2
            continue ;;
    esac
    echo "XWLightOS: fetching $package $version"
    dest="$EDU_DIR/$(basename "$file")"
    vol=0
    rm -f "$dest"
    while true; do
        vol_name="$(printf '%s.%03d' "$file" "$vol")"
        # URL-encode via python3 for Chinese characters in filenames
        enc_name="$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$vol_name")"
        vol_url="$WINDXUEDU_REPO/raw/main/edu-software/$enc_name"
        if ! curl -fsSL -o "$EDU_DIR/vol.tmp" "$vol_url" 2>/dev/null; then
            if [ "$vol" -eq 0 ]; then
                echo "XWLightOS: WARNING: cannot fetch $vol_name, skipping $package" >&2
                break
            fi
            break
        fi
        cat "$EDU_DIR/vol.tmp" >> "$dest"
        rm -f "$EDU_DIR/vol.tmp"
        vol=$((vol + 1))
    done
    if [ -f "$dest" ]; then
        actual="$(sha256sum "$dest" | cut -d' ' -f1)"
        if [ "$actual" != "$sha256" ]; then
            echo "XWLightOS: WARNING: SHA256 mismatch for $package, skipping" >&2
            rm -f "$dest"
        else
            echo "XWLightOS: verified $package $version"
        fi
    fi
done
rm -f "$EDU_DIR/vol.tmp"

if ! ls "$EDU_DIR"/*.deb >/dev/null 2>&1; then
    echo "XWLightOS: WARNING: no edu-software .debs fetched, skipping (base build continues)" >&2
    exit 0
fi

# Force HOME=/root for vendor postinsts.
mkdir -p /etc/dpkg/pre-inst.d
cat > /etc/dpkg/pre-inst.d/set-home <<'EOF'
#!/bin/sh
export HOME=/root
EOF
chmod +x /etc/dpkg/pre-inst.d/set-home

for deb in "$EDU_DIR"/*.deb; do
    [ -f "$deb" ] || continue
    package_name="$(dpkg-deb -f "$deb" Package 2>/dev/null || echo "unknown")"
    # 第二道防线：即使某版清单漏网，删除的组件也不得装进镜像。
    case "$package_name" in
        com.seewo.easisidebar|*easisidebar*|udi-hotspot-service)
            echo "XWLightOS: skipping removed component $package_name (user 2026-10-25 instruction)" >&2
            continue ;;
    esac

    # Trixie rebase (round 14): the vendor DEBs were built against
    # Bookworm-era library names. Trixie renamed them in the 64-bit time_t
    # transition (same SONAMEs, new package names), and dropped
    # libappindicator3-1 entirely (replaced by libayatana-appindicator3-1,
    # which ships the same libappindicator3.so.1 symlink). Rewrite the
    # Depends before handing the package to apt, or apt refuses the
    # install as unsatisfiable. The SHA256 check above already verified
    # each download; repacking after verification is safe. Packages with
    # no old names in Depends (DingTalk, easicare, the easiminiapps) skip
    # this branch untouched.
    if dpkg-deb -f "$deb" Depends 2>/dev/null | grep -Eq '\blibgtk-3-0\b|\blibatk1\.0-0\b|\blibasound2\b|\blibatspi2\.0-0\b|\blibappindicator3-1\b'; then
        repack_dir="$(mktemp -d)"
        dpkg-deb -R "$deb" "$repack_dir"
        sed -i \
            -e 's/\blibgtk-3-0\b/libgtk-3-0t64/g' \
            -e 's/\blibatk1\.0-0\b/libatk1.0-0t64/g' \
            -e 's/\blibasound2\b/libasound2t64/g' \
            -e 's/\blibatspi2\.0-0\b/libatspi2.0-0t64/g' \
            -e 's/\blibappindicator3-1\b/libayatana-appindicator3-1/g' \
            "$repack_dir/DEBIAN/control"
        dpkg-deb -b -Zgzip -z1 "$repack_dir" "$deb"
        rm -rf "$repack_dir"
        if dpkg-deb -f "$deb" Depends 2>/dev/null | grep -Eq '\blibgtk-3-0\b|\blibatk1\.0-0\b|\blibasound2\b|\blibatspi2\.0-0\b|\blibappindicator3-1\b'; then
            echo "XWLightOS: failed to rewrite Trixie-renamed dependencies in $deb" >&2
            exit 1
        fi
        echo "XWLightOS: rewrote Trixie-renamed dependencies in $(basename "$deb")"
    fi

    if [ "$package_name" = "com.seewo.terminalmanager" ]; then
        # 希沃管家 declares "Depends: libstdc++6 (>= 8.3), libstdc++6 (<< 9),
        # dkms". The upper bound is vendor over-caution; drop the bogus
        # clause and rebuild the DEB before handing it to apt.
        repack_dir="$(mktemp -d)"
        dpkg-deb -R "$deb" "$repack_dir"
        sed -i 's/^Depends: .*/Depends: libstdc++6 (>= 8.3), dkms/' "$repack_dir/DEBIAN/control"
        grep -qx 'Depends: libstdc++6 (>= 8.3), dkms' "$repack_dir/DEBIAN/control" || {
            echo "failed to rewrite the Seewo Terminal Manager dependency list" >&2
            rm -rf "$repack_dir"
            exit 1
        }
        dpkg-deb -b -Zgzip -z1 "$repack_dir" "$deb"
        rm -rf "$repack_dir"
    fi

    echo "XWLightOS: installing $package_name from $(basename "$deb")"
    HOME=/root apt-get install -y --no-install-recommends "$deb"
done

# --- 钉钉 (DingTalk)：清理厂商捆绑的陈旧系统库（修法移植自 WinduxEdu） ---
# 根因（已从 com.alibabainc.dingtalk 8.2.8.260818002 实包核验）：
#  Elevator.sh 先 cd 进 files/<版本>/ 再启动主程序，而主程序 RUNPATH=./plugins/dtwebview/:./，
#  于是该目录下捆绑的陈旧库优先于系统库被加载；实测捆绑 libm.so.6 只提供到
#  GLIBC_2.28，而主程序直接 NEEDED 系统 libgtk-3.so.0（要求 GLIBC_2.33/2.38），
#  链接期报 "GLIBC_2.3x not found"，钉钉启动即死（用户 2026-10-23「钉钉打不开」）。
#  厂商 postinst 本来会按发行版删除这些陈旧库并 chmod 4755 chrome-sandbox，
#  但删除循环写在 `for file in $(ls /home)` 里面，构建 chroot 的 /home 为空，
#  循环体一次都不执行。这里在同样的发行版条件下重跑该规则。
DT_FILES=/opt/apps/com.alibabainc.dingtalk/files
if [ -d "$DT_FILES" ]; then
    find "$DT_FILES" \( \
            -name 'libm.so.6' -o \
            -name 'libstdc++.so.6*' -o \
            -name 'libgbm.so*' -o \
            -name 'libGLX.so*' -o \
            -name 'libGLdispatch.so*' -o \
            -name 'libffi.so.6.0.4' -o \
            -name 'libharfbuzz.so*' \) \
        \( -type f -o -type l \) -delete
    # 同一被跳过的循环负责给 Chromium 沙箱助手加 setuid 位；
    # 没有它，钉钉内嵌网页视图拒绝启动。
    find "$DT_FILES" -name chrome-sandbox -type f -exec chmod 4755 {} +
    for stale in libm.so.6 libstdc++.so.6 libstdc++.so.6.0.25 \
        libgbm.so.1.0.0 libGLX.so.0.0.0 libGLdispatch.so.0.0.0; do
        hit="$(find "$DT_FILES" -name "$stale" \( -type f -o -type l \) -print -quit)"
        if [ -n "$hit" ]; then
            echo "XWLightOS: DingTalk still ships an incompatible bundled library: $stale" >&2
            exit 1
        fi
    done
    echo "XWLightOS: DingTalk stale bundled libraries removed, chrome-sandbox setuid set"
else
    echo "XWLightOS: NOTE: DingTalk not installed, skipping stale-library cleanup" >&2
fi
unset DT_FILES stale hit

# --- 希沃随机抽取/点名（easiminiapps）：清理厂商捆绑的陈旧系统库 ---
# 与钉钉同款问题（见上段，run 81 门禁实测）：主程序 RUNPATH=$ORIGIN，
# files/bin/ 下捆绑的 libm.so.6（只提供到 GLIBC_2.31）优先于系统库被
# 加载；系统 libmvec.so.1 要求 GLIBC_2.32/2.35/2.39，链接期报版本
# not found，关联库 libcvAPI.so 加载失败。删掉捆绑的陈旧库，用系统库
# （Trixie glibc 2.41 全覆盖）。只删与钉钉清理段相同的 7 个名字；
# 其余捆绑库（libopencv_world 等）是应用自有的，不动。
for _MINIAPP in com.seewo.easiminiapps.luckyrandom com.seewo.easiminiapps.rollcall; do
    _MINI_FILES="/opt/apps/$_MINIAPP/files"
    if [ -d "$_MINI_FILES" ]; then
        find "$_MINI_FILES" \( \
                -name 'libm.so.6' -o \
                -name 'libstdc++.so.6*' -o \
                -name 'libgbm.so*' -o \
                -name 'libGLX.so*' -o \
                -name 'libGLdispatch.so*' -o \
                -name 'libffi.so.6.0.4' -o \
                -name 'libharfbuzz.so*' \) \
            \( -type f -o -type l \) -delete
        for stale in libm.so.6 libstdc++.so.6 libstdc++.so.6.0.25 \
            libgbm.so.1.0.0 libGLX.so.0.0.0 libGLdispatch.so.0.0.0; do
            hit="$(find "$_MINI_FILES" -name "$stale" \( -type f -o -type l \) -print -quit)"
            if [ -n "$hit" ]; then
                echo "XWLightOS: $_MINIAPP still ships an incompatible bundled library: $stale" >&2
                exit 1
            fi
        done
        echo "XWLightOS: $_MINIAPP stale bundled libraries removed"
    else
        echo "XWLightOS: NOTE: $_MINIAPP not installed, skipping stale-library cleanup" >&2
    fi
done
unset _MINIAPP _MINI_FILES stale hit

# --- 希沃白板：chrome-sandbox 归属修正（第 15 轮 hygiene） ---
# 实包核验（com.seewo.easinote5 5.2.2.4.13701）：chrome-sandbox 在包里是
# 1000:1000 所有、4755；dpkg 原样安装后非 root 所有，不符合 Chromium 对
# setuid 沙箱助手的要求（须 root 所有 + 4755）。厂商 postinst 里根本没有
# 给它 chmod/chown 的逻辑（与钉钉不同，钉钉的 postinst 有但被 /home 为空
# 跳过）。这里照钉钉同款在构建期修正归属与权限。注意：Bookworm 上同一文件
# 同样 1000 所有却能跑（走 userns 沙箱），所以这项是 hygiene，不宣称是
# “白板打不开”的根因修法；根因待启动日志（见包装器）判定。
EN_SANDBOX=/opt/apps/com.seewo.easinote5/files/chrome-sandbox
if [ -f "$EN_SANDBOX" ]; then
    chown root:root "$EN_SANDBOX"
    chmod 4755 "$EN_SANDBOX"
    [ "$(stat -c '%U:%G %a' "$EN_SANDBOX")" = "root:root 4755" ] || {
        echo "XWLightOS: EasiNote5 chrome-sandbox is not root:root 4755 after fix" >&2
        exit 1
    }
    echo "XWLightOS: EasiNote5 chrome-sandbox fixed to root:root 4755"
else
    echo "XWLightOS: NOTE: EasiNote5 chrome-sandbox missing, skipping ownership fix" >&2
fi
unset EN_SANDBOX

# --- libunistring.so.2 垫片（第 16 轮，preview-79 白板打不开的根因） ---
# 根因（实包核验）：白板捆绑的 libidn2.so.0（Bookworm 时代编译，
# 在 files/resources/public/lib/ 下，经厂商 sh 的 LD_LIBRARY_PATH
# 覆盖系统版）NEEDED libunistring.so.2，而 Trixie 根本没有
# libunistring2 包（只有 libunistring5，提供 .so.5）；Bookworm 有
# libunistring2 1.0-2，所以旧版能开、Trixie 版打不开。包单加不了
# 这个包（apt 会失败），故从 Bookworm 池下载 .deb、只抽 .so.2 放进
# /usr/local/lib（Debian 默认 ld 路径），跑 ldconfig。垫片的 SONAME
# 是 libunistring.so.2，与系统 .so.5 不冲突；它自身只 NEEDED
# libc.so.6，无其他依赖。SHA256 钉死 Bookworm 索引值；主源
# deb.debian.org、备源 snapshot.debian.org（Bookworm 退为
# oldoldstable 后主源可能下架）。下载/校验/抽取任一步失败即构建失败
# （白板缺了它启动即死，不是可选项）。
LU2_DEB_URL="https://deb.debian.org/debian/pool/main/libu/libunistring/libunistring2_1.0-2_amd64.deb"
LU2_DEB_FALLBACK="https://snapshot.debian.org/archive/debian/20250101T000000Z/pool/main/libu/libunistring/libunistring2_1.0-2_amd64.deb"
LU2_DEB_SHA256="d466bbfe011d764d793c1d9d777cad9c7cf65b938e11598f27408171ad95a951"
LU2_TMP="$(mktemp -d)"
if ! curl -fsSL -o "$LU2_TMP/libunistring2.deb" "$LU2_DEB_URL" 2>/dev/null; then
    echo "XWLightOS: primary libunistring2 download failed, trying snapshot.debian.org" >&2
    curl -fsSL -o "$LU2_TMP/libunistring2.deb" "$LU2_DEB_FALLBACK" || {
        echo "XWLightOS: cannot download libunistring2 1.0-2 (EasiNote5 would fail to load)" >&2
        rm -rf "$LU2_TMP"
        exit 1
    }
fi
echo "$LU2_DEB_SHA256  $LU2_TMP/libunistring2.deb" | sha256sum -c - >/dev/null || {
    echo "XWLightOS: libunistring2 SHA256 mismatch" >&2
    rm -rf "$LU2_TMP"
    exit 1
}
mkdir -p "$LU2_TMP/x"
dpkg-deb -x "$LU2_TMP/libunistring2.deb" "$LU2_TMP/x" || {
    echo "XWLightOS: cannot extract libunistring2" >&2
    rm -rf "$LU2_TMP"
    exit 1
}
[ -f "$LU2_TMP/x/usr/lib/x86_64-linux-gnu/libunistring.so.2.2.0" ] || {
    echo "XWLightOS: libunistring.so.2.2.0 missing from libunistring2 package" >&2
    rm -rf "$LU2_TMP"
    exit 1
}
mkdir -p /usr/local/lib
cp -f "$LU2_TMP/x/usr/lib/x86_64-linux-gnu/libunistring.so.2.2.0" /usr/local/lib/
ln -sf libunistring.so.2.2.0 /usr/local/lib/libunistring.so.2
chmod 0644 /usr/local/lib/libunistring.so.2.2.0
rm -rf "$LU2_TMP"
ldconfig || {
    echo "XWLightOS: ldconfig failed after installing libunistring.so.2" >&2
    exit 1
}
ldconfig -p | grep -q 'libunistring.so.2 ' || {
    echo "XWLightOS: libunistring.so.2 is not in the ldconfig cache after install" >&2
    exit 1
}
echo "XWLightOS: libunistring.so.2 shim installed (Bookworm libunistring2 1.0-2)"
unset LU2_DEB_URL LU2_DEB_FALLBACK LU2_DEB_SHA256 LU2_TMP

# --- libcurl.so 未版本化名垫片（第 16 轮，视频展台 MQTT 模块） ---
# 视频展台的 libmp_mqtt.so NEEDED libcurl.so（未版本化名，厂商链接时
# 用了开发期名字）；Trixie 只有 -dev 包提供 libcurl.so，运行时包
# libcurl4t64 只提供 libcurl.so.4。装 -dev 包进镜像又重又不对，故在
# /usr/local/lib 建符号链接 libcurl.so -> 系统的 libcurl.so.4。
# 两处要点（run 80 实测教训）：
# 1. 链接目标必须写绝对路径。相对目标 libcurl.so.4 会解析成
#    /usr/local/lib/libcurl.so.4（不存在），链接是断的，-e 断言
#    直接让构建失败；run 80 就死在这里。
# 2. 建完链接必须跑 ldconfig 再断言缓存。实测：ldconfig 会把未版本
#    化名也记进缓存（ldconfig -p 里有 "libcurl.so =>
#    /usr/local/lib/libcurl.so"），ldd 据此解析；不跑 ldconfig 的
#    话缓存里没有该条目，本钩子末尾的 ldd 门禁就会报 not found。
[ -f /usr/lib/x86_64-linux-gnu/libcurl.so.4 ] || {
    echo "XWLightOS: libcurl.so.4 missing (libcurl4t64 not installed; the libcurl.so shim has no target)" >&2
    exit 1
}
ln -sf /usr/lib/x86_64-linux-gnu/libcurl.so.4 /usr/local/lib/libcurl.so
[ -L /usr/local/lib/libcurl.so ] && [ -e /usr/local/lib/libcurl.so ] || {
    echo "XWLightOS: failed to create /usr/local/lib/libcurl.so symlink" >&2
    exit 1
}
ldconfig || {
    echo "XWLightOS: ldconfig failed after installing libcurl.so shim" >&2
    exit 1
}
ldconfig -p | grep -q 'libcurl.so ' || {
    echo "XWLightOS: libcurl.so is not in the ldconfig cache after install" >&2
    exit 1
}
echo "XWLightOS: libcurl.so shim installed (/usr/local/lib/libcurl.so -> /usr/lib/x86_64-linux-gnu/libcurl.so.4)"

# --- 希沃视频展台：librectification.so 需要 GTK2（构建期断言） ---
# 根因见 xwlightos-desktop.list.chroot 中 libgtk2.0-0 的注释。
# 此处断言构建产物里该 native 库的 GTK2 依赖确实可解析，缺失则构建失败，
# 避免「打开全黑」带着未声明的依赖出厂。
EASICAMERA_LIB=/opt/apps/com.seewo.easicamera/files/lib/librectification.so
if [ -f "$EASICAMERA_LIB" ]; then
    for _gtk2lib in libgtk-x11-2.0.so.0 libgdk-x11-2.0.so.0; do
        if [ ! -f "/usr/lib/x86_64-linux-gnu/$_gtk2lib" ]; then
            echo "XWLightOS: missing $_gtk2lib (libgtk2.0-0) required by Seewo video booth" >&2
            exit 1
        fi
    done
    echo "XWLightOS: Seewo video booth GTK2 dependencies present"
fi
unset EASICAMERA_LIB _gtk2lib

# --- Seewo whiteboard daemon: ensure it is enabled at boot ---
if [ -f /usr/lib/systemd/system/com.cvte.maxhub.alfred.service ] || \
   [ -f /lib/systemd/system/com.cvte.maxhub.alfred.service ]; then
    mkdir -p /etc/systemd/system/multi-user.target.wants
    ln -sfn /usr/lib/systemd/system/com.cvte.maxhub.alfred.service \
        /etc/systemd/system/multi-user.target.wants/com.cvte.maxhub.alfred.service 2>/dev/null || \
    ln -sfn /lib/systemd/system/com.cvte.maxhub.alfred.service \
        /etc/systemd/system/multi-user.target.wants/com.cvte.maxhub.alfred.service 2>/dev/null || true
    echo "XWLightOS: Seewo whiteboard daemon enabled"
fi

# --- Seewo Terminal Manager daemon ---
# 历史写法只认 /usr/lib/systemd/system 一个路径、找不到就静默——真机反馈
# 「管家后端似乎没起来」的嫌疑之一。启用动作现统一由 1660 钩子做全量
# 枚举（两个路径都查、非更新类厂商 unit 全启用、缺失大声告警并留清单
# /etc/xwlightos/seewo-vendor-units.txt），此处不再重复单点启用。

# --- Disable Seewo OTA updates ---
# 1. Mask vendor updater systemd units
for unit in $(systemctl list-unit-files 2>/dev/null | grep -Ei 'seewo|easinote|easicare|easicamera|cvte|maxhub' | grep -Ei 'update|upgrade' | awk '{print $1}'); do
    echo "XWLightOS: masking vendor updater unit: $unit"
    ln -sfn /dev/null "/etc/systemd/system/$unit" 2>/dev/null || true
done
# 2. Disable Electron auto-update feeds
for tree in /opt/apps/com.seewo.* /opt/EasiNote5; do
    [ -d "$tree" ] || continue
    find "$tree" -maxdepth 5 -type f \
        \( -iname 'app-update.yml' -o -iname 'latest.yml' -o -iname 'update-info.json' \) \
        -exec sh -c 'mv -f "$1" "$1.disabled" 2>/dev/null || true' _ {} \; 2>/dev/null || true
done
# 3. The OTA gateway (ota-gateway.seewo.com) is blocked at boot via
#    /etc/hosts by xwlightos-seewo-ota-block.service (shipped in
#    config/includes.chroot, armed at boot because live-build overwrites
#    /etc/hosts during build). Enable it here with an explicit .wants
#    symlink (live-build does not preserve preset state in the chroot).
if [ -s /usr/local/bin/xwlightos-seewo-ota-block ] && \
   [ -s /etc/systemd/system/xwlightos-seewo-ota-block.service ]; then
    mkdir -p /etc/systemd/system/multi-user.target.wants
    ln -sfn ../xwlightos-seewo-ota-block.service \
        /etc/systemd/system/multi-user.target.wants/xwlightos-seewo-ota-block.service
    echo "XWLightOS: Seewo OTA block service enabled"
else
    echo "XWLightOS: WARNING: OTA block script/service missing" >&2
fi
echo "XWLightOS: Seewo OTA updates disabled"

# --- 第 16 轮 ldd 门禁：/opt 下全部厂商 ELF 的动态依赖必须齐全 ---
# preview-79 的教训：EasiNote5 死在 libunistring.so.2 缺失，而第 15 轮
# 的静态 SONAME 检查（只查直接 NEEDED + 几个具名库）漏掉了它——缺失的
# 库是经捆绑 libidn2.so.0 传递引入的。本门禁在 chroot 里对每个厂商
# ELF 真跑 ldd，任何 "=> not found"（库文件真找不到）即构建失败并打印
# 二进制与缺失的库。
# LD_LIBRARY_PATH 按应用取该应用树下全部含 .so 的目录（超集近似厂商
# sh 的运行时路径；ldd 本身已 honor 各 ELF 的 RUNPATH）。
# 跳过：非 ELF 文件、非 x86-64 ELF（ldd 会误报）、静态链接/非动态 ELF。
# ldd 本身出错但无 "not found" 时只告警不断言（个别怪异 ELF 不应拖垮
# 构建；真缺库一定表现为 "=> not found"）。
# 注意区分两种 "not found"（run 81 教训）：① "libfoo.so.1 => not found"
# 是库文件找不到，失败；② "version `X' not found (required by ...)"
# 是版本不匹配（如厂商捆绑的陈旧 libm.so.6 提供不到系统库要求的
# GLIBC 版本），它第一列是二进制自身路径、不是 SONAME。旧 gate 用
# grep 'not found' 通吃两种，还把二进制路径当 SONAME 打出来，
# run 81 的 31 条“失败”全是第 ② 种。版本不匹配只告警计数、不失败：
# 门禁管不了厂商二进制的版本要求；能修的（陈旧系统库）由上面的
# 清理段删掉，不能修的（Qt 版本混搭）不拦构建。
# allowlist（应用名:SONAME，精确行匹配）：以下 5 条在 Trixie 里根本
# 没有对应包，且主程序启动不受影响——只允许这 5 条，任何新缺失一律
# 失败。逐条依据见评估卡 round16 §2：
# - 钉钉 DingGuard/更新检查：liblber-2.4.so.2、libldap_r-2.4.so.2
#   （Trixie 只有 OpenLDAP 2.6 的 liblber.so.2/libldap.so.2；从
#   Bookworm 抽 2.4 版有 ABI 级联风险，组件本身非核心，不抽）
# - 钉钉 doctor 诊断工具：libpangox-1.0.so.0（pangox-compat 已从
#   Debian 移除；诊断工具非核心）
# - 白板 node-hid musl 预编译 .node：libc.musl-x86_64.so.1（glibc
#   系统加载同目录的 glibc 变体，musl 件是死代码）
# - 白板 mirror/lib/libselinux.so.1：libpcre.so.3（Trixie 已无
#   libpcre3；树内无 ELF 链接 libselinux，属潜伏风险）
_LDD_ALLOWLIST="com.alibabainc.dingtalk:liblber-2.4.so.2
com.alibabainc.dingtalk:libldap_r-2.4.so.2
com.alibabainc.dingtalk:libpangox-1.0.so.0
com.seewo.easinote5:libc.musl-x86_64.so.1
com.seewo.easinote5:libpcre.so.3"
_LDD_TMP="$(mktemp -d)"
_LDD_N=0
_LDD_FAIL=0
_LDD_ALLOW=0
_LDD_VERWARN=0
_LDD_FAIL_LIST="$_LDD_TMP/failures.txt"
: > "$_LDD_FAIL_LIST"
printf '%s\n' "$_LDD_ALLOWLIST" > "$_LDD_TMP/allowlist.txt"
# 注意：find 结果先落盘再重定向进 while 循环——管道会让循环跑在子
# shell 里，_LDD_FAIL 的赋值传不出来，门禁会变成空转。
find /opt \( -type f -executable -o -type f -name '*.so*' -o -type f -name '*.node' \) 2>/dev/null > "$_LDD_TMP/elfs.txt"
while read -r _elf; do
    _magic="$(head -c 4 "$_elf" 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')"
    [ "$_magic" = "7f454c46" ] || continue
    if command -v readelf >/dev/null 2>&1; then
        readelf -h "$_elf" 2>/dev/null | grep -q 'Class: *ELF64' || continue
        readelf -h "$_elf" 2>/dev/null | grep -q 'Machine: *Advanced Micro Devices X86-64' || continue
    fi
    _LDD_N=$((_LDD_N + 1))
    # 应用根：/opt/apps/<name> 或 /opt/<name>；其下全部含 .so 的目录
    # 拼成该应用的 LD_LIBRARY_PATH（每个根只算一次，缓存到文件）。
    _rest=${_elf#/opt/}
    case "$_rest" in
        apps/*) _app=${_rest#apps/}; _app=${_app%%/*}; _root="/opt/apps/$_app" ;;
        *) _app=${_rest%%/*}; _root="/opt/$_app" ;;
    esac
    _cache="$_LDD_TMP/$(echo "$_root" | tr '/' '_').libpath"
    if [ ! -f "$_cache" ]; then
        find "$_root" -type f -name '*.so*' -exec dirname {} + 2>/dev/null \
            | sort -u | paste -sd: - > "$_cache" 2>/dev/null || : > "$_cache"
    fi
    _libpath="$(cat "$_cache" 2>/dev/null || true)"
    _ldd_out="$(LD_LIBRARY_PATH="$_libpath" ldd "$_elf" 2>&1)" || true
    case "$_ldd_out" in
        *'not a dynamic executable'*|*'statically linked'*) continue ;;
    esac
    # 版本不匹配行只告警计数（见本段头注释），不进失败路径。
    _version_warn="$(printf '%s\n' "$_ldd_out" | grep "version .* not found" || true)"
    if [ -n "$_version_warn" ]; then
        _LDD_VERWARN=$((_LDD_VERWARN + $(printf '%s\n' "$_version_warn" | grep -c .)))
        printf '%s\n' "$_version_warn" | sed 's/^/XWLightOS: vendor ldd gate: version warning: /' >&2
    fi
    _missing="$(printf '%s\n' "$_ldd_out" | grep '=> not found' || true)"
    if [ -n "$_missing" ]; then
        # 逐条判 allowlist：ldd 行形如 "\tlibfoo.so.1 => not found"，
        # 取第一列即 SONAME。SONAME 无空格，for 拆词是安全的。
        _missing_sonames="$(printf '%s\n' "$_missing" | sed 's/^[[:space:]]*//; s/[[:space:]].*//')"
        for _soname in $_missing_sonames; do
            if grep -qxF "$_app:$_soname" "$_LDD_TMP/allowlist.txt"; then
                _LDD_ALLOW=$((_LDD_ALLOW + 1))
                echo "XWLightOS: vendor ldd gate: allowlisted missing library $_soname in $_elf (see round 16 eval card)" >&2
            else
                _LDD_FAIL=1
                echo "XWLightOS: vendor binary has unresolved library: $_elf: $_soname" | tee -a "$_LDD_FAIL_LIST" >&2
            fi
        done
    fi
done < "$_LDD_TMP/elfs.txt"
if [ "$_LDD_FAIL" -ne 0 ]; then
    echo "XWLightOS: vendor ldd gate failed (see failures above)" >&2
    rm -rf "$_LDD_TMP"
    exit 1
fi
echo "XWLightOS: vendor ldd gate passed ($_LDD_N vendor ELFs, 0 unresolved, $_LDD_ALLOW allowlisted, $_LDD_VERWARN version warnings)"
rm -rf "$_LDD_TMP"
unset _LDD_TMP _LDD_N _LDD_FAIL _LDD_ALLOW _LDD_VERWARN _LDD_FAIL_LIST _LDD_ALLOWLIST

echo "XWLightOS: education software installation complete"
