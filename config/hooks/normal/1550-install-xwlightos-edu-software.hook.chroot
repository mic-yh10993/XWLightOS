#!/bin/sh
# Install XWLightOS education software (DingTalk, Seewo whiteboard,
# Seewo terminal manager) from vendor .deb packages.
#
# Vendor packages are proprietary and must be staged at
# /opt/xwlightos/edu-packages/*.deb before the build (e.g. via the CI
# secret or a pre-build staging step). If the directory is empty or
# missing, this hook warns and continues so the base system can still
# build and be tested without the proprietary software.
set -eu

EDU_DIR=/opt/xwlightos/edu-packages
if [ ! -d "$EDU_DIR" ] || ! ls "$EDU_DIR"/*.deb >/dev/null 2>&1; then
    echo "XWLightOS: edu-software packages not staged at $EDU_DIR, skipping (base build continues)" >&2
    exit 0
fi

export DEBIAN_FRONTEND=noninteractive
# Add i386 architecture for Wine WoW64 support (DingTalk dependencies).
dpkg --add-architecture i386
apt-get update

# Hold kernel metapackages so the chroot and binary stages agree on
# exactly one kernel (same rationale as the DclawOS base).
apt-mark hold linux-image-amd64 linux-headers-amd64

# Install Wine stack and i386 dependencies for DingTalk.
apt-get install -y --no-install-recommends \
    wine wine32 wine64 libwine libwine:i386 fonts-wine

# DingTalk bundles a PulseAudio client linking libpulse-mainloop-glib
# explicitly; ship both architectures.
apt-get install -y --no-install-recommends \
    libpulse-mainloop-glib0 libpulse-mainloop-glib0:i386

# Wine 32-bit library dependencies (i386).
apt-get install -y --no-install-recommends \
    libasound2:i386 libasound2-plugins:i386 \
    libgstreamer-plugins-base1.0-0:i386 libgstreamer1.0-0:i386 \
    libpulse0:i386 libglib2.0-0:i386 \
    libgtk-3-0:i386 libasound2:i386 \
    libx11-6:i386 libxext6:i386 libxrender1:i386 \
    libxi6:i386 libxrandr2:i386 libxcursor1:i386 \
    libgl1:i386 libglx0:i386 libegl1:i386 \
    libvulkan1:i386 libfaudio0:i386 libmpg123-0:i386

# Force HOME=/root for vendor postinsts.
mkdir -p /etc/dpkg/pre-inst.d
cat > /etc/dpkg/pre-inst.d/set-home <<'EOF'
#!/bin/sh
export HOME=/root
EOF
chmod +x /etc/dpkg/pre-inst.d/set-home

for deb in "$EDU_DIR"/*.deb; do
    package_name="$(dpkg-deb -f "$deb" Package)"

    if [ "$package_name" = "com.seewo.terminalmanager" ]; then
        # 希沃管家 declares "Depends: libstdc++6 (>= 8.3), libstdc++6 (<< 9),
        # dkms". The upper bound is vendor over-caution; drop the bogus
        # clause and rebuild the DEB before handing it to apt.
        repack_dir="$(mktemp -d)"
        dpkg-deb -R "$deb" "$repack_dir"
        sed -i 's/^Depends: .*/Depends: libstdc++6 (>= 8.3), dkms/' "$repack_dir/DEBIAN/control"
        grep -qx 'Depends: libstdc++6 (>= 8.3), dkms' "$repack_dir/DEBIAN/control" || {
            echo "failed to rewrite the Seewo Terminal Manager dependency list" >&2
            rm -rf "$repack_dir"
            exit 1
        }
        dpkg-deb -b -Zgzip -z1 "$repack_dir" "$deb"
        rm -rf "$repack_dir"
    fi

    echo "XWLightOS: installing $package_name from $deb"
    HOME=/root apt-get install -y --no-install-recommends "$deb"
done

# 希沃白板守护进程：确保开机自启（vendor 包可能只装了二进制）。
if [ -f /usr/share/applications/seewo-whiteboard.desktop ] || \
   [ -f /opt/seewo/whiteboard/whiteboard ]; then
    echo "XWLightOS: Seewo whiteboard detected, ensuring autostart"
    mkdir -p /etc/xdg/autostart
    # Vendor autostart entry is created here if the package did not ship one.
fi

echo "XWLightOS: education software installation complete"
