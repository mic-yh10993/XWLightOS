#!/bin/sh
# Install XWLightOS education software from vendor .deb packages.
#
# Vendor packages are proprietary and sourced directly from the WinduxEdu
# repository (SYSTEM-Intel-MIC/WinduxEdu, edu-software/ directory) at the
# exact pinned versions recorded in DEB-INVENTORY.tsv. No Wine is used;
# all packages are native Linux .debs installed directly.
#
# The .debs are fetched from the WinduxEdu GitHub repo during build
# (split volumes, reassembled and SHA256-verified). If the fetch fails,
# this hook warns and continues so the base system can still build.
set -eu

WINDXUEDU_REPO="https://github.com/SYSTEM-Intel-MIC/WinduxEdu"
EDU_DIR=/opt/xwlightos/edu-packages
INVENTORY_URL="$WINDXUEDU_REPO/raw/main/edu-software/DEB-INVENTORY.tsv"

export DEBIAN_FRONTEND=noninteractive

# Hold kernel metapackages so the chroot and binary stages agree on
# exactly one kernel.
apt-mark hold linux-image-amd64 linux-headers-amd64

# DingTalk (native Linux build) bundles a PulseAudio client that links
# against libpulse-mainloop-glib explicitly; libpulse0 alone does not
# pull that split library in, so DingTalk died at load time with
# "libpulse-mainloop-glib.so.0: cannot open shared object file".
apt-get update
apt-get install -y --no-install-recommends libpulse-mainloop-glib0

mkdir -p "$EDU_DIR"

# Fetch DEB-INVENTORY.tsv to get the pinned file list and SHA256.
echo "XWLightOS: fetching education software inventory from WinduxEdu"
if ! curl -fsSL -o "$EDU_DIR/DEB-INVENTORY.tsv" "$INVENTORY_URL"; then
    echo "XWLightOS: WARNING: cannot fetch DEB-INVENTORY.tsv, skipping edu-software (base build continues)" >&2
    exit 0
fi

# Download and reassemble each .deb from split volumes.
# Format of DEB-INVENTORY.tsv: classification<TAB>file<TAB>Package<TAB>Version<TAB>Architecture<TAB>Size<TAB>SHA256
fetch_ok=1
grep -v '^#' "$EDU_DIR/DEB-INVENTORY.tsv" | while IFS="$(printf '\t')" read -r classification file package version arch size sha256; do
    [ -n "$file" ] || continue
    echo "XWLightOS: fetching $package $version"
    dest="$EDU_DIR/$(basename "$file")"
    vol=0
    rm -f "$dest"
    while true; do
        vol_name="$(printf '%s.%03d' "$file" "$vol")"
        # URL-encode via python3 for Chinese characters in filenames
        enc_name="$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$vol_name")"
        vol_url="$WINDXUEDU_REPO/raw/main/edu-software/$enc_name"
        if ! curl -fsSL -o "$EDU_DIR/vol.tmp" "$vol_url" 2>/dev/null; then
            if [ "$vol" -eq 0 ]; then
                echo "XWLightOS: WARNING: cannot fetch $vol_name, skipping $package" >&2
                break
            fi
            break
        fi
        cat "$EDU_DIR/vol.tmp" >> "$dest"
        rm -f "$EDU_DIR/vol.tmp"
        vol=$((vol + 1))
    done
    if [ -f "$dest" ]; then
        actual="$(sha256sum "$dest" | cut -d' ' -f1)"
        if [ "$actual" != "$sha256" ]; then
            echo "XWLightOS: WARNING: SHA256 mismatch for $package, skipping" >&2
            rm -f "$dest"
        else
            echo "XWLightOS: verified $package $version"
        fi
    fi
done
rm -f "$EDU_DIR/vol.tmp"

if ! ls "$EDU_DIR"/*.deb >/dev/null 2>&1; then
    echo "XWLightOS: WARNING: no edu-software .debs fetched, skipping (base build continues)" >&2
    exit 0
fi

# Force HOME=/root for vendor postinsts.
mkdir -p /etc/dpkg/pre-inst.d
cat > /etc/dpkg/pre-inst.d/set-home <<'EOF'
#!/bin/sh
export HOME=/root
EOF
chmod +x /etc/dpkg/pre-inst.d/set-home

for deb in "$EDU_DIR"/*.deb; do
    [ -f "$deb" ] || continue
    package_name="$(dpkg-deb -f "$deb" Package 2>/dev/null || echo "unknown")"

    if [ "$package_name" = "com.seewo.terminalmanager" ]; then
        # 希沃管家 declares "Depends: libstdc++6 (>= 8.3), libstdc++6 (<< 9),
        # dkms". The upper bound is vendor over-caution; drop the bogus
        # clause and rebuild the DEB before handing it to apt.
        repack_dir="$(mktemp -d)"
        dpkg-deb -R "$deb" "$repack_dir"
        sed -i 's/^Depends: .*/Depends: libstdc++6 (>= 8.3), dkms/' "$repack_dir/DEBIAN/control"
        grep -qx 'Depends: libstdc++6 (>= 8.3), dkms' "$repack_dir/DEBIAN/control" || {
            echo "failed to rewrite the Seewo Terminal Manager dependency list" >&2
            rm -rf "$repack_dir"
            exit 1
        }
        dpkg-deb -b -Zgzip -z1 "$repack_dir" "$deb"
        rm -rf "$repack_dir"
    fi

    echo "XWLightOS: installing $package_name from $(basename "$deb")"
    HOME=/root apt-get install -y --no-install-recommends "$deb"
done

# --- 钉钉 (DingTalk)：清理厂商捆绑的陈旧系统库（修法移植自 WinduxEdu） ---
# 根因（已从 com.alibabainc.dingtalk 8.2.8.260818002 实包核验）：
#  Elevator.sh 先 cd 进 files/<版本>/ 再启动主程序，而主程序 RUNPATH=./plugins/dtwebview/:./，
#  于是该目录下捆绑的陈旧库优先于系统库被加载；实测捆绑 libm.so.6 只提供到
#  GLIBC_2.28，而主程序直接 NEEDED 系统 libgtk-3.so.0（要求 GLIBC_2.33/2.38），
#  链接期报 "GLIBC_2.3x not found"，钉钉启动即死（用户 2026-10-23「钉钉打不开」）。
#  厂商 postinst 本来会按发行版删除这些陈旧库并 chmod 4755 chrome-sandbox，
#  但删除循环写在 `for file in $(ls /home)` 里面，构建 chroot 的 /home 为空，
#  循环体一次都不执行。这里在同样的发行版条件下重跑该规则。
DT_FILES=/opt/apps/com.alibabainc.dingtalk/files
if [ -d "$DT_FILES" ]; then
    find "$DT_FILES" \( \
            -name 'libm.so.6' -o \
            -name 'libstdc++.so.6*' -o \
            -name 'libgbm.so*' -o \
            -name 'libGLX.so*' -o \
            -name 'libGLdispatch.so*' -o \
            -name 'libffi.so.6.0.4' -o \
            -name 'libharfbuzz.so*' \) \
        \( -type f -o -type l \) -delete
    # 同一被跳过的循环负责给 Chromium 沙箱助手加 setuid 位；
    # 没有它，钉钉内嵌网页视图拒绝启动。
    find "$DT_FILES" -name chrome-sandbox -type f -exec chmod 4755 {} +
    for stale in libm.so.6 libstdc++.so.6 libstdc++.so.6.0.25 \
        libgbm.so.1.0.0 libGLX.so.0.0.0 libGLdispatch.so.0.0.0; do
        hit="$(find "$DT_FILES" -name "$stale" \( -type f -o -type l \) -print -quit)"
        if [ -n "$hit" ]; then
            echo "XWLightOS: DingTalk still ships an incompatible bundled library: $stale" >&2
            exit 1
        fi
    done
    echo "XWLightOS: DingTalk stale bundled libraries removed, chrome-sandbox setuid set"
else
    echo "XWLightOS: NOTE: DingTalk not installed, skipping stale-library cleanup" >&2
fi
unset DT_FILES stale hit

# --- 希沃视频展台：librectification.so 需要 GTK2（构建期断言） ---
# 根因见 xwlightos-desktop.list.chroot 中 libgtk2.0-0 的注释。
# 此处断言构建产物里该 native 库的 GTK2 依赖确实可解析，缺失则构建失败，
# 避免「打开全黑」带着未声明的依赖出厂。
EASICAMERA_LIB=/opt/apps/com.seewo.easicamera/files/lib/librectification.so
if [ -f "$EASICAMERA_LIB" ]; then
    for _gtk2lib in libgtk-x11-2.0.so.0 libgdk-x11-2.0.so.0; do
        if [ ! -f "/usr/lib/x86_64-linux-gnu/$_gtk2lib" ]; then
            echo "XWLightOS: missing $_gtk2lib (libgtk2.0-0) required by Seewo video booth" >&2
            exit 1
        fi
    done
    echo "XWLightOS: Seewo video booth GTK2 dependencies present"
fi
unset EASICAMERA_LIB _gtk2lib

# --- Seewo whiteboard daemon: ensure it is enabled at boot ---
if [ -f /usr/lib/systemd/system/com.cvte.maxhub.alfred.service ] || \
   [ -f /lib/systemd/system/com.cvte.maxhub.alfred.service ]; then
    mkdir -p /etc/systemd/system/multi-user.target.wants
    ln -sfn /usr/lib/systemd/system/com.cvte.maxhub.alfred.service \
        /etc/systemd/system/multi-user.target.wants/com.cvte.maxhub.alfred.service 2>/dev/null || \
    ln -sfn /lib/systemd/system/com.cvte.maxhub.alfred.service \
        /etc/systemd/system/multi-user.target.wants/com.cvte.maxhub.alfred.service 2>/dev/null || true
    echo "XWLightOS: Seewo whiteboard daemon enabled"
fi

# --- Seewo Terminal Manager daemon ---
# 历史写法只认 /usr/lib/systemd/system 一个路径、找不到就静默——真机反馈
# 「管家后端似乎没起来」的嫌疑之一。启用动作现统一由 1660 钩子做全量
# 枚举（两个路径都查、非更新类厂商 unit 全启用、缺失大声告警并留清单
# /etc/xwlightos/seewo-vendor-units.txt），此处不再重复单点启用。

# --- Disable Seewo OTA updates ---
# 1. Mask vendor updater systemd units
for unit in $(systemctl list-unit-files 2>/dev/null | grep -Ei 'seewo|easinote|easicare|easicamera|cvte|maxhub' | grep -Ei 'update|upgrade' | awk '{print $1}'); do
    echo "XWLightOS: masking vendor updater unit: $unit"
    ln -sfn /dev/null "/etc/systemd/system/$unit" 2>/dev/null || true
done
# 2. Disable Electron auto-update feeds
for tree in /opt/apps/com.seewo.* /opt/EasiNote5; do
    [ -d "$tree" ] || continue
    find "$tree" -maxdepth 5 -type f \
        \( -iname 'app-update.yml' -o -iname 'latest.yml' -o -iname 'update-info.json' \) \
        -exec sh -c 'mv -f "$1" "$1.disabled" 2>/dev/null || true' _ {} \; 2>/dev/null || true
done
# 3. The OTA gateway (ota-gateway.seewo.com) is blocked at boot via
#    /etc/hosts by xwlightos-seewo-ota-block.service (shipped in
#    config/includes.chroot, armed at boot because live-build overwrites
#    /etc/hosts during build). Enable it here with an explicit .wants
#    symlink (live-build does not preserve preset state in the chroot).
if [ -s /usr/local/bin/xwlightos-seewo-ota-block ] && \
   [ -s /etc/systemd/system/xwlightos-seewo-ota-block.service ]; then
    mkdir -p /etc/systemd/system/multi-user.target.wants
    ln -sfn ../xwlightos-seewo-ota-block.service \
        /etc/systemd/system/multi-user.target.wants/xwlightos-seewo-ota-block.service
    echo "XWLightOS: Seewo OTA block service enabled"
else
    echo "XWLightOS: WARNING: OTA block script/service missing" >&2
fi
echo "XWLightOS: Seewo OTA updates disabled"

echo "XWLightOS: education software installation complete"
