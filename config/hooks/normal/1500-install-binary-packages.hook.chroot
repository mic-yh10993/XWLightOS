#!/bin/sh
# Install the pinned binary packages (ONLYOFFICE DesktopEditors) and
# write the XWLightOS desktop entries that live outside any Debian package: the
# Terminal launcher and the AI-first desktop shortcuts.  XWLightOS no longer
# ships its own desktop components and no longer masquerades as another
# desktop environment.
set -eu

PKG_DIR=/opt/xwlightos/packages
if [ ! -d "$PKG_DIR" ] || ! ls "$PKG_DIR"/*.deb >/dev/null 2>&1; then
    echo "XWLightOS binary packages are missing: $PKG_DIR" >&2
    exit 1
fi

cd "$PKG_DIR"
sha256sum -c SHA256SUMS
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends ./*.deb

install -d /usr/local/share/applications
# The Windows-command compatibility layer is gone; Terminal launches XTerm
# directly, with an explicit black palette and a compact DejaVu primary face
# with Fontconfig CJK fallback.
cat > /usr/local/share/applications/xterm.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Terminal
Name[zh_CN]=终端
Comment=XWLightOS terminal
Exec=xterm -fa "DejaVu Sans Mono" -fs 11 -xrm "XTerm*cjkWidth:false" -xrm "XTerm*background:#000000" -xrm "XTerm*cursorColor:#ffffff"
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;
StartupWMClass=XTerm
EOF
# 用户 2026-10-24 指令：桌面保持干净，终端/ONLYOFFICE 等应用不得往桌面
# 预置快捷方式（应用入口在程序栏/dock 即可）。skel Desktop 只保留 live 的
# 安装器图标（来自 includes.chroot，安装后由 cleanup 删除）。
# The raw Calamares entry would duplicate the XWLightOS installer launcher.
rm -f /usr/share/applications/calamares.desktop

# --- ONLYOFFICE DesktopEditors (pinned official DEB) -----------------------
# Registered as the system-wide default for documents, spreadsheets,
# presentations and PDF; seeded for multi-window mode.  The desktop entry id
# below is the filename the official DEB really ships
# (onlyoffice-desktopeditors.desktop), verified against the pinned release.
OO_DESKTOP=""
for oo_cand in /usr/share/applications/onlyoffice-desktopeditors.desktop \
    /usr/local/share/applications/onlyoffice-desktopeditors.desktop; do
    if [ -s "$oo_cand" ]; then
        OO_DESKTOP="$oo_cand"
        break
    fi
done
[ -n "$OO_DESKTOP" ] || {
    echo "ONLYOFFICE desktop entry is missing after install" >&2
    exit 1
}
OO_ENTRY="$(basename "$OO_DESKTOP")"
echo "ONLYOFFICE desktop entry: $OO_DESKTOP"
# The official entry already advertises the office MIME types (including
# application/pdf); assert rather than trust, so a repackaged upstream that
# drops them fails the build instead of silently losing file associations.
for oo_mime in \
    application/pdf \
    application/msword \
    application/vnd.openxmlformats-officedocument.wordprocessingml.document \
    application/vnd.ms-excel \
    application/vnd.openxmlformats-officedocument.spreadsheetml.sheet \
    application/vnd.ms-powerpoint \
    application/vnd.openxmlformats-officedocument.presentationml.presentation; do
    grep -q "^MimeType=.*${oo_mime}[;]" "$OO_DESKTOP" || {
        echo "ONLYOFFICE entry does not advertise MIME type: $oo_mime" >&2
        exit 1
    }
done
# Wire ONLYOFFICE as the default handler in /etc/xdg/mimeapps.list, replacing
# any competing default (e.g. the PDF -> Firefox ESR mapping from the base
# config).  GNOME "默认应用程序" reads this file system-wide.
xwlightos_mime_default() {
    dm_mime="$1"
    dm_entry="$2"
    MIMEAPPS=/etc/xdg/mimeapps.list
    if [ -f "$MIMEAPPS" ]; then
        grep -v "^${dm_mime}=" "$MIMEAPPS" > "$MIMEAPPS.tmp" || true
        if grep -q '^\[Default Applications\]' "$MIMEAPPS.tmp"; then
            sed -i "/^\[Default Applications\]/a ${dm_mime}=${dm_entry}" \
                "$MIMEAPPS.tmp"
        else
            printf '\n[Default Applications]\n%s=%s\n' "$dm_mime" "$dm_entry" \
                >> "$MIMEAPPS.tmp"
        fi
        mv -f "$MIMEAPPS.tmp" "$MIMEAPPS"
    else
        printf '[Default Applications]\n%s=%s\n' "$dm_mime" "$dm_entry" \
            > "$MIMEAPPS"
    fi
}
for oo_mime in \
    application/pdf \
    application/msword \
    application/vnd.openxmlformats-officedocument.wordprocessingml.document \
    application/vnd.ms-excel \
    application/vnd.openxmlformats-officedocument.spreadsheetml.sheet \
    application/vnd.ms-powerpoint \
    application/vnd.openxmlformats-officedocument.presentationml.presentation \
    application/vnd.oasis.opendocument.text \
    application/vnd.oasis.opendocument.spreadsheet \
    application/vnd.oasis.opendocument.presentation \
    application/vnd.oasis.opendocument.graphics \
    application/rtf \
    text/csv; do
    xwlightos_mime_default "$oo_mime" "$OO_ENTRY"
done
grep -qx "application/pdf=${OO_ENTRY}" /etc/xdg/mimeapps.list || {
    echo "ONLYOFFICE is not the default application/pdf handler" >&2
    exit 1
}
# Multi-window mode ("Open file -> In its own window"): verified against the
# pinned ONLYOFFICE DesktopEditors 9.4.0 (opt/onlyoffice/desktopeditors/
# index.html, settings page JS): the launch-mode select uses values
# "inwindow"/"intab" and applies `editorwindowmode = ("inwindow" == value)`.
# So `editorWindowMode = true` means every document opens in its own window;
# `false` (the previous seed) actively forced single-window tab mode.
# Seeded into /etc/skel so the Live session and every installed user inherit
# it (Qt INI format).
OO_SKEL_CONF=/etc/skel/.config/onlyoffice/DesktopEditors.conf
install -d "$(dirname "$OO_SKEL_CONF")"
# 用户 2026-10-31 两项预置（均已对 9.4.0 官方包本体核实）：
# (1) 默认作者/用户名 XWLightOS：应用外壳 index.html 的设置页 JS
#     实证——用户名字段先读 localStorage（首启为空），为空即向
#     原生侧 settings:get "username" 取值，原生侧的持久层就是
#     本文件（QSettings 用户域）；保存时同道回写。故在 skel 的
#     本文件里预置 username，首启即为默认作者（文档属性、修订
#     署名都取它）；用户日后在设置里改名只改自己的副本，本种子
#     不锁定。键名 username 与二进制内设置键簇（username/locale/
#     uiscaling 相邻）互证。
# (2) useai = false：外壳设置页的 AI 开关（同页 JS 的 useai 字段，
#     applies 时带 restart 标志），关掉外壳层 AI 助手入口；
#     编辑器内的 AI 插件另由系统级 pluginsDisabled 关闭（见
#     /etc/xdg/onlyoffice/DesktopEditors.conf，includes.chroot 直带）。
cat > "$OO_SKEL_CONF" <<'EOF'
[General]
editorWindowMode = true
username = XWLightOS
useai = false
EOF
grep -q -E '^editorWindowMode *= *true$' "$OO_SKEL_CONF" || {
    echo "ONLYOFFICE multi-window mode was not seeded" >&2
    exit 1
}
grep -q -E '^username *= *XWLightOS$' "$OO_SKEL_CONF" || {
    echo "ONLYOFFICE default user name (author) was not seeded" >&2
    exit 1
}
grep -q -E '^useai *= *false$' "$OO_SKEL_CONF" || {
    echo "ONLYOFFICE shell AI switch was not seeded off" >&2
    exit 1
}
# 用户 2026-10-24 指令：ONLYOFFICE 不再往桌面放快捷方式（见上）。
grep -q '^Exec=' "$OO_DESKTOP" || {
    echo "ONLYOFFICE desktop entry is unusable" >&2
    exit 1
}
if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate "$OO_DESKTOP"
fi
echo "ONLYOFFICE $OO_ENTRY installed: default office/PDF handler, multi-window mode"
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications
    update-desktop-database /usr/local/share/applications
fi

# Packages are installed; keeping their archives only increases the ISO.
rm -rf "$PKG_DIR"
mkdir -p /usr/share/xwlightos
cat > /usr/share/xwlightos/components.txt <<'EOF'
XWLightOS 1.0 bundled extras
- GNOME desktop with WhiteSur macOS-like theme
- GNOME File Roller (archive manager; PeaZip removed 2026-10-25: no Chinese UI)
- ONLYOFFICE DesktopEditors 9.4.0 official DEB (documents/spreadsheets/presentations/PDF default handler, multi-window mode)
- XWLightOS education software: DingTalk, Seewo whiteboard, Seewo terminal manager (vendor .debs)
EOF
