#!/bin/sh
set -eu

# Onboard 图标兜底（2026-10-31 Build 58 用户实测：应用网格里
# Onboard 显示为占位图标；Build 59 首版钩子曾断言一个并不存在
# 的图标路径 org.onboard.Onboard.svg 而让构建红灯——已对
# onboard 1.4.1-5+b7 的 deb 本体重新核实，结论订正如下）：
# 包自带的 onboard.desktop 写 Icon=onboard，包本体也确实带
# /usr/share/icons/hicolor/scalable/apps/onboard.svg（2668 字节
# SVG）与 16–32px 的 onboard.png——名字与文件在本就对得上，
# 不存在“改名”问题。占位图标只能出在查找环节：GNOME Shell 经
# GtkIconTheme 在当前主题（WhiteSur）→继承的 hicolor 链上查
# 图标，而带缓存的主题目录只认缓存内容——缓存若在 onboard 的
# 图标文件落盘之前生成，该目录里就“没有”这个图标。本钩子在
# 全部钩子的靠后位置（1715，晚于 1700 的缓存刷新）再把三套
# 主题缓存整体重刷一遍，并当场校验 hicolor 缓存里确实出现
# onboard 条目，把“图标文件在、缓存不认”这类断链在构建期
# 就拦住；校验不过即大声失败，不许静默出货。
ICON=/usr/share/icons/hicolor/scalable/apps/onboard.svg
[ -s "$ICON" ] || {
    echo "XWLightOS: onboard package icon missing at $ICON (package layout changed? app grid would show a placeholder)" >&2
    exit 1
}
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    for _dir in /usr/share/icons/hicolor /usr/share/icons/WhiteSur-light /usr/share/icons/WhiteSur; do
        if [ -d "$_dir" ]; then
            gtk-update-icon-cache -f "$_dir" >/dev/null 2>&1 || {
                echo "XWLightOS: gtk-update-icon-cache failed for $_dir (Onboard icon could stay a placeholder)" >&2
                exit 1
            }
        fi
    done
    unset _dir
else
    echo 'XWLightOS: gtk-update-icon-cache missing (cannot guarantee the Onboard icon is in the theme caches)' >&2
    exit 1
fi
# 缓存是二进制，但图标名以明文存放在缓存的名字表里，可直接查。
grep -a -q 'onboard' /usr/share/icons/hicolor/icon-theme.cache || {
    echo 'XWLightOS: hicolor icon cache does not contain an onboard entry after refresh (app grid would show a placeholder)' >&2
    exit 1
}
echo "XWLightOS: Onboard icon present in hicolor and registered in the refreshed icon-theme caches"
