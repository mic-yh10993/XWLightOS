#!/bin/sh
# 用户 2026-10-19 邮件「ok,写入并监控构建」批准：
# XWLightOS 触屏通用兼容修法（两阶段方案）。
#
# 背景：国产红外触屏框（如希沃 T86EA 的 CJTouch 系，VID 1FF7）在 Linux 下
# 常被 hid-generic 兜底认领，触摸事件无法正确映射（光标浮中央不动）。
# Debian 13 官方 live 同样现象，确认是内核侧问题、非 XWLightOS 特有。
# 用户明确要求：方案必须追求最大通用兼容性，不能只针对他这台机
# （通用 live ISO，不通用就不必构建）。
#
# 一手实证（2026-10-19）：
# - VID 1FF7 = CJTouch（深圳红外触屏框大厂）产品页标称 VID，用户这台
#   希沃 T86EA 同属这一家族——国内一体机/白板红外框大量是这一系。
# - kernel 6.12（Debian trixie 同款）hid-multitouch.c 源码仍保留
#   "CJTouch panels" 条目（USB_VENDOR_ID_CVTOUCH + 0x0013，与 6.1
#   逐行一致；第 14 轮已对照 6.1/6.12 两版源码）——驱动本来就是为
#   这类设备设计的，只是非标描述符未被分入 multitouch 组。
# - hid-core.c 的 new_id_store 用 sscanf(buf, "%x %x %x") 解析
#   "bus vendor product" 十六进制；hid-multitouch 的 id_table 有
#   HID_GROUP_MULTITOUCH + HID_ANY_ID 通配条目。
#
# 实现（本钩子只做构建期门禁，文件本体在 includes.chroot 里版本管理）：
# - /usr/local/sbin/xwlightos-touchscreen-fix.sh：开机脚本，三阶段
#   （通用兜底：hid-generic 占用 + 名字含 touch + 排除 touchpad；
#   已知 ID 名单：/etc/xwlightos/touchscreen-known-ids.conf，首批 1FF7:0F26；
#   阶段三：名单设备已绑 hid-multitouch 时改绑怪癖类（new_id 带
#   类值 + rebind，失败回退 plain 绑定）——真机上阶段一/二
#   是 moved 0 的 no-op，怪癖必须靠阶段三。类值沿革：第七轮
#   MT_CLS_EXPORT_ALL_INPUTS（0x13），Build 68 真机改绑生效仍
#   全 0；第八轮按“对齐 Windows”改 MT_CLS_WIN_8（0x12，该类
#   同样带 export_all_inputs，并经 mt_set_modes 发 Input Mode
#   的 SET_REPORT）。脚本还带第八轮 root 取证：rdesc 摘要、
#   usbmon 枚举期控制传输统计（本钩子只验类值与 sampler 单元，
#   取证细节由镜像校验脚本断言）。第九轮起另有对齐打包：
#   阶段四 MI_01 隔离、阶段五关 autosuspend、阶段六 Input
#   Mode 的 SET 重试送达，及 /etc/modprobe.d 的 usbhid
#   quirks 出货文件（本钩子验 quirks 文件与掩码、阶段四/六
#   关键串，细节断言在镜像校验脚本）
# - /etc/systemd/system/xwlightos-touchscreen-fix.service：oneshot 开机服务
# - multi-user.target.wants 符号链接：构建期启用（仿 xwlightos-live-session-init）
set -eu

# ---- 构建期门禁 ----
# 1. 开机脚本必须存在、可执行、语法通过。
[ -x /usr/local/sbin/xwlightos-touchscreen-fix.sh ] || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.sh missing or not executable' >&2
    exit 1
}
bash -n /usr/local/sbin/xwlightos-touchscreen-fix.sh || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.sh syntax check failed' >&2
    exit 1
}
# 2. 脚本必须包含两阶段关键逻辑（防将来有人改坏）。
grep -q 'touchscreen-known-ids.conf' /usr/local/sbin/xwlightos-touchscreen-fix.sh || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.sh lost phase-2 known-IDs logic' >&2
    exit 1
}
grep -q 'touchpad' /usr/local/sbin/xwlightos-touchscreen-fix.sh || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.sh lost touchpad exclusion (would steal touchpads)' >&2
    exit 1
}
# 2b. 脚本必须包含阶段三怪癖逻辑（第七轮起：真机上阶段一/二
# no-op，怪癖是唯一能动已绑 hid-multitouch 设备的手段；第八
# 轮类值为 MT_CLS_WIN_8）。
grep -q 'MT_CLS_WIN_8' /usr/local/sbin/xwlightos-touchscreen-fix.sh || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.sh lost stage-3 quirk class (already-bound device would never leave MT_CLS_DEFAULT)' >&2
    exit 1
}
# 3. 已知 ID 名单必须存在且包含首批 ID。
grep -qi '^1FF7:0F26' /etc/xwlightos/touchscreen-known-ids.conf || {
    echo 'XWLightOS: touchscreen-known-ids.conf missing 1FF7:0F26' >&2
    exit 1
}
# 4. systemd 服务文件必须存在，wants 链接必须有效且指向正确。
[ -f /etc/systemd/system/xwlightos-touchscreen-fix.service ] || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.service missing' >&2
    exit 1
}
_WANTS=/etc/systemd/system/multi-user.target.wants/xwlightos-touchscreen-fix.service
[ -e "$_WANTS" ] || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.service wants symlink is dangling (fix would never run at boot)' >&2
    exit 1
}
[ "$(readlink "$_WANTS")" = '../xwlightos-touchscreen-fix.service' ] || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.service wants symlink points at the wrong unit' >&2
    exit 1
}
grep -q '^ExecStart=/usr/local/sbin/xwlightos-touchscreen-fix.sh$' \
    /etc/systemd/system/xwlightos-touchscreen-fix.service || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.service lost its ExecStart' >&2
    exit 1
}
# 4b. 第八轮 hidraw root 采样服务必须在场且启用（Build 68 盲
# 区：hidraw 普通用户不可读，必须有 root 采样通道，否则诊断
# 第 17 节永远拿不到触摸窗内的原始字节）。
[ -f /etc/systemd/system/xwlightos-touch-hidraw-sampler.service ] || {
    echo 'XWLightOS: xwlightos-touch-hidraw-sampler.service missing' >&2
    exit 1
}
_SWANTS=/etc/systemd/system/multi-user.target.wants/xwlightos-touch-hidraw-sampler.service
[ -e "$_SWANTS" ] || {
    echo 'XWLightOS: xwlightos-touch-hidraw-sampler.service wants symlink is dangling (root hidraw sampling would never run)' >&2
    exit 1
}
[ "$(readlink "$_SWANTS")" = '../xwlightos-touch-hidraw-sampler.service' ] || {
    echo 'XWLightOS: xwlightos-touch-hidraw-sampler.service wants symlink points at the wrong unit' >&2
    exit 1
}
grep -q '^ExecStart=/usr/local/sbin/xwlightos-touchscreen-fix.sh sampler$' \
    /etc/systemd/system/xwlightos-touch-hidraw-sampler.service || {
    echo 'XWLightOS: xwlightos-touch-hidraw-sampler.service lost its sampler ExecStart' >&2
    exit 1
}
# 5. 修复脚本必须主动加载 hid-multitouch（Build 40 补，见脚本头注释）。
# 非标设备不会触发该模块自动加载，缺了这行脚本会静默退出、修法等于没跑。
grep -q 'modprobe hid-multitouch' /usr/local/sbin/xwlightos-touchscreen-fix.sh || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.sh lost modprobe hid-multitouch (fix would silently no-op)' >&2
    exit 1
}
# 6. 第九轮对齐包：usbhid 少提问 quirks 出货文件必须存在且掩码
# 精确（位值按出货内核 6.1 的 include/linux/hid.h 核实：
# HID_QUIRK_NOGET=BIT(3)=0x8、HID_QUIRK_NO_INIT_REPORTS=
# BIT(29)=0x20000000，合并 0x20000008；写错一位等于没对齐）。
[ -f /etc/modprobe.d/xwlightos-touch-quirks.conf ] || {
    echo 'XWLightOS: xwlightos-touch-quirks.conf missing (usbhid would keep interrogating the Seewo gadget at enumeration)' >&2
    exit 1
}
grep -q '^options usbhid quirks=0x1ff7:0x0f26:0x20000008$' /etc/modprobe.d/xwlightos-touch-quirks.conf || {
    echo 'XWLightOS: xwlightos-touch-quirks.conf lost the verified quirks mask 0x20000008' >&2
    exit 1
}
# 7. 第九轮对齐包：修复脚本必须含阶段四 MI_01 隔离与阶段六
# Input Mode 的 SET 重试送达（HIDIOCSFEATURE）。
grep -q 'stage4_isolate_mi01' /usr/local/sbin/xwlightos-touchscreen-fix.sh || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.sh lost stage-4 MI_01 isolation (round 9 alignment bundle)' >&2
    exit 1
}
grep -q 'HIDIOCSFEATURE' /usr/local/sbin/xwlightos-touchscreen-fix.sh || {
    echo 'XWLightOS: xwlightos-touchscreen-fix.sh lost stage-6 Input Mode SET retry (HIDIOCSFEATURE)' >&2
    exit 1
}
# 8. 第十一轮绕过服务（Build 72）：C 程序编译 + 服务 + wants 链接 +
# udev 规则 + modules-load 文件 + uinput 内核模块必须齐全，否则
# 触屏绕过等于没装。Build 71 的 Python 守护进程已删除（未在真机验证
# 过；用户在真机上验证跑通的是 C 程序，只留一个触屏服务）。
# 8a. 第 13 轮（用户 2026-11-11 邮件第 2 项）：DeepSeek 的 .sh 被 Windows
# 换行符 CRLF 搞坏、服务卡死无输出。镜像里不用那个 .sh，但同类问题
# 必须有门禁——触屏相关的全部文本文件必须是 Unix 换行符（LF），带一个
# 回车即构建失败。/bin/sh 是 dash，不支持 bash 的 $'\r'，用 printf 取回车。
_CR=$(printf '\r')
for _crlf_file in /etc/systemd/system/xwlightos-touch-bypass.service \
        /etc/systemd/system/xwlightos-touchscreen-fix.service \
        /usr/local/src/xwlightos-touch-cvte/cvte_touch.c \
        /usr/local/bin/xwlightos-touch-bypass-notify \
        /usr/local/bin/xwlightos-touch-bypass-dialog \
        /usr/local/libexec/xwlightos-touch-bypass-ctl \
        /usr/local/bin/xwlightos-settings \
        /usr/local/sbin/xwlightos-touchscreen-fix.sh \
        /etc/udev/rules.d/70-xwlightos-touch-bypass.rules; do
    if [ -f "$_crlf_file" ] && grep -q "$_CR" "$_crlf_file"; then
        echo "XWLightOS: $_crlf_file contains CR (Windows line endings) - use Unix LF only" >&2
        exit 1
    fi
done
unset _crlf_file _CR
# 编译：源码随镜像发货（/usr/local/src/xwlightos-touch-cvte/），
# 构建期用镜像自带的 gcc（devel 清单含 build-essential）编成
# /usr/local/bin/cvte_touch；-Wall -Wextra -Werror，警告即构建红灯。
command -v gcc >/dev/null 2>&1 || {
    echo 'XWLightOS: gcc missing (cannot build the CVTE touch bypass)' >&2
    exit 1
}
[ -f /usr/local/src/xwlightos-touch-cvte/cvte_touch.c ] || {
    echo 'XWLightOS: cvte_touch.c source missing' >&2
    exit 1
}
gcc -O2 -Wall -Wextra -Werror -o /usr/local/bin/cvte_touch \
    /usr/local/src/xwlightos-touch-cvte/cvte_touch.c || {
    echo 'XWLightOS: cvte_touch.c failed to compile' >&2
    exit 1
}
chmod 0755 /usr/local/bin/cvte_touch
[ -x /usr/local/bin/cvte_touch ] || {
    echo 'XWLightOS: /usr/local/bin/cvte_touch is not executable after build' >&2
    exit 1
}
# 8b. 第 13 轮冒烟检查（用户 2026-11-11 邮件第 2 项“服务卡死无任何输出”）：
# 无设备时跑几秒，启动行“等待 CVTE Touch Device 插入...”必须立刻出现——
# 它证明两件事：二进制能启动、stdout 行缓冲已生效（Build 72 补的
# setvbuf _IOLBF；若缓冲又退回全缓冲，4 秒内攒不够 4KB、输出为空、
# 本检查即失败）。timeout 124（被掐停）是预期结果，不算失败。
if command -v timeout >/dev/null 2>&1; then
    timeout 4 /usr/local/bin/cvte_touch > /tmp/cvte_smoke.log 2>&1 || true
    grep -q '等待 CVTE Touch Device' /tmp/cvte_smoke.log || {
        echo 'XWLightOS: cvte_touch smoke test produced no startup line (service would look dead with no output)' >&2
        exit 1
    }
    rm -f /tmp/cvte_smoke.log
else
    echo 'XWLightOS: timeout missing (cannot smoke-test cvte_touch startup output)' >&2
    exit 1
fi
[ -f /etc/systemd/system/xwlightos-touch-bypass.service ] || {
    echo 'XWLightOS: xwlightos-touch-bypass.service missing' >&2
    exit 1
}
_BWANTS=/etc/systemd/system/multi-user.target.wants/xwlightos-touch-bypass.service
[ -e "$_BWANTS" ] || {
    echo 'XWLightOS: xwlightos-touch-bypass.service wants symlink is dangling (bypass would never run at boot)' >&2
    exit 1
}
[ "$(readlink "$_BWANTS")" = '../xwlightos-touch-bypass.service' ] || {
    echo 'XWLightOS: xwlightos-touch-bypass.service wants symlink points at the wrong unit' >&2
    exit 1
}
grep -q '^ExecStart=/usr/local/bin/cvte_touch$' \
    /etc/systemd/system/xwlightos-touch-bypass.service || {
    echo 'XWLightOS: xwlightos-touch-bypass.service lost its ExecStart (must run /usr/local/bin/cvte_touch)' >&2
    exit 1
}
# 8b. 用户 2026-11-10 10:29 硬约束：全仓不得出现全局 blacklist
# hid_multitouch（会禁掉所有设备的内核驱动，也停掉这台设备的笔/
# 鼠标）。绕过是叠加、不是取代。否定式 grep 先剔注释行再查。
if grep -r -I --include='*' -h '^[^#]*blacklist[[:space:]]\+hid_multitouch' \
        /etc/modprobe.d /usr/local/sbin /usr/local/bin /etc/udev 2>/dev/null | grep -q .; then
    echo 'XWLightOS: global blacklist hid_multitouch found (forbidden by user 2026-11-10: overlay, not a driver replacement)' >&2
    exit 1
fi
[ -f /etc/udev/rules.d/70-xwlightos-touch-bypass.rules ] || {
    echo 'XWLightOS: 70-xwlightos-touch-bypass.rules missing' >&2
    exit 1
}
grep -q '^uinput$' /etc/modules-load.d/xwlightos-touch-bypass.conf || {
    echo 'XWLightOS: xwlightos-touch-bypass.conf lost the uinput line (uinput module would never load)' >&2
    exit 1
}
# uinput 内核模块必须随出货内核提供，否则服务起不来、/dev/uinput 永不出现。
_UINP=$(ls /lib/modules/*/kernel/drivers/input/misc/uinput.ko* 2>/dev/null | head -1)
[ -n "$_UINP" ] || {
    echo 'XWLightOS: uinput kernel module missing from the image (bypass service could never create /dev/uinput)' >&2
    exit 1
}
# 8c. 第十二轮（Build 73）：防抖必须在源码里，否则“所有程序”
# 闪退修法等于没装；通知脚本与 notify-send 必须齐全，否则自动开启的提示
# 发不出去；设置里必须有触屏兜底开关，否则用户关不掉自动兜底。
grep -q 'CVTE_DEBOUNCE_MS' /usr/local/src/xwlightos-touch-cvte/cvte_touch.c || {
    echo 'XWLightOS: cvte_touch.c lost the debounce (round 12 double-tap fix)' >&2
    exit 1
}
grep -q 'flush_pending_releases' /usr/local/src/xwlightos-touch-cvte/cvte_touch.c || {
    echo 'XWLightOS: cvte_touch.c lost flush_pending_releases (debounce never fires)' >&2
    exit 1
}
# 8d. 第十六轮（用户 2026-11-14）：内核守卫已删除，换成 30 秒首次启动
# 观测 + stamp 决策。旧守卫断言（kernel_touch_event_seen 必须存在）
# 已随守卫一起删除；现断言观测逻辑在场、让路路径不在场。
grep -q 'CVTE_OBSERVE_WINDOW_MS' /usr/local/src/xwlightos-touch-cvte/cvte_touch.c || {
    echo 'XWLightOS: cvte_touch.c lost the 30-second first-boot observation window (round 16)' >&2
    exit 1
}
grep -q 'bypass_decision' /usr/local/src/xwlightos-touch-cvte/cvte_touch.c || {
    echo 'XWLightOS: cvte_touch.c lost bypass_decision (first-boot stamp logic, round 16)' >&2
    exit 1
}
grep -q 'touch-bypass-first-boot' /usr/local/src/xwlightos-touch-cvte/cvte_touch.c || {
    echo 'XWLightOS: cvte_touch.c lost the first-boot stamp path (round 16)' >&2
    exit 1
}
if grep -q 'guard_fd' /usr/local/src/xwlightos-touch-cvte/cvte_touch.c; then
    echo 'XWLightOS: cvte_touch.c still references guard_fd (the kernel guard was removed by user decision 2026-11-14)' >&2
    exit 1
fi
# 观测必须在触屏修复服务（rebind）之后跑，否则节点中途重建打断观测。
grep -q '^After=.*xwlightos-touchscreen-fix.service' \
    /etc/systemd/system/xwlightos-touch-bypass.service || {
    echo 'XWLightOS: xwlightos-touch-bypass.service lost its After=xwlightos-touchscreen-fix.service ordering (round 16)' >&2
    exit 1
}
# 8e. 第十六轮：自动开启改弹窗口（对话框脚本）+ 设置关闭确认的助手
# 脚本，两者必须齐全可执行，否则新策略等于没装。
[ -x /usr/local/bin/xwlightos-touch-bypass-notify ] || {
    echo 'XWLightOS: xwlightos-touch-bypass-notify missing or not executable (auto-enable notification would never fire)' >&2
    exit 1
}
[ -x /usr/local/bin/xwlightos-touch-bypass-dialog ] || {
    echo 'XWLightOS: xwlightos-touch-bypass-dialog missing or not executable (auto-enable window would never show)' >&2
    exit 1
}
python3 -m py_compile /usr/local/bin/xwlightos-touch-bypass-dialog || {
    echo 'XWLightOS: xwlightos-touch-bypass-dialog has a Python syntax error' >&2
    exit 1
}
grep -q 'xwlightos-touch-bypass-dialog' /usr/local/bin/xwlightos-touch-bypass-notify || {
    echo 'XWLightOS: xwlightos-touch-bypass-notify does not call the dialog (auto-enable would never show a window)' >&2
    exit 1
}
[ -x /usr/local/libexec/xwlightos-touch-bypass-ctl ] || {
    echo 'XWLightOS: xwlightos-touch-bypass-ctl missing or not executable (settings touch toggle would fail)' >&2
    exit 1
}
sh -n /usr/local/libexec/xwlightos-touch-bypass-ctl || {
    echo 'XWLightOS: xwlightos-touch-bypass-ctl has a shell syntax error' >&2
    exit 1
}
command -v notify-send >/dev/null 2>&1 || {
    echo 'XWLightOS: notify-send missing (libnotify-bin not installed; manual touch-enable notification would never fire)' >&2
    exit 1
}
grep -q 'xwlightos-touch-bypass.service' /usr/local/bin/xwlightos-settings || {
    echo 'XWLightOS: xwlightos-settings lost the touch fallback switch (user could not turn the bypass off)' >&2
    exit 1
}
grep -q 'confirm_touch_off' /usr/local/bin/xwlightos-settings || {
    echo 'XWLightOS: xwlightos-settings lost the touch-off confirmation dialog (round 16 anti-lockout)' >&2
    exit 1
}
grep -q 'xwlightos-touch-bypass-ctl' /usr/local/bin/xwlightos-settings || {
    echo 'XWLightOS: xwlightos-settings does not use the touch bypass helper (round 16)' >&2
    exit 1
}

echo 'XWLightOS: touchscreen fix (1620) staged'
