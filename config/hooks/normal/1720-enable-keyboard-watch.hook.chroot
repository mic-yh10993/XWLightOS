#!/bin/sh
# XWLightOS: enable the keyboard-presence watcher user unit
# (2026-11-01 round 5; user request: suppress the GNOME
# on-screen keyboard auto-popup while a physical keyboard is
# attached, allow it when none is). Same wiring pattern as the
# desktop-cleaner path unit in 1660: the unit file ships in
# /etc/systemd/user and the default.target.wants link is created
# here at build time. Any missing piece fails the build instead
# of silently shipping a watcher that never starts; the live
# image validator separately asserts the shipped script, unit,
# link target and ExecStart, and self-tests the presence
# classifier against synthetic device trees.
set -e

[ -f /etc/systemd/user/xwlightos-keyboard-watch.service ] || {
    echo "XWLightOS: keyboard watcher user unit missing" >&2
    exit 1
}
[ -x /usr/local/sbin/xwlightos-keyboard-watch.sh ] || {
    echo "XWLightOS: keyboard watcher script missing or not executable" >&2
    exit 1
}
grep -q '^ExecStart=/usr/local/sbin/xwlightos-keyboard-watch.sh$' /etc/systemd/user/xwlightos-keyboard-watch.service || {
    echo "XWLightOS: keyboard watcher unit lost its ExecStart" >&2
    exit 1
}
mkdir -p /etc/systemd/user/default.target.wants
ln -sfn ../xwlightos-keyboard-watch.service \
    /etc/systemd/user/default.target.wants/xwlightos-keyboard-watch.service
echo "XWLightOS: keyboard presence watcher user unit enabled"
