#!/bin/bash
set -eu

# XWLightOS 开机动画：把 Plymouth 默认主题设为 xwlightos。
# （用户 2026-10-23 邮件：开机动画按效果稿实现——几何符号描边绘制、
# 呼吸辉光、沿路径流动的光点、文字逐段浮现；用 Plymouth 主题复刻。）
#
# 顺序保证：chroot 钩子全部跑在 live-build 的 initramfs 阶段之前，
# Debian 的 plymouth 包自带 /usr/share/initramfs-tools/hooks/plymouth，
# 会在 update-initramfs 时把此处设定的默认主题打进 initrd，
# 开机 early-userspace 即可显示动画（cmdline 已有 splash）。
THEME_DIR=/usr/share/plymouth/themes/xwlightos
[ -f "$THEME_DIR/xwlightos.plymouth" ] || {
    echo "XWLightOS: plymouth theme descriptor missing: $THEME_DIR/xwlightos.plymouth" >&2
    exit 1
}
[ -f "$THEME_DIR/xwlightos.script" ] || {
    echo "XWLightOS: plymouth theme script missing: $THEME_DIR/xwlightos.script" >&2
    exit 1
}
for asset in mark.png mark-glow.png brand-main.png brand-sub.png \
             dot.png bar-bg.png bar-fg.png; do
    [ -s "$THEME_DIR/$asset" ] || {
        echo "XWLightOS: plymouth theme asset missing: $THEME_DIR/$asset" >&2
        exit 1
    }
done
command -v plymouth-set-default-theme >/dev/null 2>&1 || {
    echo "XWLightOS: plymouth is not installed (package list must include it)" >&2
    exit 1
}
plymouth-set-default-theme xwlightos
grep -q '^Theme=xwlightos$' /etc/plymouth/plymouthd.conf || {
    echo "XWLightOS: failed to set plymouth default theme to xwlightos" >&2
    exit 1
}
echo "XWLightOS: plymouth default theme set to xwlightos"
# 内核 postinst 那次 update-initramfs 发生在默认主题还是 Debian 自带时
# （本钩子跑在全部包安装之后），必须在这里重建 initrd 才能把 xwlightos
# 打进去——开机 early-userspace 的动画靠 initrd 里的那份主题；否则最终
# ISO 的 initrd 里是默认主题，校验脚本的 lsinitramfs 断言必挂
# （run 39968933420 教训）。
update-initramfs -u -k all
_kver="$(ls -t /lib/modules | head -n 1)"
[ -n "$_kver" ] || { echo "XWLightOS: no kernel modules found for initrd check" >&2; exit 1; }
if command -v lsinitramfs >/dev/null 2>&1; then
    # 用户 2026-10-24 邮件《很大问题》第 4 项：开机动画仍滚屏。
    # 此前只校验了脚本文件本身进没进 initrd；脚本在真机上加载 7 张
    # 图片，缺任何一张都会导致主题加载失败、回落到文字滚动——而缺图
    # 的情况旧校验根本发现不了。这里把全部资产逐一核对进 initrd。
    for _asset in xwlightos.script xwlightos.plymouth mark.png mark-glow.png \
                 brand-main.png brand-sub.png dot.png bar-bg.png bar-fg.png; do
        lsinitramfs "/boot/initrd.img-${_kver}" | grep -q "usr/share/plymouth/themes/xwlightos/${_asset}" || {
            echo "XWLightOS: rebuilt initrd lacks plymouth theme asset ${_asset} (theme would fall back to text scrolling)" >&2
            exit 1
        }
    done
fi
echo "XWLightOS: initrd rebuilt with the xwlightos plymouth theme (kernel ${_kver})"
