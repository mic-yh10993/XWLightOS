#!/bin/bash
set -eu

# Fail the image build early if the installed target cannot perform a real
# Calamares installation. unpackfs executes unsquashfs inside the target.
command -v unsquashfs >/dev/null 2>&1 || {
    echo "XWLightOS: squashfs-tools/unsquashfs is required in the target" >&2
    exit 1
}
command -v rsync >/dev/null 2>&1 || {
    echo "XWLightOS: rsync is required by Calamares unpackfs" >&2
    exit 1
}
find /usr/lib -path '*/calamares/modules/partition/libcalamares_viewmodule_partition.so' -print -quit | grep -q . || {
    echo "XWLightOS: Calamares partition module is missing" >&2
    exit 1
}
find /usr/lib -path '*/calamares/modules/mount/module.desc' -print -quit | grep -q . || {
    echo "XWLightOS: Calamares mount module is missing" >&2
    exit 1
}

# calamares-settings-debian supplies the tested Debian module sequence. Keep
# that sequence but replace its selected branding component with XWLightOS.
SETTINGS=/etc/calamares/settings.conf
if [ ! -f "$SETTINGS" ]; then
    echo "XWLightOS: Calamares settings are missing" >&2
    exit 1
fi
if grep -qE '^[[:space:]]*branding:' "$SETTINGS"; then
    sed -i -E 's|^([[:space:]]*branding:)[[:space:]]*.*$|\1 xwlightos|' "$SETTINGS"
else
    echo "XWLightOS: Calamares settings have no branding selector" >&2
    exit 1
fi

# Calamares requires an explicit slideshow key. The XWLightOS source tree ships
# its own show.qml; never copy Debian's placeholder slideshow over it.
BRANDING=/etc/calamares/branding/xwlightos
# Keep the GRUB theme self-contained both in the Live image and in the target
# root copied by unpackfs.
install -Dm644 /usr/share/xwlightos/branding/xwlightos-aurora-wallpaper.png \
    /boot/grub/themes/xwlightos/xwlightos-aurora-wallpaper.png
install -Dm644 /boot/grub/themes/xwlightos/theme.txt \
    /usr/share/xwlightos/branding/theme.txt
chmod 0755 /usr/local/libexec/xwlightos-target-postinstall.sh

# XWLightOS installs fully offline: unpackfs copies the live filesystem to the
# target, so no apt operations are needed or permitted during installation.
# The `packages` module is the only apt-capable *upstream* Calamares module
# (verified against calamares 3.2.61 sources), but Debian inserts its own
# `bootloader-config` process module BEFORE `bootloader`:
# /usr/share/calamares/helpers/calamares-bootloader-config chroots into
# the target and runs `apt-get -y install grub-efi` (UEFI) or `grub-pc`
# (BIOS). That script
# has no `set -e`: when apt fails offline, the trailing
# `chroot $CHROOT /usr/sbin/update-grub` dies with command-not-found because
# grub2-common never got installed — that is the exit 127 from the
# 2026-10-23 user report (see docs/offline-bootloader-root-cause.md).
# Fix: grub2-common, the GRUB platform modules (grub-pc-bin /
# grub-efi-amd64-bin) and shim-signed are preinstalled in the image and ride
# to the target via unpackfs, and the 1565 hook patches bootloader-config
# with an offline fast-path (skip apt when the target already has them).
# Removing the `packages` module from the sequence plus the empty
# operations.conf below still guarantees the installer never touches the
# network for anything else.
if grep -qE '^[[:space:]]*-[[:space:]]*packages[[:space:]]*$' "$SETTINGS"; then
    sed -i -E '/^[[:space:]]*-[[:space:]]*packages[[:space:]]*$/d' "$SETTINGS"
    echo "XWLightOS: removed packages module from Calamares sequence (offline install)"
fi
# Safety net: even if the module is re-added, its config installs nothing.
mkdir -p /etc/calamares/modules
cat > /etc/calamares/modules/packages.conf <<'EOF'
---
backend: apt
operations: []
EOF

# Round 15 (user 2026-11-14, installer unusable): remove ALL password
# restrictions. Root cause (verified against Calamares 3.3.14
# CheckPWQuality.cpp and Debian's users.conf): Debian's config only relaxes
# minlen/minclass, leaving libpwquality's dictcheck at its default 1; the
# image ships no cracklib dictionary, so the dictionary check fails for ANY
# password ("The password fails the dictionary check"). Written here in the
# hook -- not via includes.chroot -- so the package-provided users.conf can
# never overwrite it afterwards (same pattern as packages.conf above).
# Group assignments are copied verbatim from Debian's users.conf; only the
# password requirements change. `nonempty` is dropped: Calamares 3.3.14
# ignores it ("nonempty check is ignored; use minLength: 1") and its schema
# has no such key. minLength/maxLength -1 means "no check".
cat > /etc/calamares/modules/users.conf <<'EOF'
---
userGroup:       users
defaultGroups:
    - cdrom
    - floppy
    - sudo
    - audio
    - dip
    - video
    - plugdev
    - netdev
    - lpadmin
    - scanner
    - bluetooth
autologinGroup:  autologin
sudoersGroup:    sudo
setRootPassword: false
allowWeakPasswords: true

passwordRequirements:
    minLength: -1  # Password at least this many characters (-1: no check)
    maxLength: -1  # Password at most this many characters (-1: no check)
    libpwquality:
        - minlen=0
        - minclass=0
        - dictcheck=0
        - usercheck=0
        - gecoscheck=0
EOF
grep -q 'dictcheck=0' /etc/calamares/modules/users.conf || {
    echo "XWLightOS: users.conf lost dictcheck=0, installer passwords would still be rejected" >&2
    exit 1
}

# Round 15 (user 2026-11-14): lock the timezone, do not ask the user.
# Debian ships no locale.conf, so Calamares 3.3.14 getStartingTimezone()
# hardcodes the starting timezone to America/New_York (the user's
# screenshot). Removing `locale` from the show phase alone is NOT enough:
# with the view never activated, GlobalStorage `localeConf` is never
# written, and localecfg falls back to all-en_US.UTF-8 for the installed
# system (main.py:122-134) -- number/date formats would stay American
# English. So remove `locale` from show AND `locale` + `localecfg` from
# exec (Debian's own comment: view modules in exec must have been shown),
# and let the target postinstall lock timezone (already) + locale (new).
if grep -qE '^[[:space:]]*-[[:space:]]*locale[[:space:]]*$' "$SETTINGS"; then
    sed -i -E '/^[[:space:]]*-[[:space:]]*locale[[:space:]]*$/d' "$SETTINGS"
    echo "XWLightOS: removed locale module from Calamares sequences (timezone locked to Asia/Shanghai)"
fi
if grep -qE '^[[:space:]]*-[[:space:]]*localecfg[[:space:]]*$' "$SETTINGS"; then
    sed -i -E '/^[[:space:]]*-[[:space:]]*localecfg[[:space:]]*$/d' "$SETTINGS"
    echo "XWLightOS: removed localecfg module from Calamares exec sequence (locale locked by postinstall)"
fi
if grep -qE '^[[:space:]]*-[[:space:]]*(locale|localecfg)[[:space:]]*$' "$SETTINGS"; then
    echo "XWLightOS: locale/localecfg still present in Calamares settings.conf after removal" >&2
    exit 1
fi

# Register a target-chroot shellprocess after Calamares creates the selected
# user. This must not follow `packages`, because the Live temporary `user`
# account is present then while the account selected in Calamares is created
# by the later `users` module.
# Round 14 (Trixie) insertion point: AFTER `hwclock`, not after `users`.
# Root cause (verified against the Trixie calamares-settings-debian
# settings.conf and the Calamares 3.3.14 hwclock module source): the exec
# sequence is users -> displaymanager -> networkcfg -> hwclock ->
# services-systemd -> ... -> packages, and the hwclock module hardcodes
# `hwclock --systohc --utc`, which rewrites /etc/adjtime's third line to
# UTC. Inserting postinstall right after `users` (the round-13 position)
# lets hwclock run after it and silently undo the postinstall's LOCAL
# hardware-clock setting on the installed system. After `hwclock` the
# postinstall still runs after `users` and before `packages`, so both
# original constraints hold and the LOCAL setting survives.
SETTINGS=/etc/calamares/settings.conf
if ! grep -q '^-[[:space:]]*id:[[:space:]]*xwlightos-postinstall' "$SETTINGS" 2>/dev/null; then
    cat >> "$SETTINGS" <<'EOF'

instances:
- id: xwlightos-postinstall
  module: shellprocess
  config: xwlightos-postinstall.conf
EOF
fi
if ! grep -q '^[[:space:]]*-[[:space:]]*shellprocess@xwlightos-postinstall[[:space:]]*$' "$SETTINGS"; then
    awk '
        /^[[:space:]]*-[[:space:]]*exec:[[:space:]]*$/ { in_exec=1 }
        !done && in_exec && /^[[:space:]]*-[[:space:]]*hwclock[[:space:]]*$/ {
            indent=$0; sub(/[^[:space:]].*/, "", indent)
            print $0
            print indent "- shellprocess@xwlightos-postinstall"
            done=1
            next
        }
        { print }
    ' "$SETTINGS" > "$SETTINGS.xwlightos" && mv "$SETTINGS.xwlightos" "$SETTINGS"
fi

if [ ! -f "$BRANDING/show.qml" ]; then
    echo "XWLightOS: custom Calamares show.qml is missing" >&2
    exit 1
fi
if ! grep -q '^slideshow:' "$BRANDING/branding.desc"; then
    printf '\nslideshow: "show.qml"\nslideshowAPI: 2\n' >> "$BRANDING/branding.desc"
fi

# GNOME desktop wallpaper: use the XWLightOS aurora artwork as the default.
# (WhiteSur is a widget/icon theme and ships no wallpaper of its own.)
[ -s /usr/share/xwlightos/branding/xwlightos-aurora-wallpaper.png ] || {
    echo "XWLightOS: aurora wallpaper is missing" >&2
    exit 1
}
install -Dm644 /usr/share/xwlightos/branding/xwlightos-aurora-wallpaper.png \
    /usr/share/backgrounds/xwlightos-aurora-wallpaper.png

# Make the Live session and Calamares use Simplified Chinese by default.
if [ -f /etc/locale.gen ]; then
    sed -i -E 's/^#[[:space:]]*(zh_CN.UTF-8[[:space:]]+UTF-8)/\1/' /etc/locale.gen
    locale-gen zh_CN.UTF-8
fi
cat > /etc/default/locale <<'EOF'
LANG=zh_CN.UTF-8
LANGUAGE=zh_CN:zh
LC_MESSAGES=zh_CN.UTF-8
EOF

# Remove Debian's generic installer launcher from the application menu. The
# XWLightOS-branded Calamares entry remains the only graphical installer entry.
for dir in /usr/share/applications /etc/xdg/autostart /etc/skel/Desktop; do
    [ -d "$dir" ] || continue
    # This hook runs under dash, whose `read` lacks -d.  The direct glob is
    # POSIX-safe and still covers all package-provided desktop filenames.
    for entry in "$dir"/*.desktop; do
        [ -f "$entry" ] || continue
        if grep -qiE '(^Name(\[[^]]+\])?=.*(Install Debian|Debian Installer|Install System|安装系统))|debian-installer-launcher|debian-installer.desktop|install-system.desktop' "$entry" 2>/dev/null; then
            rm -f "$entry"
        fi
    done
done
chmod 0755 '/etc/skel/Desktop/Install XWLightOS.desktop' 2>/dev/null || true
chmod 0755 /usr/share/applications/xwlightos-installer.desktop 2>/dev/null || true

# Keep human-readable system identity coherent outside the desktop itself.
printf 'XWLightOS 1.0 \\n \\l\n' > /etc/issue
printf 'XWLightOS 1.0\n' > /etc/issue.net

# GRUB themes are read from /etc/default/grub by grub-mkconfig.  Only append
# the XWLightOS theme assignment after both theme assets have been staged.  This
# prevents a missing file from becoming a boot-time GRUB theme warning.
# Offline-install guarantee (user 2026-10-18: installer must not download
# GRUB; user 2026-10-23: bootloader-config exit 127 root-caused to an apt
# call in Debian's bootloader-config wrapper): the patched
# /usr/share/calamares/helpers/calamares-bootloader-config (1565 hook)
# skips apt only when the target
# already carries grub2-common (grub-install/update-grub) plus the
# firmware-specific platform modules.  They ride to the target via unpackfs,
# so fail the build if a package-list change ever drops them, instead of
# shipping an installer whose bootloader step breaks.
for grub_platform_dir in /usr/lib/grub/i386-pc /usr/lib/grub/x86_64-efi; do
    [ -f "$grub_platform_dir/modinfo.sh" ] || {
        echo "XWLightOS: GRUB platform modules missing: $grub_platform_dir (offline bootloader install would fail)" >&2
        exit 1
    }
done
command -v grub-install >/dev/null 2>&1 || {
    echo "XWLightOS: grub2-common (grub-install) is missing (offline bootloader install would fail)" >&2
    exit 1
}
command -v update-grub >/dev/null 2>&1 || {
    echo "XWLightOS: grub2-common (update-grub) is missing (offline bootloader install would fail)" >&2
    exit 1
}
if [ -f /etc/default/grub ] && \
   [ -s /boot/grub/themes/xwlightos/theme.txt ] && \
   [ -s /boot/grub/themes/xwlightos/xwlightos-aurora-wallpaper.png ]; then
    cat >> /etc/default/grub <<'EOF'

# XWLightOS 1.0 bootloader identity and presentation.
GRUB_DISTRIBUTOR="XWLightOS"
GRUB_THEME="/boot/grub/themes/xwlightos/theme.txt"
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=6
GRUB_DEFAULT=0
GRUB_DISABLE_OS_PROBER=false
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash plymouth.ignore-serial-consoles"
EOF
elif [ -f /etc/default/grub ]; then
    # Never leave a stale XWLightOS theme reference if staging failed.
    sed -i '\|^GRUB_THEME="/boot/grub/themes/xwlightos/theme.txt"$|d' /etc/default/grub
fi

