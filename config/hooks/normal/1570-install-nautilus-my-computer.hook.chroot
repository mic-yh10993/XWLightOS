#!/bin/sh
# Install the "My Computer" Nautilus extension
# (yannmasoch/nautilus-my-computer) system-wide into the live chroot.
# User request, 2026-10-17 mail: "在Linux搞一个此电脑并且设置默认打开
# 文件就打开此电脑", reference: curl .../nautilus-my-computer/main/install.sh | sh
#
# Adaptation notes (decided per the user's "自己决策" authorization):
# - Upstream install.sh installs per-user ($HOME/.local/...). A live image
#   needs it for every user, so it is installed system-wide:
#   /usr/share/nautilus-python/extensions (the dir nautilus-python scans),
#   schema in /usr/share/glib-2.0/schemas, translations in
#   /usr/share/locale. This mirrors upstream's own Makefile (PREFIX=/usr).
# - Pinned to release tag v0.13.2 (codeload tarball), never main/floating.
# - "默认打开文件就打开此电脑": the extension's start-on-disks setting
#   defaults to true ("Show the disk panel when Nautilus opens"), so new
#   Files windows navigate to computer:/// automatically. No extra dconf
#   needed; the default is asserted below via the compiled schema.
# - Runtime needs python3-nautilus (in the desktop package list). Upstream
#   targets Python >= 3.12 while bookworm ships 3.11: the hook py_compiles
#   the sources with the chroot's Python as a gate, so a syntax failure
#   fails the build instead of shipping a broken extension.
# - Upstream README: full support targets GNOME Files 50+; bookworm ships
#   Files 43. The extension carries legacy handling (<= 46), so the Computer
#   panel and start-on-disks navigation work, but some newer features may
#   be limited. Recorded as a known caveat.
set -eu

NMC_VER="v0.13.2"
EXT_DIR="/usr/share/nautilus-python/extensions"
SCHEMA_DIR="/usr/share/glib-2.0/schemas"
SCHEMA_ID="io.github.yannmasoch.nautilus-my-computer"

command -v python3 >/dev/null 2>&1 || {
    echo "DclawOS: python3 is missing" >&2
    exit 1
}
# nautilus-python binding (python3-nautilus package) must be present.
[ -f /usr/lib/x86_64-linux-gnu/girepository-1.0/Nautilus-4.0.typelib ] || {
    echo "DclawOS: python3-nautilus is missing (Nautilus typelib not found)" >&2
    exit 1
}

WORKDIR="$(mktemp -d /tmp/dclawos-nmc-XXXXXX)"
trap 'rm -rf "$WORKDIR"' EXIT
cd "$WORKDIR"

echo "DclawOS: installing nautilus-my-computer $NMC_VER (system-wide)"
curl -fsSL "https://codeload.github.com/yannmasoch/nautilus-my-computer/tar.gz/${NMC_VER}" -o nmc.tar.gz
tar xzf nmc.tar.gz --strip-components=1

[ -f nautilus-my-computer.py ] || {
    echo "DclawOS: nautilus-my-computer.py missing in $NMC_VER" >&2
    exit 1
}
[ -f "$SCHEMA_ID.gschema.xml" ] || {
    echo "DclawOS: $SCHEMA_ID.gschema.xml missing in $NMC_VER" >&2
    exit 1
}
[ -d nautilus_my_computer ] || {
    echo "DclawOS: nautilus_my_computer package dir missing in $NMC_VER" >&2
    exit 1
}

# Syntax gate with the chroot's Python (3.11 on bookworm).
python3 -m py_compile nautilus-my-computer.py nautilus_my_computer/*.py || {
    echo "DclawOS: nautilus-my-computer $NMC_VER failed py_compile" >&2
    exit 1
}

# System-wide extension files.
install -d -m 0755 "$EXT_DIR"
install -m 0644 nautilus-my-computer.py "$EXT_DIR/nautilus-my-computer.py"
rm -rf "$EXT_DIR/nautilus_my_computer"
cp -r nautilus_my_computer "$EXT_DIR/nautilus_my_computer"
rm -rf "$EXT_DIR/nautilus_my_computer/__pycache__"
chmod -R a+rX "$EXT_DIR/nautilus_my_computer"

# GSettings schema, system-wide.
install -m 0644 "$SCHEMA_ID.gschema.xml" "$SCHEMA_DIR/$SCHEMA_ID.gschema.xml"
glib-compile-schemas "$SCHEMA_DIR" || {
    echo "DclawOS: glib-compile-schemas failed" >&2
    exit 1
}

# Translations. msgfmt comes from gettext (installed in-hook if missing).
if ! command -v msgfmt >/dev/null 2>&1; then
    apt-get update
    apt-get install -y --no-install-recommends gettext
fi
if [ -d po ]; then
    for po_file in po/*.po; do
        [ -f "$po_file" ] || continue
        lang="$(basename "$po_file" .po)"
        mkdir -p "/usr/share/locale/$lang/LC_MESSAGES"
        msgfmt "$po_file" -o "/usr/share/locale/$lang/LC_MESSAGES/nautilus-my-computer.mo"
        # DclawOS default locale is zh_CN.UTF-8; gettext resolves zh_CN then
        # zh, never zh_Hans, so the Simplified Chinese catalog is aliased.
        if [ "$lang" = "zh_Hans" ]; then
            mkdir -p /usr/share/locale/zh_CN/LC_MESSAGES
            msgfmt "$po_file" -o /usr/share/locale/zh_CN/LC_MESSAGES/nautilus-my-computer.mo
        fi
    done
fi

# Build-time gates.
[ -f "$EXT_DIR/nautilus-my-computer.py" ] || {
    echo "DclawOS: extension file missing after install" >&2
    exit 1
}
[ -f "$SCHEMA_DIR/$SCHEMA_ID.gschema.xml" ] || {
    echo "DclawOS: schema file missing after install" >&2
    exit 1
}
# "默认打开文件就打开此电脑": start-on-disks must default to true.
grep -q '<key name="start-on-disks" type="b">' "$SCHEMA_DIR/$SCHEMA_ID.gschema.xml" || {
    echo "DclawOS: start-on-disks key missing from schema" >&2
    exit 1
}
# Runtime smoke test: py_compile only proves syntax. nautilus-python silently
# skips extensions that fail at import, which is exactly the "没有此电脑页面"
# symptom (user 2026-10-18). Import the extension module for real with the
# Nautilus typelib available; any ImportError fails the build here.
python3 - "$EXT_DIR" <<'PYEOF'
import importlib.util
import sys

import gi
gi.require_version("Nautilus", "4.0")
from gi.repository import Nautilus  # noqa: F401  (typelib must load)

ext_dir = sys.argv[1]
spec = importlib.util.spec_from_file_location(
    "nautilus_my_computer_ext",
    ext_dir + "/nautilus-my-computer.py",
)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
print("DclawOS: nautilus-my-computer imports cleanly")
PYEOF

echo "DclawOS: nautilus-my-computer $NMC_VER installed"
