# XWLightOS core: Debian Bookworm AMD64, GNOME desktop with macOS-like WhiteSur theme
# The Live user and graphical session are initialized by the XWLightOS-native
# services below, rather than by live-config (which blocks basic.target while
# executing generic late-userspace profiles on every boot).
live-boot
systemd-sysv
libpam-systemd
linux-image-amd64
firmware-linux
firmware-iwlwifi
firmware-atheros
firmware-brcm80211
firmware-realtek
firmware-misc-nonfree
firmware-amd-graphics
firmware-intel-sound
# 开机动画：Plymouth（script 主题 xwlightos，复刻用户 2026-10-23 邮件效果稿：
# 描边绘制→呼吸辉光→流动光点→文字浮现）。内核 cmdline 已带 splash，
# 默认主题由 1630 钩子设为 xwlightos，随 initramfs 进镜像。
plymouth
# plymouth-themes：提供 label.so。Debian 的 plymouth initramfs 钩子在
# update-initramfs 时若缺 label.so 会告警（run 39968933420 实锤 W:），
# 且钩子会 cp /etc/fonts/fonts.conf 进 initrd（见 includes.chroot 预置）。
plymouth-themes

# GNOME desktop, minimal set (X11 session for VM compatibility) + GDM.
# Replaces the full gnome-core metapackage: only the shell, session,
# settings daemon, control center, file manager, terminal and keyring are
# installed. No bundled GNOME apps (maps/music/weather/calendar/contacts/
# clocks/characters/logs/screenshot), no games, no help/docs viewers, no
# software center — AI-first and keeps the image small for the runner disk.
# macOS look comes from the WhiteSur theme installed by the
# 1550-install-whitesur-theme hook (pinned release).
xorg
xauth
kbd
x11-xserver-utils
x11-utils
dbus-x11
# 用户 2026-10-25 Build 37 真机反馈：wireplumber 死在连不上会话总线，
# 根因是 systemd 用户实例里没有 DBUS_SESSION_BUS_ADDRESS 与 DISPLAY
#（会话走 dbus-launch 的 /tmp 总线，从未导进用户实例）。dbus-user-session
# 让 systemd 托管会话总线，pam_systemd 会把总线地址给整个会话（含用户
# 实例），wireplumber 这类用户服务不用再靠导环境就能连上总线。
dbus-user-session
policykit-1
sudo
network-manager
# 用户 2026-10-25 Build 37 真机反馈：WiFi 不可用，NM 日志原话是
# wpa_supplicant 服务 D-Bus 激活失败（连 6 次后放弃），而镜像里根本没
# 装 wpasupplicant（network-manager 只 Recommends 它，不 Depends）。
# 没有它 NM 管不了任何 WiFi：扫描、连接、热点全卡在这。
wpasupplicant
dconf-cli
gnome-session
gnome-shell
gnome-settings-daemon
gnome-control-center
gnome-terminal
nautilus
gnome-keyring
# Firefox ESR：原由 1520 AI 钩子顺带安装，XWLightOS 移除 AI 钩子后需显式声明。
firefox-esr
# 用户 2026-10-25 Build 37 真机反馈：Firefox 默认英文。根因是只装了
# firefox-esr、没有任何 l10n 包，系统 locale 虽是 zh_CN 也没中文可用。
firefox-esr-l10n-zh-cn
gnome-calculator
gnome-text-editor
# 用户 2026-10-23 指令：性能监视工具换成 Debian 官方 gnome-system-monitor
# 应用（替代 paradoxxxzero 的顶栏 system-monitor 扩展，后者同步移除）。
gnome-system-monitor
gvfs
gnome-menus
gdm3
gnome-shell-extension-dashtodock
# 用户 2026-10-24 邮件第 6 项：状态栏监控用 Debian 官方打包的顶栏
# system-monitor 扩展（bookworm 版 40-5，Shell 43 兼容）及其 GIR 依赖。
gnome-shell-extension-system-monitor
gir1.2-gtop-2.0
gir1.2-nm-1.0
gir1.2-clutter-1.0
# 用户 2026-10-24 23:31 邮件：输入法面板扩展也要（此前 22:53 撤回，
# 现按最新要求重新加回；kimpanel@kde.org，Shell 43 兼容；
# fcitx5 自带 kimpanel 插件已在 fcitx5-modules 内）。
gnome-shell-extension-kimpanel
# “扩展”入口应用：GNOME 43 的 Tweaks 已不带扩展管理页，没有这个包系统里
# 就根本没有“扩展”入口（用户 2026-10-24 反馈）。官方 org.gnome.Extensions。
gnome-shell-extension-prefs
gnome-shell-extension-appindicator
# glib-compile-schemas 所在包：1700 钩子编译 gschema 覆盖文件时显式依赖，
# 不能只靠别的包顺带装上。
libglib2.0-bin
# Qt5 应用跟随 GTK2 主题（WhiteSur-Light）所需的平台主题插件。
qt5-gtk-platformtheme
# Desktop Icons NG (ding)：用户 2026-10-17 邮件要求安装并全局默认启用，
# 在桌面上显示"此电脑"等图标（macOS 风格桌面不可缺）。
gnome-shell-extension-desktop-icons-ng
# nautilus-python 绑定：Nautilus"默认打开其他位置"扩展
# （xwlightos-default-location.py，见 1571 钩子）的运行时依赖。
python3-nautilus
# GNOME Tweaks：用户 2026-10-17 邮件要求安装，用于主题/扩展的可视化调整。
gnome-tweaks
# 不可精简：mac 主题的顶栏/锁屏 shell 部分靠 user-theme 扩展
# （gnome-shell-extensions 包提供）。用户 2026-10-12 明确要求回归 mac
# 主题，此包不得再被精简。
gnome-shell-extensions
pipewire
wireplumber
pipewire-pulse
pipewire-alsa
libspa-0.2-bluetooth
pavucontrol

# GNOME runtime dependencies
libx11-6
libxft2
libfontconfig1
libpng16-16
libxtst6
libxi6
libdbus-1-3
libcrypt1
libgtk-3-0
libgtk-4-1
# 希沃视频展台 2.0.5.2580 的 files/lib/librectification.so（梯形校正 native 库）
# 动态依赖 GTK2（libgtk-x11-2.0.so.0、libgdk-x11-2.0.so.0），但厂商 deb 的
# Depends 未声明；缺了它应用启动时 preload 直接抛异常，窗口全黑
# （用户 2026-10-23 真机反馈「视频展台打开全黑」根因）。
libgtk2.0-0
libnotify4
libnss3
libxss1
libsecret-1-0
libatspi2.0-0
libayatana-appindicator3-1
xdg-utils
# 用户 2026-10-25 邮件第 1 项（所有程序还是黑色文字+背景）：Qt6 与
# Electron/Chromium 类应用不读 dconf 的 gtk-theme，它们经 XDG 桌面门户
# （org.freedesktop.portal.Settings）查询浅色/深色。包清单此前只有
# xdg-utils，从未显式声明门户本体与 GTK 后端；live-build 以
# --no-install-recommends 构建，Recommends 链不能算数，gnome-session
# 是否顺带拉来后端也不能当作保证——门户缺失时，Qt6 的回落主题与
# Electron/Chromium 的颜色查询都没有可回答 prefer-light 的后端。
# 显式声明两者：xdg-desktop-portal（本体）+ xdg-desktop-portal-gtk
# （GTK 后端，读 GSettings 的 color-scheme 回答查询）。
xdg-desktop-portal
xdg-desktop-portal-gtk
librsvg2-common
adwaita-icon-theme
hicolor-icon-theme
shared-mime-info
alsa-utils
cheese

# Qt6 runtime for bundled Qt components. Original reason was PeaZip
# （其自带 libQt6Pas.so.6 直接链接系统 libQt6PrintSupport.so.6，
# 无其它包会顺带装上它，缺了启动即死——用户 2026-10-18 真机反馈）；
# PeaZip 已于 2026-10-25 移除，但这组库作为通用 Qt6 运行时保留，
# 厂商组件若有未声明的 Qt6 链接仍靠它们，贸然删未经验证。
libqt6widgets6
libqt6gui6
libqt6core6
libqt6network6
libqt6dbus6
libqt6printsupport6
libgdk-pixbuf-2.0-0

# Chinese locale and Fcitx5 input method
locales
fonts-noto-cjk
fonts-noto-color-emoji
fcitx5
fcitx5-config-qt
fcitx5-frontend-gtk3
fcitx5-frontend-gtk4
fcitx5-frontend-qt5
fcitx5-chinese-addons
fcitx5-pinyin

# Requested everyday applications
# 用户 2026-10-25 指令：PeaZip 语言设置里没中文，改用 GNOME 归档查看器。
# PeaZip 已从 binaries.lock.tsv 移除；File Roller 须显式声明（本清单不用
# gnome-core 整包，File Roller 不会随依赖自动进来）。
vlc
# 用户 2026-10-25 Build 37 真机反馈：VLC 默认英文。根因是 Debian 把 VLC
# 翻译单独拆在 vlc-l10n 包里，vlc 本身不依赖它，镜像里一直没装。
vlc-l10n
file-roller
# 用户 2026-10-25 指令：VLC 性能以希沃设备的 Intel 核显为准（不以
# 5060/nouveau 机器为准）。VA-API 硬解驱动两代都装（iHD 管新核显、
# i965 管老核显，互不冲突，libva 自动选），VLC 默认自动硬解在 Intel
# 上才能真正找到驱动；找不到驱动时 VLC 自动回落软解。
intel-media-va-driver
i965-va-driver
eog
calamares
calamares-settings-debian
squashfs-tools
rsync
udisks2
libblockdev-part2
libblockdev-fs2
dosfstools
ntfs-3g
mtools
parted
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64-bin
# UEFI Secure Boot 链：grub-efi-amd64-bin 里的 grubx64.efi 需经 shim 加载。
# live-build 用 --apt-recommends false，shim-signed 必须显式列出。
# 注意：grub-efi-amd64 与 grub-pc 互斥（Conflicts），不能同时预装；
# bootloader-config 补丁（1565 钩子）让安装时按需跳过 apt。
shim-signed
syslinux-utils
efibootmgr
os-prober

# Runtime dependencies of integrated system tools
python3-gi
python3-cairo
python3-tk
python3-websockets
gir1.2-gtk-3.0
xdotool
wmctrl
libjson-glib-1.0-0
libdrm2
libsystemd0
pciutils
usbutils
fwupd
linux-headers-amd64
procps
man-db
