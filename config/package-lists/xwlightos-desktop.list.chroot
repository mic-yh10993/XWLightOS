# XWLightOS core: Debian Bookworm AMD64, GNOME desktop with macOS-like WhiteSur theme
# The Live user and graphical session are initialized by the XWLightOS-native
# services below, rather than by live-config (which blocks basic.target while
# executing generic late-userspace profiles on every boot).
live-boot
systemd-sysv
libpam-systemd
linux-image-amd64
firmware-linux
firmware-iwlwifi
firmware-atheros
firmware-brcm80211
firmware-realtek
firmware-misc-nonfree
firmware-mediatek
firmware-amd-graphics
firmware-intel-sound
# 开机动画：Plymouth（script 主题 xwlightos，复刻用户 2026-10-23 邮件效果稿：
# 描边绘制→呼吸辉光→流动光点→文字浮现）。内核 cmdline 已带 splash，
# 默认主题由 1630 钩子设为 xwlightos，随 initramfs 进镜像。
plymouth
# plymouth-themes：提供 label.so。Debian 的 plymouth initramfs 钩子在
# update-initramfs 时若缺 label.so 会告警（run 39968933420 实锤 W:），
# 且钩子会 cp /etc/fonts/fonts.conf 进 initrd（见 includes.chroot 预置）。
plymouth-themes

# GNOME desktop, minimal set (X11 session for VM compatibility) + GDM.
# Replaces the full gnome-core metapackage: only the shell, session,
# settings daemon, control center, file manager, terminal and keyring are
# installed. No bundled GNOME apps (maps/music/weather/calendar/contacts/
# clocks/characters/logs/screenshot), no games, no help/docs viewers, no
# software center — AI-first and keeps the image small for the runner disk.
# macOS look comes from the WhiteSur theme installed by the
# 1550-install-whitesur-theme hook (pinned release).
xorg
xauth
kbd
x11-xserver-utils
x11-utils
dbus-x11
# 用户 2026-10-25 Build 37 真机反馈：wireplumber 死在连不上会话总线，
# 根因是 systemd 用户实例里没有 DBUS_SESSION_BUS_ADDRESS 与 DISPLAY
#（会话走 dbus-launch 的 /tmp 总线，从未导进用户实例）。dbus-user-session
# 让 systemd 托管会话总线，pam_systemd 会把总线地址给整个会话（含用户
# 实例），wireplumber 这类用户服务不用再靠导环境就能连上总线。
dbus-user-session
polkitd
sudo
network-manager
# 用户 2026-10-25 Build 37 真机反馈：WiFi 不可用，NM 日志原话是
# wpa_supplicant 服务 D-Bus 激活失败（连 6 次后放弃），而镜像里根本没
# 装 wpasupplicant（network-manager 只 Recommends 它，不 Depends）。
# 没有它 NM 管不了任何 WiFi：扫描、连接、热点全卡在这。
wpasupplicant
dconf-cli
gnome-session
gnome-shell
gnome-settings-daemon
gnome-control-center
gnome-terminal
nautilus
gnome-keyring
# Firefox ESR：原由 1520 AI 钩子顺带安装，XWLightOS 移除 AI 钩子后需显式声明。
firefox-esr
# 用户 2026-10-25 Build 37 真机反馈：Firefox 默认英文。根因是只装了
# firefox-esr、没有任何 l10n 包，系统 locale 虽是 zh_CN 也没中文可用。
firefox-esr-l10n-zh-cn
gnome-calculator
gnome-text-editor
# 用户 2026-10-23 指令：性能监视工具换成 Debian 官方 gnome-system-monitor
# 应用（替代 paradoxxxzero 的顶栏 system-monitor 扩展，后者同步移除）。
gnome-system-monitor
gvfs
gnome-menus
gdm3
gnome-shell-extension-dashtodock
# 用户 2026-10-24 邮件第 6 项：状态栏监控用 Debian 官方打包的顶栏
# system-monitor 扩展（第 14 轮 Trixie：GNOME 官方版 48.2，Shell 48，
# 取代 bookworm 的 paradoxxxzero 版 40-5）及其 GIR 依赖。
gnome-shell-extension-system-monitor
gir1.2-gtop-2.0
gir1.2-nm-1.0
gir1.2-clutter-1.0
# 输入法面板扩展 kimpanel@kde.org 已随 fcitx5 全栈移除（2026-11-01
# 第四轮）：它只是 fcitx5 的面板协议前端（2026-10-24 曾按用户要求
# 加回），IBus 在 GNOME Shell 里有原生输入指示器，不再需要它；
# dconf 的 enabled-extensions 同步摘除，校验脚本有缺席断言。
# “扩展”入口应用：GNOME 43 的 Tweaks 已不带扩展管理页，没有这个包系统里
# 就根本没有“扩展”入口（用户 2026-10-24 反馈）。官方 org.gnome.Extensions。
gnome-shell-extension-prefs
gnome-shell-extension-appindicator
# glib-compile-schemas 所在包：1700 钩子编译 gschema 覆盖文件时显式依赖，
# 不能只靠别的包顺带装上。
libglib2.0-bin
# Qt5 应用跟随 GTK2 主题（WhiteSur-Light）所需的平台主题插件。
qt5-gtk-platformtheme
# Desktop Icons NG (ding)：用户 2026-10-17 邮件要求安装并全局默认启用，
# 在桌面上显示"此电脑"等图标（macOS 风格桌面不可缺）。
gnome-shell-extension-desktop-icons-ng
# nautilus-python 绑定：Nautilus"默认打开其他位置"扩展
# （xwlightos-default-location.py，见 1571 钩子）的运行时依赖。
python3-nautilus
# GNOME Tweaks：用户 2026-10-17 邮件要求安装，用于主题/扩展的可视化调整。
gnome-tweaks
# 不可精简：mac 主题的顶栏/锁屏 shell 部分靠 user-theme 扩展
# （gnome-shell-extensions 包提供）。用户 2026-10-12 明确要求回归 mac
# 主题，此包不得再被精简。
gnome-shell-extensions
pipewire
wireplumber
pipewire-pulse
pipewire-alsa
libspa-0.2-bluetooth
pavucontrol
# 用户 2026-10-31 Build 57 虚拟机实测：speaker-test 有声、桌面应用全无声，
# 且 pactl 命令不存在。pulseaudio-utils 提供 pactl（Pulse 兼容层诊断与
# 默认设备控制的事实标准工具），缺了它现场连查都没法查。
pulseaudio-utils
# ALSA UCM 配置数据：HDA/SOF 声卡的端口与增益拓扑靠它描述，缺失时
# WirePlumber 的音频适配器可能激活中止或选错 profile（Build 57 实测
# wireplumber 日志出现 WpSiAudioAdapter activation aborted）。这是声卡
# 兼容的标配数据包，与具体根因无关都应进镜像。
alsa-ucm-conf
# rtkit：PipeWire 的 module-rt 靠它（D-Bus 激活）给数据线程申请实时
# 优先级。Build 57 构建日志核实它没进镜像（仅在别的包的推荐列表里
# 出现过一次），用户实测 wireplumber 日志也有 RTKit 相关告警——没有
# 它，数据线程只有 nice 让步、没有 SCHED_FIFO，弱 CPU/虚拟机负载一
# 上来实时投递先被饿死（看视频断续的因素之一）。
rtkit

