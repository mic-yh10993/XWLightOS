# DclawOS 1.0 硬件兼容层（最大兼容）。
# 全部包名已对照 Debian Bookworm 归档（main + contrib + non-free + non-free-firmware）
# 逐一验证；与 dclawos-desktop.list.chroot 重复的包不在此重复。
# 不含 Wine/i386 与教育专用组件（DclawOS 为纯 GNOME AI 系统）。

# DKMS 基础环境（out-of-tree 驱动前置依赖；编译器由 dclawos-devel.list.chroot 提供）
dkms

# CPU 微码
intel-microcode
amd64-microcode

# 固件：non-free-firmware 覆盖（Bookworm 实际存在的子集）
firmware-linux-nonfree
firmware-libertas
firmware-ti-connectivity
firmware-sof-signed
firmware-samsung
firmware-qlogic
firmware-cavium
firmware-bnx2
firmware-bnx2x
firmware-myricom
firmware-netxen

# 显卡开源栈（Intel/AMD 内核 modesetting + Mesa 诊断/加速）
mesa-utils
mesa-va-drivers
mesa-vulkan-drivers
mesa-vdpau-drivers
intel-media-va-driver
i965-va-driver
vainfo

# 网卡：cfg80211 依赖 regulatory.db 注册射频规则；iw/ethtool 用于现场诊断
wireless-regdb
iw
ethtool

# 蓝牙
bluez
bluez-tools

# 打印与扫描
cups
cups-filters
cups-client
printer-driver-all
openprinting-ppds
foomatic-db-compressed-ppds
hplip
libsane-hpaio
sane-utils

# 摄像头（UVC）与多媒体工具
v4l-utils
ffmpeg

# 指纹识别框架
fprintd
libpam-fprintd
